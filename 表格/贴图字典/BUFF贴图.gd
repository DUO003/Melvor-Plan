extends Node
class_name BUFF贴图  # 中文类名
var 贴图字典: Dictionary = {
	"一号图": {
		"纹理": preload("res://素材/豆包AI素材/图标/BUFF栏图标.png"),
		"名称": [
			"爱心","沙漏","短剑","剪刀","锤子","镰刀","长矛","弓箭",
			"斧头","盾牌","翅膀","星星","钱袋","卷轴","熔炉","宝石袋",
			"药剂","治疗剂","闪电","磁铁","面包","宝箱","彩票","羽毛",
			"齿轮","水滴","骨头","钥匙","放大镜","号角","蜡烛","罗盘",
			"时钟","错误","冰块","叶子","萌发","螺丝","雪花","魔药",
			"眼睛","锤子2","绷带","铁皮","音符","箭头","蜂蜜","荆棘",
			"望远镜","奖牌","奖杯","水晶球","破碎","星星2","月亮","铃铛",
			"棉花","火焰","冰晶","冰羽毛","火山","藤蔓","齿轮2","蜘蛛丝"
		]
	}
}
func 校验贴图字典() -> void:
	# 初始化总名称数组（收集所有名称元素）
	var 总名称数组: Array = []
	# 初始化重复检测字典 {名称: {贴图名: [出现的索引列表]}}
	var 重复检测容器: Dictionary = {}
	# 1. 遍历贴图字典中的每个贴图项（如"一号图"）
	for 贴图名 in 贴图字典:
		var 贴图项 = 贴图字典[贴图名]
		# 校验当前贴图项是否包含"名称"字段
		if not 贴图项.has("名称"):
			print("【错误】贴图「%s」缺少「名称」字段！" % 贴图名)
			continue
		var 名称数组 = 贴图项["名称"]
		# 校验"名称"是否为数组类型
		if not 名称数组 is Array:
			print("【错误】贴图「%s」的「名称」字段不是数组类型！" % 贴图名)
			continue

		# 2. 遍历当前贴图的名称数组，收集并检测重复
		for 索引 in 名称数组.size():
			var 当前名称 = 名称数组[索引]
			# 将名称添加到总数组
			总名称数组.append(当前名称)

			# 3. 检测重名逻辑
			if not 重复检测容器.has(当前名称):
				# 首次出现，记录贴图名和索引
				重复检测容器[当前名称] = {贴图名: [索引]}
			else:
				# 已存在，追加索引记录
				if 重复检测容器[当前名称].has(贴图名):
					# 同一贴图内重复
					重复检测容器[当前名称][贴图名].append(索引)
				else:
					# 不同贴图重复（扩展兼容多贴图场景）
					重复检测容器[当前名称][贴图名] = [索引]

	# 4. 打印总名称数组（格式化输出，便于查看）
	print("所有贴图名称总数组（共%s个元素）：" % 总名称数组.size())
	print(总名称数组)
	# 5. 检测并打印重名错误
	var 存在重复 = false
	for 名称 in 重复检测容器:
		var 名称记录 = 重复检测容器[名称]
		# 统计该名称的总出现次数
		var 总出现次数 = 0
		var 错误详情: = []
		for 贴图名 in 名称记录:
			var 索引列表 = 名称记录[贴图名]
			总出现次数 += 索引列表.size()
			错误详情.append("贴图「%s」（索引：%s）" % [贴图名, 索引列表])

		# 出现次数>1则判定为重复，打印错误
		if 总出现次数 > 1:
			存在重复 = true
			print("【重名错误】名称「%s」重复！共出现%s次，分布：%s" % [
				名称,
				总出现次数,
				",".join(错误详情)  # 核心修正：用String.join拼接数组
			])
	# 6. 打印最终校验结果
	if not 存在重复:
		print("✅ 校验完成！所有贴图名称无重复")
	else:
		print("❌ 校验完成！检测到重名错误，请查看上方报错信息")
func 生成BUFF图标映射字典() -> Dictionary:
	var 名称映射字典: Dictionary = {}
	# 固定参数（与set_buff_icon逻辑完全一致）
	const 贴图总尺寸: float = 2048.0
	const 图标行列数: int = 8
	var 单个图标尺寸: float = 贴图总尺寸 / 图标行列数
	# 遍历原始字典生成映射
	for 贴图名 in 贴图字典:
		var 贴图项 = 贴图字典[贴图名]
		var 纹理: Texture2D = 贴图项["纹理"]
		var 名称数组: Array = 贴图项["名称"]
		# 计算每个名称对应的区域矩形
		for 贴图编号 in 名称数组.size():
			var 名称 = 名称数组[贴图编号]
			var 图标列索引: int = 贴图编号 % 图标行列数
			var 图标行索引: int = int(贴图编号 * 1.0 / 图标行列数)
			var 区域裁剪矩形: Rect2 = Rect2(
				图标列索引 * 单个图标尺寸,
				图标行索引 * 单个图标尺寸,
				单个图标尺寸,
				单个图标尺寸)
			# 写入映射字典（编辑时已验证无重复，无需重复校验）
			名称映射字典[名称] = [纹理, 区域裁剪矩形]
	return 名称映射字典
