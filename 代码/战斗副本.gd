func 更新探索状态() -> void:
	if 图块事件.size() == 0 or 图块事件.size() % 10 != 0:# 检查数组有效性（非空且长度为10的倍数）
		探索状态数组.clear()
		return
	var 总格子数:int = 图块事件.size()
	@warning_ignore("integer_division")
	var 行数 = 总格子数 / 10  # 计算地图总行数（10列固定）
	探索状态数组.resize(总格子数)  # 调整状态数组长度与图块事件一致
	var 有效已探索: Array[bool] = []# 第一步：标记所有"有效已探索"格子（能连接到第一排的已探索格子）
	有效已探索.resize(总格子数)
	有效已探索.fill(false)  # 初始全部标记为无效
	var 队列: Array = []  # BFS队列，用于扩散有效区域
	for 列 in range(0, 10):# 初始化队列：第一排中已探索的格子（地表已探索区域）
		var 索引 = 列
		if 图块事件[索引] == 100:  # 已探索状态
			有效已探索[索引] = true  # 标记为有效
			队列.append(索引)  # 加入队列用于扩散
	
	# BFS扩散：从有效已探索格子向上下左右扩展，找到所有连通的已探索格子
	while 队列.size() > 0:
		var 当前索引 = 队列.pop_front()  # 取出队首格子
		var 行 = 当前索引 / 10  # 计算当前行（整数除法）
		var 列 = 当前索引 % 10  # 计算当前列
		var 邻居列表: Array[int] = []# 收集上下左右四个方向的邻居索引
		if 行 > 0:# 上邻居（行数减1）
			邻居列表.append((行 - 1) * 10 + 列)
		if 行 < 行数 - 1:# 下邻居（行数加1）
			邻居列表.append((行 + 1) * 10 + 列)
		if 列 > 0:# 左邻居（列数减1）
			邻居列表.append(行 * 10 + (列 - 1))
		if 列 < 9:# 右邻居（列数加1）
			邻居列表.append(行 * 10 + (列 + 1))
		# 处理每个邻居：如果是已探索且未标记有效，则标记并加入队列
		for 邻居索引 in 邻居列表:
			if 图块事件[邻居索引] == 100 and not 有效已探索[邻居索引]:
				有效已探索[邻居索引] = true
				队列.append(邻居索引)
	for 索引 in range(总格子数):# 第二步：计算每个格子的可探索状态
		if 图块事件[索引] == 100: 
			探索状态数组[索引] = false# 已探索的格子不可再探索
		else:
			if 索引 < 10: # 修正：加冒号
				探索状态数组[索引] = true# 第一排（地表）默认可探索
			else:# 检查是否与有效已探索格子相邻（上下左右）
				@warning_ignore("integer_division")
				var 行 = 索引 / 10
				var 列 = 索引 % 10
				var 相邻有效 = false
				if 行 > 0:# 检查上邻居
					var 上索引 = (行 - 1) * 10 + 列
					if 有效已探索[上索引]:
						相邻有效 = true
				if not 相邻有效 and 行 < 行数 - 1:# 检查下邻居（未相邻时才继续检查）
					var 下索引 = (行 + 1) * 10 + 列
					if 有效已探索[下索引]:
						相邻有效 = true
				if not 相邻有效 and 列 > 0:# 检查左邻居
					var 左索引 = 行 * 10 + (列 - 1)
					if 有效已探索[左索引]:
						相邻有效 = true
				if not 相邻有效 and 列 < 9:# 检查右邻居
					var 右索引 = 行 * 10 + (列 + 1)
					if 有效已探索[右索引]:
						相邻有效 = true
				探索状态数组[索引] = 相邻有效# 相邻有效则可探索，否则不可
func 调试打印探索状态() -> void:# 调试打印探索状态数组（每行10个元素，对应地图一行）
	var 总长度 = 探索状态数组.size()
	@warning_ignore("integer_division")
	var 总行数 = int(总长度 / 10)  # 计算总行数（10列固定）
	print("===== 探索状态数组调试打印 =====","总行数: ", 总行数, " | 总元素数: ", 总长度)
	for 行号 in range(总行数):
		var 行内容 = ""
		# 计算当前行的起始索引（行号从0开始）
		var 起始索引 = 行号 * 10
		# 拼接当前行的10个元素
		for 列号 in range(10):
			var 当前索引 = 起始索引 + 列号
			# 转换布尔值为1/0（更直观）
			var 状态字符 = "1" if 探索状态数组[当前索引] else "0"
			行内容 += 状态字符 + "("+str(图块事件[当前索引])+")	"  # 用空格分隔元素
		# 打印行号和对应内容（行号从1开始方便阅读）
		print("行 ", 行号 + 1, ": ", 行内容)
func _process(_帧时: float) -> void:
	if 选择倒计时<=0:
		%选择倒计时.更新进度(-1)
	elif 选择倒计时<=_帧时:
		选择倒计时=-1
		%选择倒计时.更新进度(0)
		if 事件选项节点.text=="第一个":
			处理选项(1)
		elif  事件选项节点.text=="随机":
			处理选项(randi_range(1, 1))

	else :
		%选择倒计时.更新进度(选择倒计时*0.2)
		选择倒计时-=_帧时
