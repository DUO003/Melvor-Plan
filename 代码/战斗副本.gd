extends Control
# 配置参数(代码执行时需要访问的节点,和固定值变量)
var 地图集合路径: String = "res://界面/地图集合.tscn"  # 地图模板场景路径
var 滚动阈值: float = -1792  # 地图块向左超出此值则移除
var 地图节点名: String = "地图"  # 地图容器唯一名
var 玩家节点名: String = "玩家"  # 玩家唯一名
var 探索选项 = ["逐层推进","完全随机","优先深入"]
var 事件选项 = ["第一个","随机","手动"]
var 探索选项节点
var 事件选项节点
var 移动的距离=0
var 最右侧#简化地图加载,存储最右侧的地图图块
var 探索标准块
# 内部变量(由初始化方法获取的固定变量)
var 地图模板列表: Array = []  # 存储所有地图块模板（来自地图集合）
var 当前地图块: Array = []  # 当前加载的地图块（最多2个）
var 地图集合实例: TabContainer = null  # 地图集合场景实例
# 普通变量
# 数据格式名称定义 图块序号表示不同地图格子,事件触发探索度表示格子内触发事件的节点(同时可以触发单格内多个事件)
var 探索度: int = 0  # 总探索度
var 图块事件: Array = []  # 每个图块的探索度数组(int)
var 副本数据#对梅存档中当前副本的数据引用可直接保存
var 事件存档: Dictionary = {}  # 存储所有事件的存档（键=图块序号，值=完成探索的事件触发点数组,例如{5:[10,20]}表示图块5已完成探索度为10和20节点触发的事件）
var 资源存档: Dictionary = {}  #储存当前副本完成探索检查的资源用于计算挂机收益
var 事件触发器=-1#默认值-1,存储当前图块序号
var 事件标签: String = ""  # 默认为空字符串 用于处理什么情况下恢复事件触发器和动作进度条
var 事件触发数组: Array = []  # 存储所有正在触发事件的序号(必须相同类型)[触发节点值]
var 探索状态数组: Array = []  # 每个图块对应的布尔值,为真表示可探索且探索度未满,由探索完成后统一更新
var 图块探索效率:int=5#每次探索增加的探索度
var 图块探索速度:float=2#每次探索所需时间(秒)
var 图块数量: int = 120  # 图块总数(地图格子总数)
var 副本种子:int=666#随机数种子,用于生成不同的副本事件
var 副本名称: String = "秋日森林"  # 当前副本名称
var 克隆图块数组: Array = []  # 存储所有克隆的图块节点（用于高效访问）
var 地块满探索度: int = 100  # 每个地块完全探索的阈值
var 当前头目=null
var 选择倒计时=-1
# 事件池配置
@export var 通关事件池: Array = [# 通关事件数组会全部并优先生成，每个事件仅占1个地块
	{ "事件内容": {50: ["剧情","发现巢穴入口","发现Boss巢穴入口",[" 确认 "]],80: ["剧情","触发最终Boss战","经历了你不断的探索终于找到BOSS确认开始BOSS站斗",[" 确认 ","BOSS生成"]]}, "生成需求": "深层事件" }
]
@export var 战斗事件池: Array = ["僵尸"]  # 战斗事件基础类型 大概率1只 最多小概率5只
@export var 剧情事件池: Array = [  # 剧情事件模板（键为探索度）
	{30: ["剧情","发现古老石碑","森林地面上立着一块古老的石碑,指明了下一步探索的目标",[" 确认 ","探索效率",1]]},#探索效率+1
	{60: ["剧情","找到河流","你发现了一条河流,可以顺着河流更快探索",[" 好主意 ","探索速度",1.1],["偏不","探索速度",0.5]]},#探索速度+10%(保留小数,最低0.5秒)拒绝探索速度减半
	{45: ["剧情","废弃营地","你发现了一个废弃的营地,可以在这休息一下",[" 休息 ","回复血量",50]]}#回复血量50
]
@export var 资源事件池: Array = ["木材", "矿石", "皮革", "药草"]  # 资源类型
# 事件数量配置
@export var 战斗事件数量: int = 20
@export var 剧情事件数量: int = 15
@export var 资源事件数量: int = 15
# 生成结果：键=图块序号（0-99），值=事件字典（键=探索度，值=事件文本）
var 副本事件: Dictionary = {}
func _ready() -> void:
	初始化缓存节点()
	加载_地图模板()#加载地图集合场景，获取所有地图块模板
	副本事件 = 生成副本事件(副本种子)# 生成副本事件字典
	#副本事件={0:{45:["剧情","测试","测试剧情",["了解","探索效率",1]],50:["剧情","测试2","测试剧情123",["了解","探索效率",1],["确认","探索效率",-1]]}}
	#print(副本事件)
	加载探索节点()
	读取并初始化存档()
	更新探索状态()
	初始化小地图()
	剧情事件准备()
	更新副本显示信息()

func 初始化缓存节点():
	%副本探索.visible=true
	%"敌人节点".child_exiting_tree.connect(敌人状态更新)
	%"战利品记录".visibility_changed.connect(战利品更新)
	%"玩家".副本=self
	%"内容区域".clip_contents = true  # 关键：超出内容区域的部分隐藏
	计划.节点["副本敌人节点"]=%"敌人节点"
	计划.节点["战斗副本节点"]=self
	%动作进度条.开始动作("探索更新",图块探索速度,self)
	探索选项节点 = %探索选项
	探索选项节点.clear()
	for 功能名称 in 探索选项:#["逐层推进","完全随机","优先深入"]
		探索选项节点.add_item(功能名称)
	事件选项节点 = %事件选择
	事件选项节点.clear()
	for 功能名称 in 事件选项:#["第一个","随机","手动"]
		事件选项节点.add_item(功能名称)
	探索标准块=%"探索标准块"
	探索标准块.visible=false
func 更新副本显示信息():
	%动作进度条.持续时间=图块探索速度
	%"副本显示信息".text="每次探索效率:%d(%s秒)
探索模式:
事件选择:"%[图块探索效率, round(图块探索速度 * 100) / 100]
func 战利品更新():
	print(资源存档)
	var 奖励文本=""
	if 资源存档.has("地块奖励"):
		奖励文本+="你以完成%d个地块探索\r"%资源存档["地块奖励"]
	for 资源 in 资源事件池:
		if 资源存档.has(资源):
			奖励文本+="找到%d单位的%s资源点\r"%[资源存档[资源],资源]
	for 资源 in 战斗事件池:
		if 资源存档.has(资源):
			奖励文本+="你累计击杀%d个%s\r"%[资源存档[资源],资源]
	if 资源存档.has("头目"):
		奖励文本+="头目击杀成功"
	%"累计奖励".text=奖励文本
func 加载_地图模板() -> void:# 加载地图集合中的所有地图块模板
	var 地图集合场景 = load(地图集合路径) as PackedScene
	地图集合实例 = 地图集合场景.instantiate()
	# 获取TabContainer的所有子节点（即“1”、“2”等Control地图块）
	var tab_container = 地图集合实例  # 地图集合根节点是TabContainer
	for i in range(tab_container.get_tab_count()):
		var 地图块模板 = tab_container.get_child(i)  # 每个Control子节点
		if 地图块模板.has_node("地图"):  # 确保包含TileMapLayer
			地图模板列表.append(地图块模板)
			地图块模板.visible = false  # 隐藏模板（用克隆体显示）
	if not 地图模板列表.size()==0:# 3. 初始加载2个地图块（覆盖初始视野）
		加载新地图块(0)  # 第一个地图块位置：x=0
		加载新地图块(-滚动阈值)  # 第二个地图块位置：x=1800（右侧衔接）
func 生成副本事件(种子:int) -> Dictionary:
	var 随机生成器: RandomNumberGenerator= RandomNumberGenerator.new()
	随机生成器.seed = 种子#默认种子为int类型=666
	var 结果字典 = {}
	var 已占用图块 = []  # 记录已分配事件的图块序号
	var 所有图块序号 = range(0, 图块数量)  # 0-99的数组
	var 深层地块 = range(图块数量 - 10, 图块数量)  # 最后10个地块：90-99
	var 可用图块 = 所有图块序号.duplicate()
	seed(随机生成器.randi())
	可用图块.shuffle()
	深层地块.shuffle()
	for 事件数据 in 通关事件池:# 1. 处理通关事件
		var 选中的地块序号
		if 事件数据["生成需求"]=="深层事件" and 深层地块.size() >= 1:
			选中的地块序号 = 深层地块.pop_back()
			可用图块.erase(选中的地块序号)  # 移除已选地块，避免重复
		else:
			print("通关事件生成错误,改为普通生成方式")
			选中的地块序号=可用图块.pop_back()
		结果字典[选中的地块序号] = 事件数据["事件内容"].duplicate()
		已占用图块.append(选中的地块序号)
	for _i in range(min(战斗事件数量,可用图块.size())):#生成战斗事件
		var 选中的地块序号 = 可用图块.pop_front()
		结果字典[选中的地块序号] = 生成战斗事件(随机生成器.randi())
	
	for _i in range(min(剧情事件数量,可用图块.size())):#生成剧情事件
		var 选中的地块序号 = 可用图块.pop_front()
		var 随机剧情模板 = 剧情事件池[随机生成器.randi_range(0, 剧情事件池.size() - 1)]
		结果字典[选中的地块序号] = 随机剧情模板.duplicate()
	# 5. 生成资源事件（随机资源+数量，每个事件占1个剩余图块）
	for _i in range(min(资源事件数量,可用图块.size())):
		var 选中的地块序号 = 可用图块.pop_front()
		结果字典[选中的地块序号] = 生成资源事件(随机生成器.randi())
	randomize()#刷新随机数避免其他程序受地图影响(然并软)
	return 结果字典
# 生成战斗事件：按概率1-5个僵尸，返回{探索度: 事件文本}
func 生成战斗事件(种子) -> Dictionary:
	var 事件随机生成器=RandomNumberGenerator.new()
	事件随机生成器.seed = 种子
	var 数量概率值 = 事件随机生成器.randf()  # 0-1的随机浮点数
	var 怪物数量: int
	if 数量概率值 < 0.1:# 概率分布：80%1个、10%2个、~3.3%3/4/5个
		怪物数量 = 2+ceil(数量概率值*30)
	elif 数量概率值 < 0.2:
		怪物数量 = 2
	else:
		怪物数量 = 1
	var 触发点=range(10, 地块满探索度+1,10)
	seed(事件随机生成器.randi())
	触发点.shuffle()
	var 事件字典={}
	for i in range(0, 怪物数量):
		事件字典[触发点[i]]=["战斗","僵尸"]
	return 事件字典
# 生成资源事件：随机资源+数量，返回{探索度: 事件文本}
func 生成资源事件(种子) -> Dictionary:
	var 事件随机生成器=RandomNumberGenerator.new()
	事件随机生成器.seed = 种子
	var 随机资源类型 = 资源事件池[事件随机生成器.randi_range(0, 资源事件池.size() - 1)]
	var 随机资源数量 = 事件随机生成器.randi_range(1, 100)  # 1-100资源(单位百分比)
	var 资源剧情="你找到了%s副本的资源点
	资源类型:%s
	资源数量:%d %%"%[副本名称,随机资源类型,随机资源数量]
	@warning_ignore("integer_division")
	var 触发点=事件随机生成器.randi_range(0, int(地块满探索度/10)-1)*10
	return {触发点:["剧情",随机资源类型,资源剧情,["获取资源",随机资源类型,随机资源数量]]}
func 处理动作(动作名称):
	if 动作名称=="探索更新":
		if 事件触发器==-1:
			探索更新()
		else:
			探索更新(事件触发器)
			事件触发器=-1
func 探索更新(序号=-1,探索进度=图块探索效率) -> void:
	if 序号 == -1:#按模式选择目标序号（若未指定序号）
		序号=探索模式返回值()
		if 序号==-1:
			return
	else:
		if not 探索状态数组[序号]:
			print("当前节点无效")
			return
	if 副本事件.has(序号):# 判断副本事件字典是否有该序号对应的键
		var 事件键数组 = 副本事件[序号].keys()# 获取副本事件[序号]字典的所有键并转为数组
		if 事件键数组.size() > 0:
			var 缓存事件存档=事件存档.get(序号,[])
			for 键 in 事件键数组:
				var 图块探索值= 图块事件[序号] + 探索进度
				if int(键) <= 图块探索值 and not 键 in 缓存事件存档:# 检查键是否小于等于图块事件[序号] + 探索进度,或者已经完成
					事件触发数组.append(副本事件[序号][键])
					事件触发数组+=[键]
			if 事件触发数组.size()>0:
				事件触发器=序号
				事件解释方法()
				return
	var 当前探索=更新单个图块(序号, 探索进度)
	if 当前探索==地块满探索度:
		资源存档["地块奖励"]+=1
		更新探索状态()
		var 列 = 序号 % 10  # 列索引（0-9）
		@warning_ignore("integer_division")
		var 行 = int(序号 / 10)  # 行索引（整数除法）
		if 行 > 0:# 上邻居（行-1，需确保行>0）
			var 上邻居序号 = (行 - 1) * 10 + 列
			更新单个图块(上邻居序号)  # 不填探索进度，使用默认值
		@warning_ignore("integer_division")
		if 行 < int(图块事件.size() / 10) - 1:
			var 下邻居序号 = (行 + 1) * 10 + 列
			更新单个图块(下邻居序号)  # 不填探索进度，使用默认值
		if 列 > 0:# 左邻居（列-1，需确保列>0）
			var 左邻居序号 = 行 * 10 + (列 - 1)
			更新单个图块(左邻居序号)  # 不填探索进度，使用默认值
		if 列 < 9:# 右邻居（列+1，需确保列<9）
			var 右邻居序号 = 行 * 10 + (列 + 1)
			更新单个图块(右邻居序号)  # 不填探索进度，使用默认值
		计划.保存存档("战斗:副本:图块更新")
func 探索模式返回值():
	var 序号=-1
	var 有效节点列表: Array[int] = []#收集所有有效可探索节点
	for i in range(探索状态数组.size()):
		if 探索状态数组[i]:  # 仅保留可探索的节点
			有效节点列表.append(i)
	if 有效节点列表.size()==0:# 若没有有效节点，直接返回
		print("没有可探索的有效节点")
		return -1
	var 探索模式=探索选项节点.text
	match 探索模式:
		"完全随机":# 从所有有效节点中随机选一个
			序号 = 有效节点列表[randi() % 有效节点列表.size()]
		"逐层推进":# 选择序号最小的有效节点（按顺序第一个可探索节点）
			序号 = 有效节点列表.min()  # min()取最小序号
		"优先深入":# 步骤1：计算所有有效节点的行号（行号越大越深）
			var 节点行号映射: Dictionary = {}  # 键：节点序号，值：行号
			var 所有行号: Array[int] = []
			for 节点序号 in 有效节点列表:
				@warning_ignore("integer_division")
				var 行号 = int(节点序号 / 10)  # 计算行号（兼容godot语法）
				节点行号映射[节点序号] = 行号
				所有行号.append(行号)
			var 最深行号 = 所有行号.max()# 步骤2：找到最深的行号（最大行号）
			var 候选节点: Array[int] = []# 步骤3：候选节点 = 最深行的有效节点 + 上一行的有效节点
			for 节点序号 in 有效节点列表:
				var 行号 = 节点行号映射[节点序号]
				if 行号 == 最深行号 or 行号 == 最深行号 - 1:
					候选节点.append(节点序号)
			序号 = 候选节点[randi() % 候选节点.size()]
	return 序号
func 事件解释方法():
	if not 事件触发数组.size()>0:
		print("错误:事件数组为空")
		return
	print("触发事件:",事件触发数组)
	%动作进度条.执行动作中=false#暂停动作
	for 事件 in 事件触发数组:
		if 事件 is Array: 
			if 事件[0]=="战斗":
				生成敌人(事件[1])
				事件标签="战斗"
			elif 事件[0]=="剧情":
				%探索事件.visible=true
				事件标签="剧情"
				剧情事件准备()
				return
func 剧情事件准备(强制清空=false):
	if 事件触发数组.size()==0 or 强制清空:
		%事件详情.text="暂时没有需要处理的事件"
		for i in range(1,4):
			var 按钮 = %"事件选项".get_node(str(i))
			按钮.visible=false
			if 按钮.pressed.is_connected(处理选项):
				按钮.pressed.disconnect(处理选项)
		if 事件标签=="剧情" and not 强制清空:
			事件标签=""
			%动作进度条.执行动作中=true
			%副本探索.visible=true
		return
	var 事件=事件触发数组[0]
	%事件详情.text=事件[2]
	var 选项数量=事件.size()-3
	if 选项数量>=1:
		选择倒计时=5
	for i in range(1,4):
		var 按钮 = %"事件选项".get_node(str(i))
		if i<=选项数量:
			按钮.text=事件[i+2][0]
			按钮.visible=true
			if 按钮.pressed.is_connected(处理选项):
				按钮.pressed.disconnect(处理选项)
			按钮.pressed.connect(处理选项.bind(i))
		else :
			按钮.visible=false
			if 按钮.pressed.is_connected(处理选项):
				按钮.pressed.disconnect(处理选项)
