func 更新单个图块(图块序号: int, 增加值: int=0) -> int:# 更新单个图块的探索度（限制最大值），返回更新后的值
	# 边界检查：确保图块序号有效
	if 图块序号 < 0 or 图块序号 >= 图块数量:
		return -1  # 无效序号返回-1
	var 值 = clamp(图块事件[图块序号] + 增加值, 0, 地块满探索度)  # 限制在0-满探索度之间
	图块事件[图块序号] = 值
	var 图块 = 克隆图块数组[图块序号]# 获取对应的图块和文本节点
	var 文本节点 = 图块.get_node("文本")
	if 探索状态数组[图块序号] or 图块事件[图块序号]==地块满探索度:
		if 图块事件[图块序号]==地块满探索度:
			文本节点.text = "完成"
		else :
			文本节点.text = str(值)# 更新文本
		var 起点: Color = Color(0.654, 0.654, 0.654, 1.0)
		var 中点: Color = Color(0.947, 0.863, 0.0, 1.0)
		var 终点: Color = Color(0.5, 0.9, 0.3)
		if 值 <= 地块满探索度/2.0:# 更新颜色（应用统一逻辑）
			var 比例= 值 / (地块满探索度/2.0)
			图块.color = 起点.lerp(中点, 比例)
		else:
			var 比例= (值-地块满探索度/2.0) / (地块满探索度/2.0)
			图块.color = 中点.lerp(终点, 比例)
	else :
		图块.color=Color(0.654, 0.654, 0.654, 1.0)
		文本节点.text = ""
	return 值  # 返回更新后的值
