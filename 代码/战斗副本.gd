func 地图更新(移动距离: float) -> void:
	移动的距离+=移动距离# 玩家调用：传入向左滚动的距离（负数，如-5表示左移5单位）
func _physics_process(_帧时: float) -> void:
	if not 移动的距离<0:
		return
	var 移动距离=移动的距离
	var 待移除 = null
	for 块 in 当前地图块:# 1. 移动所有当前地图块
		块.position.x += 移动距离  # 移动距离为负，x减小（左移）
		if 块.position.x <= 滚动阈值:
			待移除 = 块
	for 怪物 in %"敌人节点".get_children():# 2. 同步怪物位置（随地图左移，保持相对位置）
		if 怪物 is Node2D:
			怪物.position.x += 移动距离
	if not 待移除==null:# 3. 移除超出左侧阈值的地图块，并加载新的
		var 最右侧x = 最右侧.position.x
		当前地图块.erase(待移除)
		待移除.queue_free()  # 销毁旧地图块
		# 计算新地图块位置：当前最右侧地图块的x + -滚动阈值
		加载新地图块(最右侧x - 滚动阈值)  # 右侧无缝衔接
	移动的距离=0
