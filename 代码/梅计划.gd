			内容字符串 = 内容字符串.replace(贴图+"*","[img=%dx%d]%s[/img]:"%[文本尺寸,文本尺寸,手工.资源字典[贴图]["贴图"].resource_path])
		if  富文本支持.size()>=3 and 富文本支持[2]>0:
