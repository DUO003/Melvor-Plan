func 数据订单(返回="订单上限",修改量=0,订单类型=0):
	var 订单:Dictionary=梅存档["挂机"]["订单"]
	var 订单类:int=0#中转,支持了文本输入
	if 订单类型 is int:订单类=订单类型
	elif 订单类型 is String:订单类=订单映射[订单类型]
	match 返回:
		"订单存档":
			var 订单存档 = 订单.get(返回, null)
			var 发现非法数据 = false
			if not 订单存档 is Array or 订单存档.size()==0:
				发现非法数据 = true
			else :
				for 订单数据 in 订单存档:
					if not 订单数据 is 梅订单数据:
						发现非法数据 = true
						break  # 停止遍历，立即处理
			if 发现非法数据:
				订单["订单存档"]=刷新订单()
			return 订单[返回]
		"订单上限":
			数组安全性(订单,返回,订单参数["初始上限"],true)
			if 修改量 is int and 修改量>0 and 订单类>=0 and 订单类<订单[返回].size():
				订单[返回][订单类]+=修改量
			return 订单[返回]
		"订单数量":
			var 订单上限:Array=数据订单("订单上限")
			数组安全性(订单,返回,订单上限)
			if 修改量 is int and 修改量!=0:
				if 订单类>=0 and 订单类<订单[返回].size():
					订单[返回][订单类]+=修改量
					if 订单[返回][订单类]>订单上限[订单类]:
						var 溢出量=订单[返回][订单类]-订单上限[订单类]
						数据原罪("原罪值","挂机",溢出量*5)
						订单[返回][订单类]=订单上限[订单类]
					elif 订单[返回][订单类]<0:订单[返回][订单类]=0
				elif 修改量==-1 and 订单类==-1 :订单[返回]=订单上限.duplicate()
				elif 修改量>=1 and 订单类==-1 :
					var 解锁订单:Array=数据订单("订单解锁")
					var 转换数组=订单参数["订单类型"]
					for 序号 in range(订单上限.size()):
						if 解锁订单.has(转换数组[序号]):
							if 订单[返回][序号]<订单上限[序号]:
								订单[返回][序号]+=修改量
								if 订单[返回][序号]>订单上限[序号]:
									var 溢出量=订单[返回][序号]-订单上限[序号]
									数据原罪("原罪值","挂机",溢出量*5)
									订单[返回][序号]=订单上限[序号]
							else :数据原罪("原罪值","挂机",修改量*5)
				if 修改量>0 and 订单.has("订单存档"):
					订单["订单存档"]=刷新订单(订单["订单存档"],false)
				更新玩法.emit()
			return 订单[返回]
		"订单解锁":
			if not 订单.has(返回) or not 订单[返回] is Array:订单[返回]=["资源订单"]
			if not 订单[返回].has("资源订单"):订单[返回]+=["资源订单"]
			if 修改量 is String and not 订单[返回].has(修改量):
				#print("修改量",修改量)
				if 修改量=="课题订单":
					var 课题订单范围:Array=计划.数据订单("课题订单范围")
					if 课题订单范围.size()>=1:
						订单[返回].append(修改量)
						订单["订单存档"]=刷新订单(订单["订单存档"])
				elif 修改量=="炼金订单":
					var 研究方向:Array=计划.手工.数据灵感("研究方向")
					if 研究方向.has("炼金材料"):
						订单[返回].append(修改量)
						订单["订单存档"]=刷新订单(订单["订单存档"])
				elif 修改量=="药剂订单":
					var 窗口解锁数组: Array = 计划.梅存档["挂机"]["窗口解锁"]
					if 窗口解锁数组.has("炼金界面"):
						订单[返回].append(修改量)
						订单["订单存档"]=刷新订单(订单["订单存档"])
				更新玩法.emit()
			return 订单[返回]
		"课题订单":
			if 修改量 is String:
				订单[返回]=修改量
			elif not 订单.has(返回) or 订单[返回]=="基础素材":
				var 研究方向:Array=数据订单("课题订单范围")
				if 研究方向.size()>=1:
					订单[返回]=研究方向[0]
				else :订单[返回]="基础素材"
			return 订单[返回]
		"课题订单范围":
			var 研究方向:Array=计划.手工.数据灵感("研究方向")
			研究方向.erase("基础素材")
			return 研究方向
		"时间戳":return 计划.处理时间戳(订单,修改量)
		_:return -1
func 读取数据订单(返回="订单上限",目标=0):
	match 返回:
		"订单存档","订单上限","订单数量":
			var 信息=数据订单(返回)
			if 目标 is String:return 信息[订单映射[目标]]
			if 目标 is int:return 信息[目标]
			return -1
		"订单解锁":
			var 订单数组:Array=订单映射.keys()
			if 目标 is int and 目标>0 and 目标<订单数组.size():
				return 订单解锁(订单数组[目标])
			if 目标 is String:return 订单解锁(目标)
			return false
	return -1
func 订单解锁(订单类型:String)->bool:
	var 解锁订单:Array=数据订单("订单解锁")
	return 解锁订单.has(订单类型)
##订单存档为数组[梅订单数据][br]
##数据内部 "订单.订单标记" 与 "订单.订单类型"是等价的一个整数表示,一个文本表示.兼容旧版本
func 刷新订单(订单存档:Array=[],强制:bool=true)->Array:
	var 订单配置=订单参数["刷新栏位"].duplicate()
	var 订单类型=订单映射.keys()
	#print(订单配置,订单类型)
	for 订单 in 订单存档:
		if 订单 is 梅订单数据:
			if 强制 or 订单.名称=="":
				订单.生成订单数据()
			订单配置[订单.订单标记]-=1#存在一个就少生成一次
		else :return 刷新订单()#出现意外数据忽略存档再次执行
	for i in range(订单类型.size()):
		if 订单解锁(订单类型[i]):
			if 订单配置[i]>0:
				for _i in range(订单配置[i]):
					订单存档.append(梅订单数据.new(订单类型[i]))
			elif 订单配置[i]<0:
				var 删除数量=abs(订单配置[i])
				var 删除类型=订单类型[i]
				var 已删除计数 = 0
				for 订单索引 in range(订单存档.size() - 1, -1, -1):# 反向遍历数组删除
					var 待检查订单 = 订单存档[订单索引]
					if 已删除计数 >= 删除数量:break# 仅删除对应类型的梅订单数据，且未删够数量时执行
					if 待检查订单 is 梅订单数据 and 待检查订单.订单类型 == 删除类型:
						订单存档.remove_at(订单索引)#从数组移除这一项
						已删除计数 += 1
	print("订单已刷新")
	return 订单存档
##检查一个固定长度数组,是否符合默认预设值,例如:长度不足
var 安全性缓存={}
func 数组安全性(字典:Dictionary,数组名:String,格式:Array,最大化=false):
	if 安全性缓存.has(数组名):return
	if not 字典.get(数组名, null) is Array:#如果不是
		字典[数组名] = 格式
	if 字典[数组名].size()<格式.size():
		var 最终 = []
		for 索引 in range(格式.size()):
			if 索引 < 字典[数组名].size():
				最终.append(字典[数组名][索引])
			else:
				最终.append(格式[索引])
		字典[数组名]=最终
	if 最大化:
		for 索引 in range(格式.size()):#旧存档兼容机制
			if 字典[数组名][索引]<格式[索引]:字典[数组名][索引]+=格式[索引]
	安全性缓存[数组名]=true
func 处理订单更新()->int:
	var 生成间隔 = 订单参数["生成间隔"]
	var 已过去秒数: int = 计划.数据订单("时间戳", 0)
	var 需增加订单次数: int = int(1.0*已过去秒数 / 生成间隔)
	if 需增加订单次数 > 0:
		var 订单数量:float=需增加订单次数*技能树.数据技能树("额外的订单")+randf()
		计划.数据订单("订单数量",int(订单数量), -1)
		计划.数据订单("时间戳", 需增加订单次数 * 生成间隔)
		print("已增加订单数量：", 订单数量, "个")
	var 剩余未处理秒数: int = 已过去秒数 - 需增加订单次数 * 生成间隔
	var 下次检查间隔: int = 生成间隔-剩余未处理秒数
	if 下次检查间隔 <= 0:
		下次检查间隔 = 生成间隔
	return 下次检查间隔
