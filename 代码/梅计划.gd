		创建计时器(获取零点时间戳(1)-Time.get_unix_time_from_system(),零点刷新,{"是否循环"=false})
	语法糖通知("触发零点刷新")
	print("零点刷新已触发")
	if 梅存档["手工"].has("灵感"):
		var 研究费用=手工.数据灵感("研究费用")
		手工.数据灵感("研究费用",int(研究费用*-1))
	if 梅存档["挂机"].has("在线时间"):
		梅存档["挂机"]["在线时间"]["今日累计"]=0
		梅存档["挂机"]["在线时间"]["开启次数"]=0
