extends Resource
class_name 梅订单数据
##可能触发一些任务条件
var 修饰词字典:Dictionary={"任务":["普通","稀有","罕见","绝版","限定"],#存在任务功能
	"单价":["优质","完美","卓越","精良","顶级","上乘","优选","精品","优品","臻品","绝佳","超凡","高端","精粹","锦鲤"],#增加单价
	"需求":["极速","快捷","高效","速达","迅捷","神速","快单","急单","捷取","锦鲤"],#增加需求物品数量
	"幸运":["珍品","福运","祥瑞","吉运","好运","顺遂","幸运","福泽","吉兆","锦鲤"]}#增加额外奖励
var 特殊修饰词权重:Dictionary = {"普通":100,"稀有":10,"罕见":3,"绝版":0,"限定":0,"锦鲤":0.5}
var 修饰词数组:Array=[]:
	get:
		if 修饰词数组.size()==0:
			for 词语分组 in 修饰词字典:
				for 词语 in 修饰词字典[词语分组]:
					if not 修饰词数组.has(词语):修饰词数组.append(词语)
		return 修饰词数组
var 生成修饰词权重数组:PackedFloat32Array:
	get:
		if 生成修饰词权重数组.size()==0:
			if 计划.技能树.生成修饰词权重数组.size()==0:
				var 权重列表: Array[float] = []
				for 修饰词 in 修饰词数组:# 字典中有配置则用配置值，否则默认1.0
					if 计划.就绪():
						var 权重 = 特殊修饰词权重.get(修饰词, 1.0+计划.技能树.数据技能树("订单标签","强度"))
						权重列表.append(权重)
					else :权重列表.append(1)
				生成修饰词权重数组=PackedFloat32Array(权重列表)
				if 计划.就绪():计划.技能树.生成修饰词权重数组=生成修饰词权重数组
			else :
				生成修饰词权重数组=计划.技能树.生成修饰词权重数组
		return 生成修饰词权重数组
var 订单参数=计划.订单参数
##订单名称对应的物品类型,如果为""表示,订单无效
@export var 名称: String=""
##一定程度影响其他数值
@export var 修饰: String
##每个订单量需要提交多少个物品,存在随机性
@export var 订单量: int = 0
##单价% 初始为75%,每次提交衰减当前1%,向上取整
@export var 单价: float = 0.75
##单价% 初始为75%,每次提交衰减当前1%,向上取整
@export var 单价损失: float = 0.975:
	get:return min(0.99,单价损失)
## 订单标记
@export var 订单类型: String = "资源订单"
##每次获得额外奖励时减1,为0时仅获取金币.
@export var 额外奖励: int = 10
##名称完成订单获取的额外物品数量
@export var 额外物品数量: int:
	set(值):
		if 值>0:
			额外物品数量=值
			return
		var 额外数量倍率:float=0
		var 阶级: int=计划.表格.蓝图数据(名称,"阶级")
		if 订单参数.has(订单类型) and 订单参数[订单类型].has("额外数量倍率"):
			额外数量倍率=订单参数[订单类型]["额外数量倍率"].call(阶级)
		else :额外数量倍率=0.25
		额外物品数量=max(1,ceili(额外数量倍率*订单量))
##时间戳
@export var 时限: float = -1
@export var 物品数组:Array[String]=[]:
	get:
		if 物品数组==[]:
			var 缓存数组:Array[String]=[]
			缓存数组.append(名称)
		return 物品数组
##订单标记 只读,兼容旧数据
var 订单标记: int:
	get:
		var 映射字典=订单参数["订单映射"]
		if 映射字典.has(订单类型):return 映射字典[订单类型]
		return -1
var 背包数量: int:
	get:return 计划.检查背包物品数量(名称)
var 价格: int:
	get:return 多次提交价格(1)
func 多次提交价格(提交数量:int,更新单价=false)->int:
	if 提交数量 <= 0:return 0
	var 金币:int=0
	var 物品价值:int=计划.表格.蓝图数据(名称,"价值")*订单量
	var 基础单价:float=单价
	var 已计算提交量:int=0
	for i in range(提交数量):
		金币+=int(物品价值*基础单价)
		基础单价*=单价损失
		已计算提交量+=1
		if 基础单价<=0.5:
			基础单价=0.5
			if 已计算提交量<提交数量:
				金币+=int(物品价值*基础单价*(提交数量-已计算提交量))
			break
	if 更新单价:单价=基础单价
	return 金币
var 额外物品: String:
	get:
		if 订单参数.has(订单类型) and 订单参数[订单类型].has("额外奖励"):
			return 订单参数[订单类型]["额外奖励"]
		else:return "金币"
var 图标:String:
	get:
		if 订单参数.has(订单类型) and 订单参数[订单类型].has("图标"):
			return 订单参数[订单类型]["图标"]
		else:return "res://素材/豆包AI素材/图标/订单图标.png"
##同步存档和订单卡片,订单卡片更新时发现订单删除会跟随删除
var 删除标记:bool=false
func 提交订单(提交订单量:int=1)->bool:
	var 订单数量:int=计划.读取数据订单("订单数量")
	if 订单数量+额外奖励<=0:
		计划.语法糖通知("需要等待新订单","订单")
		return false
	elif 订单数量+额外奖励<提交订单量:
		计划.语法糖通知("订单提交次数不足","订单")
		return false
	if 背包数量>=订单量*提交订单量:
		if 修饰=="稀有":
			计划.steam.解锁成就("稀有的交易")
		var 消耗订单次数=min(0,额外奖励-提交订单量)
		if 消耗订单次数<0:
			计划.数据订单("订单数量",消耗订单次数)
		计划.语法糖消耗物品(名称,订单量*提交订单量)
		计划.梅存档["金币"]+=int(多次提交价格(提交订单量,true))
		if 额外奖励>=1:#前X次订单才能获取的"赠品"
			var 额外物品获取量:int=min(额外奖励,提交订单量)*额外物品数量
			额外奖励=max(0,额外奖励-提交订单量)
			计划.语法糖获得物品(额外物品,额外物品获取量)
		return true
	return false
func 放弃():
	if 额外奖励>0:
		var 订单数量=计划.读取数据订单("订单数量")
		if 订单数量<=0:
			计划.语法糖通知("放弃订单需要扣除一次提交次数","订单")
			return false
		计划.数据订单("订单数量",-1)
	名称=""
##注册方法(支持从存档载入时不传入数据)
func _init(订单数据=null) -> void:
	if 订单数据 is String:
		生成订单数据(订单数据)
##随机生成订单
func 生成订单数据(订单数据: String=订单类型) -> bool:
	订单类型=订单数据
	var 道具池:Array=获取指定类型图纸(计划.订单对应方向(订单类型),2+计划.数据系统("挂机","阶级"))
	时限=Time.get_unix_time_from_system()+3000+randi() % 600
	物品数组=[]
	if 订单参数.has(订单类型) and 订单参数[订单类型].has("订单量"):
		订单量 = 订单参数[订单类型]["订单量"].call()
	else:
		订单量 = 15 + 5 * (randi() % 6)
		道具池=计划.表格.蓝图数组
	if 道具池.size()>=1:
		道具池.shuffle()
		名称=道具池[0]
		var 抽取次数:int=max(2,randi()%6)
		if 订单类型=="资源订单":
			抽取次数=1
		for 物品名 in 道具池:
			if 抽取次数>=1:
				抽取次数-=1
				物品数组.append(物品名)
		print(名称,物品数组)
	else :
		名称=""#找不到物品
		return false
	额外奖励=2
	额外物品数量=0#自动赋值
	单价=0.75
	var 类型=计划.表格.蓝图数据(名称,"类型")
	if 计划.手工.配方精通效果["价格"].has(类型):
		var 精通等级=计划.手工.数据合成配方(名称)
		if 精通等级>=1:
			单价=min(20,1.0305 ** 精通等级)*单价
	var 三星数量:int=计划.手工.数据合成配方("","升星3数量")
	if 三星数量>=1:单价+=0.01*三星数量
	修饰修改器("随机")
	if 修饰词字典["单价"].has(修饰):
		单价+=0.2+(0.3+计划.技能树.数据技能树("订单标签价格","强度"))*randf()
	if 修饰词字典["需求"].has(修饰):
		订单量=int((1.2+0.3*randf())*订单量)
	if 修饰词字典["幸运"].has(修饰):
		额外奖励+=2
	return true
func 修饰修改器(值):
	if 修饰词字典["任务"].has(值):修饰=值
	elif 修饰词字典.has(值)and 修饰词字典[值] is Array and 修饰词字典[值].size()>=1:
		修饰=修饰词字典[值][randi_range(0,修饰词字典[值].size()-1)]
	else :#随机数抽取逻辑
		var 随机=RandomNumberGenerator.new()
		随机.seed=randi()
		var 序号=随机.rand_weighted(生成修饰词权重数组)
		修饰=修饰词数组[序号]
	#print(修饰词数组)
func 获取指定类型图纸(研究方向: Array=[],最大阶级=1)->Array:
	if 研究方向.size()==0:
		print("错误,没有研究方向",研究方向)
		return []
	var 图纸数组=[]
	for 方向 in 研究方向:
		图纸数组+=计划.获取配方(方向)
	图纸数组 = 图纸数组.filter(func(图纸名称):
		var 阶级=计划.表格.蓝图数据(图纸名称,"阶级")
		return 阶级<=最大阶级)
	#print("执行成功",图纸数组)
	return 图纸数组
