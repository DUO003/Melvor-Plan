extends Resource
class_name 梅BUFF数据
## 触发类型可选值
#var 触发类型选项: Array[String] = ["被动", "间隔"]
## ========================== 基础标识类（必填+持久化）==========================
## BUFF唯一ID，全局不可重复，用于管理器索引和存档关联
## 设计目的：作为BUFF的核心锚点，避免名称重复导致识别错误
@export var BUFF名称: String = "默认BUFF"
## BUFF显示名称，用于UI展示，多语言扩展空间
var 名称显示: String = BUFF名称
## 持久,临时BUFF有时效性[br]
## 临时BUFF不会被持久化,永久BUFF为条件触发移除["持久", "临时", "永久"]
@export var BUFF类型: String = "持久"
## BUFF创建时间戳（秒）记录生效起始时间，离线时计算持续时长
@export var 创建时间戳: float = -1
## BUFF持续时长（秒），-1表示永久或计触发次数 控制生效周期
@export var 持续时长: float = -1
## BUFF剩余触发次数，-1表示不限制或计时 控制生效周期
@export var 剩余次数: float = -1
## 最后一次同步时间戳
## 设计目的：记录离线前最后校验时间，计算离线期间状态变化
@export var 同步时间: float = 0
## BUFF离线时否暂停计时,这个标签在BUFF载入时决定是否重新根据剩余时间生成新BUFF
@export var 离线暂停: bool = false
# ========================== 效果数值类（必填+持久化）==========================
## 设计目的：统一管理多维度属性加成，适配不同类型BUFF,根据层数动态获取
var 效果数值: Dictionary = {}
## BUFF效果叠加方式[br]
## 定义同属性多BUFF的计算规则["加法", "乘法", "取最大值", "取最小值"]
var 叠加方式: String = "加法"
## 最大叠加层数，1表示不可叠加,-1不限制
## 设计目的：限制叠加上限，避免数值溢出
var 最大叠加层数: int = 1

## 设计目的：记录当前生效层数，持久化后恢复状态
@export var 层数: int = 0
## 设计目的：允许每层BUFF单独携带一个强度修改值
@export var 强度: Array = []
# ========================== 触发规则类（可选+持久化）==========================
## 设计目的：区分生效方式
var 触发类型: String = "被动"
##如果为间隔则保存计时器,实际位于BUFF管理器节点下此处保存引用
var 间隔计时器
## 设计目的：控制间隔触发型BUFF的触发频率,添加计时器被设置,修改此值不能修改计时器
var 触发间隔: float = -1



# 剩余触发次数，0表示无限次
# 设计目的：限制触发型BUFF使用次数（如仅生效5次）
# 持久化：是 | 防篡改：<0→抛错并重置为0
@export var 剩余触发次数: int = 0

# ========================== 状态控制类（可选+持久化）==========================
# BUFF是否可被驱散
# 设计目的：控制移除规则（如核心增益不可驱散）
# 持久化：是 | 防篡改：无
@export var 是否可被驱散: bool = true

# BUFF是否生效
# 设计目的：临时禁用BUFF（如玩家死亡时失效），不删除存档数据
# 持久化：是 | 防篡改：无
@export var 是否生效: bool = true

# BUFF所属角色ID
# 设计目的：关联具体角色，支持多角色BUFF管理
# 持久化：是 | 防篡改：无
@export var 所属角色ID: String = ""

# BUFF来源ID（如技能ID/道具ID）
# 设计目的：追溯来源，支持按来源批量移除（如移除所有道具类BUFF）
# 持久化：是 | 防篡改：无
@export var 来源ID: String = ""

# ========================== 运行时计算类（非持久化，仅游戏运行时生成）==========================
# 剩余持续时间（秒），运行时基于创建时间戳/持续时长/当前时间计算
var 剩余持续时间: int = 0

# 是否已过期（剩余持续时间 <= 0 且 持续时长 != 0）
var 是否已过期: bool = false

# 下次触发时间戳（UTC毫秒），仅interval类型生效，运行时计算
var 下次触发时间戳: int = 0

# 实际生效的效果数值（考虑叠加/计算规则后的最终值）
var 最终效果数值: Dictionary = {}

# ========================== 防篡改校验逻辑（占位函数，仅注释说明）==========================
# 校验并修复异常数据，调用时机：存档加载时、BUFF状态更新前
# 功能：按上述防篡改规则校验所有字段，异常则抛错并重置为默认值
# func 校验并修复数据() -> void:
#     # 此处为逻辑占位，具体实现需结合管理器
#     pass
