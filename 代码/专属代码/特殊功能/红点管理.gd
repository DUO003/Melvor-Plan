extends Node
class_name 梅红点

# 红点字典：键为红点名称（字符串），值为判断条件的匿名方法（Callable）
var 红点字典: Dictionary[String, Callable] = {}#不保存
var 红点存档: Array=[]#可重启后被解析成红点字典(部分红点不经过存档仅本次生效)
#红点类型1.纯文本 与字典键一一对应
#红点类型2.数组["字典键名","来源","其他参数也可能没有"]

# 保存红点条件
# 参数：
#   红点名称: 字典的键（唯一标识）
#   条件方法: 匿名方法，返回值为 bool 或 int
func 保存红点条件(红点名称: String, 条件方法: Callable) -> void:
	红点字典[红点名称] = 条件方法# 覆盖已存在的同名红点（避免重复）
func 加载红点存档():
	for 红点名称 in 红点存档:
		if 红点名称 not in 红点字典:# 为不存在的红点创建默认条件方法并保存
			保存红点条件(红点名称, func() -> int:
				return 红点数组解析(红点名称))
func 红点数组解析(红点名称):
	var 计数 = 0
	for 红点 in 红点存档:
		if 红点 is String and 红点 == 红点名称:
			计数 += 1
		elif 红点 is Array and 红点.size() >= 2 and 红点[0] is String and 红点[0] == 红点名称:
			计数 += 1#红点.size() >= 2假设仅有["红点名称"],没有"来源"的红点不符合规定,不进行统计
	return 计数

# 消除红点方法
# 参数：
#   红点名称：必填，目标红点的键名
#   消除参数：默认空字符串，用于匹配数组类型红点的[1]位置
#   消除数量：默认1，-1表示清除全部符合条件的元素
func 消除红点(红点名称: String, 消除参数: String = "", 消除数量: int = 1) -> void:
	var 符合条件的索引: Array[int] = []# 收集所有符合条件的元素索引（从前往后遍历，最后一个匹配项会在数组末尾）
	for i in range(红点存档.size()):# 遍历存档，筛选符合条件的元素索引
		var 红点 = 红点存档[i]
		if 消除参数 == "":# 场景1：消除参数为空，仅匹配类型1（纯字符串）且名称一致的元素
			if 红点 is String and 红点 == 红点名称:
				符合条件的索引.append(i)
		else:# 场景2：消除参数非空，仅匹配类型2（数组）且[0]为名称、[1]为参数的元素
			if 红点 is Array and 红点.size() >= 2 and 红点[0] is String and 红点[0] == 红点名称 and 红点[1] == 消除参数:
				符合条件的索引.append(i)
	print("符合条件的红点索引:",符合条件的索引)
	if 符合条件的索引.is_empty():
		return# 没有符合条件的元素，直接返回
	var 总符合数 = 符合条件的索引.size()
	var 实际删除数量 = 消除数量# 计算实际需要删除的数量
	if 实际删除数量 == -1 or 实际删除数量 > 总符合数:# 若消除数量为-1或超过总符合数，则删除全部
		实际删除数量 = 总符合数
	符合条件的索引.reverse()
	for 索引 in range(实际删除数量):
		红点存档.remove_at(符合条件的索引[索引])
	计划.emit_signal("更新红点")#发出更新信号

# 读取红点状态并返回结果
# 参数：红点名称（要查询的红点标识）
# 返回值：int（0=不显示，>0=显示，数值可代表数量）
func 获取红点状态(红点名称) -> int:
	if 红点名称 not in 红点字典:# 如果字典中没有该红点，直接返回0
		return 0
	var 原始结果 = 红点字典[红点名称].call()# 执行对应的条件方法，获取原始结果
	if typeof(原始结果) == TYPE_BOOL:# 处理布尔类型结果（true=显示，false=不显示）
		if 原始结果:
			return 1  # 布尔true对应显示，返回1
		else:
			#红点字典.erase(红点名称)  # 不显示时移除键
			return 0
	elif typeof(原始结果) == TYPE_INT:# 处理整数类型结果（>0=显示，≤0=不显示）
		if 原始结果 > 0:
			return 原始结果  # 直接返回数量
		else:
			#红点字典.erase(红点名称)  # 不显示时移除键
			return 0
	else:# 非法返回值（既不是bool也不是int），默认不显示,但保留键
		return 0
