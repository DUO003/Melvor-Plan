extends HBoxContainer
var 功能列表 = []
var 功能字典:Dictionary = {
	"通用": {
		"测试金币":[["增加","减少","归零"],[100,200,500,1000]],
		"获取道具":[func():return 计划.表格.蓝图数组,[1,5,10,100,160,1600]],
		"获取点数":[func():return 计划.表格.蓝图数组,[1,5,10,100]],
		"获取方块":[func():return 计划.表格.方块字典.keys(),[]],
		"测试红点":[],
		"拖动手柄":[],
		"切换语言":[["中文","英文"],[]]},
	"故事界面":{},
	"合成界面": {
		"手工熟练度":[["增加","减少"],["10%","25%","100%"]],
		"手工精通":[["增加","减少"],["10%","25%","100%"]],
		"手工资源获取":[],
		"测试BUFF":[["以太药水","蓝图药水","锚定时间药水","混沌调和药水","创生息壤药水","维度稳固药水"],[1.0,2.0,5.0]],
		"获取研究方向":[["长剑","盾牌","头盔","重甲","腿甲","鞋子","符文","炼金材料","食材"],[]],
		"提示粒子":[["蓝图纸"],[]],},
	"小游戏界面": {},
	"背包界面": {
		"获取装备":[],
		"获取宝石":[],
		"刷新商店":[]},
	"战斗界面": {
		"副本-生成敌人":[],
		"高效探索":[]},
	"任务窗口": {"零点刷新":[]},
	"订单界面": {"处理订单更新":[]},
	"炼金界面": {"炼金材料":[]},
	"原罪界面": {"挂机熟练":[],"加速研究":[["倍率修改"],[1,5,10,50]]}}
@export var 主容器窗口: 梅主容器窗口
var 功能参数:Dictionary={}
@onready var 参数筛选器: LineEdit = %参数筛选器
@onready var 下拉菜单: OptionButton = %测试功能
@onready var 参数菜单: OptionButton = %测试参数
@onready var 数量菜单: OptionButton = %测试数量
@onready var 测试: Button = %测试
@onready var 拖动手柄: Panel = %拖动手柄
@onready var 参数区: VBoxContainer = %参数区
var 当前场景名称:String
func _ready():
	if 梅存档格式.单例.启用测试:
		visible=true
	else :
		visible=false
		return
	if OS.has_feature("editor_runtime"):
		功能字典["任务窗口"]["直接解锁"]=[]
	测试.gui_input.connect(检查GUI)
	参数筛选器.text_changed.connect(参数加载_筛选)
	更新功能()
	功能参数={}
	for 场景 in 功能字典:
		for 功能 in 功能字典[场景]:
			功能参数[功能]=功能字典[场景][功能]
	下拉菜单.item_selected.connect(func(_序号):
		计划.窗口状态管理("测试",当前场景名称+"功能",null,_序号)
		参数加载()
		print("测试功能选择:",下拉菜单.text))
	主容器窗口.场景更新.connect(更新功能)
	参数加载()
	更新显示(false)
	读取位置()
func 读取位置():
	size=Vector2(0,0)
	global_position=计划.窗口状态_限制("测试","测试的位置",global_position,计划.游戏分辨率-size)
func 检查GUI(按键信号: InputEvent):
	# 只处理鼠标按下事件
	if 按键信号 is InputEventMouseButton and 按键信号.pressed:
		# 左键 → 原来的功能：测试按钮
		if 按键信号.button_index == MOUSE_BUTTON_RIGHT or not 参数区.visible:
			更新显示(not 参数区.visible)
			读取位置()
		elif 按键信号.button_index == MOUSE_BUTTON_LEFT:
			测试按钮(按键信号)
func 更新显示(状态):
	参数区.visible=状态
func 测试按钮(按键信号):
	var 功能:=下拉菜单.text
	var 参数:=参数菜单.text
	var 数量:=数量菜单.text
	计划.声音.播放鼠标点击音效()
	print("当前选中的测试功能：", 功能)
	if 功能=="测试金币":
		if 参数=="增加":计划.梅存档["金币"]+=int(数量)
		elif 参数=="减少":计划.梅存档["金币"]-=int(数量)
		else :计划.梅存档["金币"]=0
		计划.更新_UI.emit()
	elif 功能=="提示粒子":
		计划.语法糖粒子(参数)
	elif 功能=="获取道具":
		计划.获得物品语法糖(参数,int(数量))
		计划.更新_UI.emit()
	elif 功能=="获取点数":
		计划.获得物品语法糖(参数,int(数量),"点数")
		计划.更新_UI.emit()
	elif 功能=="获取方块":
		计划.获得物品语法糖(参数,1,"物品方块")
	elif 功能=="获取研究方向":
		计划.解锁研究方向(参数)
		计划.更新玩法.emit()
	elif 功能=="拖动手柄":
		拖动手柄.visible=计划.窗口状态管理("测试","拖动手柄",false,not 拖动手柄.visible)
	elif 功能=="获取装备":
		#var 随机装备数组=["标准剑","标准盾","标准头盔","标准重甲","标准腿甲","标准鞋子","青铜剑","铁剑"]
		var 随机装备数组=["墨羽笔杖","标准剑","标准盾","标准头盔","标准重甲","标准腿甲","标准鞋子","青铜剑","铁剑"]
		var 随机索引 = randi() % 随机装备数组.size()
		#var 装备:物品装备=
		计划.获得物品语法糖(随机装备数组[随机索引],1,"装备物品")
		计划.更新_UI.emit()
		#var 数据:梅提示数据=梅提示数据.new()
		#数据.通用解析(装备)
		#计划.数据包提示.emit(数据)
		return
	elif 功能=="获取宝石":
		var 随机数组=["火宝石","水宝石","冰宝石","草宝石","雷宝石","土宝石","风宝石"]
		var 随机索引 = randi() % 随机数组.size()
		计划.获得物品语法糖(随机数组[随机索引],1,"物品宝石")
		计划.更新_UI.emit()
		return
	elif 功能=="刷新商店":
		计划.商店刷新()
	elif 功能=="手工熟练度":
		if not 计划.梅存档["手工"].has("熟练"):
			计划.梅存档["手工"]["熟练"]=0
		var 熟练度=计划.结算升级("手工",计划.玩法枚举.无,"null",true)
		if 数量=="10%":熟练度*=0.1
		elif 数量=="25%":熟练度*=0.25
		if 参数=="增加":计划.梅存档["手工"]["熟练"]+=熟练度
		else :计划.梅存档["手工"]["熟练"]-=熟练度
		if 计划.梅存档["手工"]["熟练"]<0:
			计划.梅存档["手工"]["熟练"]=0
			if 计划.梅存档["手工"]["等级"]>1:
				计划.梅存档["手工"]["等级"]-=1
		计划.结算升级("手工",计划.玩法枚举.无,"null",false,true)
		计划.更新_UI.emit()
	elif 功能=="挂机熟练":
		if not 计划.梅存档["挂机"].has("熟练"):
			计划.梅存档["挂机"]["熟练"]=0
		计划.梅存档["挂机"]["熟练"]+=计划.结算升级("挂机",计划.玩法枚举.无,"null",true)
		计划.结算升级("挂机")
		计划.更新_UI.emit()
	elif 功能=="手工精通":
		if not 计划.梅存档["手工"].has("精通"):
			计划.梅存档["手工"]["精通"]=0
		var 精通值=计划.数据精通上限("手工")
		if 数量=="10%":精通值*=0.1
		elif 数量=="25%":精通值*=0.25
		if 参数=="增加":计划.梅存档["手工"]["精通"]+=精通值
		else :计划.梅存档["手工"]["精通"]-=精通值
		if 计划.梅存档["手工"]["精通"]<0:计划.梅存档["手工"]["精通"]=0
		计划.更新_UI.emit()
	elif 功能=="手工资源获取":
		计划.手工.获得资源("木材", 计划.手工.资源上限字典["木材"], true, false)
		计划.手工.获得资源("矿石", 计划.手工.资源上限字典["矿石"], true, false)
		计划.手工.获得资源("皮革", 计划.手工.资源上限字典["皮革"], true, false)
		计划.手工.获得资源("药草", 计划.手工.资源上限字典["药草"], true, false)
		计划.更新_UI.emit()
	elif 功能=="副本-生成敌人":
		if 计划.节点有效性检查("战斗副本节点"):
			计划.节点["战斗副本节点"].生成敌人()
	elif 功能=="高效探索":
		if 节点有效性检查("战斗副本节点"):
			if is_instance_valid(计划.节点["战斗副本节点"]):
				if 计划.节点["战斗副本节点"].副本数据["图块探索效率"]==计划.节点["战斗副本节点"].图块探索效率:
					计划.节点["战斗副本节点"].图块探索效率=25
					计划.节点["战斗副本节点"].图块探索速度=0.1
				else :
					计划.节点["战斗副本节点"].图块探索效率=计划.节点["战斗副本节点"].副本数据["图块探索效率"]
					计划.节点["战斗副本节点"].图块探索速度=计划.节点["战斗副本节点"].副本数据["图块探索速度"]
				计划.节点["战斗副本节点"].更新副本显示信息()
	elif 功能=="测试红点":
		if 按键信号.button_index == MOUSE_BUTTON_RIGHT:
			计划.红点.消除红点("测试红点","",-1)
		else:
			计划.红点.增加红点("测试红点")
		return
	elif 功能=="直接解锁":
		var 窗口数据=计划.窗口.窗口数据
		var 窗口解锁 = 计划.梅存档["挂机"].get("窗口解锁",[])
		for 窗口名称 in 窗口数据:
			if not 窗口解锁.has(窗口名称) and not 窗口数据[窗口名称].get("隐藏",false):
				窗口解锁.append(窗口名称)
		计划.梅存档["挂机"]["窗口解锁"] = 窗口解锁
		计划.解锁系统("手工")
		if 节点有效性检查("主容器窗口"):
			计划.节点["主容器窗口"].生成任务栏按钮()
		return
	elif 功能=="处理订单更新":
		计划.任务.生成订单任务(true)
		计划.更新_UI.emit()
		return
	elif 功能=="炼金材料":
		var 物品数组: Array=[]
		var 催化剂数组: Array=计划.获取配方("催化剂")
		var 物品类型数组:Array=计划.获取配方("炼金材料")+催化剂数组
		var 获取数量=1
		if 按键信号.button_index == MOUSE_BUTTON_RIGHT:
			获取数量=10
		for X in 获取数量:
			var 物品名称=物品类型数组[randi() %物品类型数组.size()]
			var 物品数量=5 if 物品名称 in 催化剂数组 else 5+randi() %30
			物品数组+=[计划.语法糖获得物品(物品名称,物品数量)]
		计划.语法糖奖励显示(物品数组,"测试炼金材料",1)
		return
	elif 功能=="测试BUFF":
		计划.BUFF.创建BUFF("以太药水","测试按钮按下")
		print(计划.BUFF.BUFF字典.keys())
		return
	elif 功能=="零点刷新":
		计划.零点刷新()
		return
	elif 功能=="加速研究":
		计划.技能树.技能研究倍数=int(数量)
		return
	elif 功能=="切换语言":
		计划.表格.翻译切换(参数)
		计划.更新_UI.emit()
		return
	else :
		return
	计划.保存存档("点击测试按钮")
func 更新功能(场景名称=null):
	当前场景名称=str(场景名称)
	功能列表=[]
	if not 场景名称==null and 功能字典.has(场景名称):
		功能列表+=功能字典[场景名称].keys()
	功能列表+=功能字典["通用"].keys()
	下拉菜单.clear()
	for 功能名称 in 功能列表:
		下拉菜单.add_item(功能名称)
		下拉菜单.add_separator()
	下拉菜单.selected=计划.窗口状态_限制("测试",当前场景名称+"功能",0,下拉菜单.get_item_count())
	参数加载()
var 缓存参数:Array=[]
var 缓存数量:Array=[]
func 参数加载():
	参数菜单.clear()
	数量菜单.clear()
	var 功能=下拉菜单.text
	拖动手柄.visible=计划.窗口状态管理("测试","拖动手柄",false)
	if 功能参数.has(功能):
		var 参数数据:Array=功能参数[功能]
		if 参数数据.size()==2:
			if 参数数据[0] is Array:
				缓存参数=参数数据[0]
			elif  参数数据[0] is Callable:
				缓存参数=参数数据[0].call()
			#print(缓存参数)
			缓存数量=参数数据[1]
			if 缓存参数 is Array:
				for 参数 in 缓存参数:
					参数菜单.add_item(str(参数))
					参数菜单.add_separator()
			if 缓存数量 is Array:
				for 参数 in 缓存数量:
					数量菜单.add_item(str(参数))
					数量菜单.add_separator()
	var 选项数量 = 参数菜单.get_item_count()
	var 数量数量 = 数量菜单.get_item_count()
	if 选项数量 == 0:参数菜单.hide()  # 隐藏节点
	else :参数菜单.show()  # 显示节点
	if 数量数量 == 0:数量菜单.hide()  # 隐藏节点
	else:数量菜单.show()  # 显示节点
	if 选项数量 >= 10:参数筛选器.show()  # 显示节点
	else :参数筛选器.hide()  # 隐藏节点
func 参数加载_筛选(文本: String):
	参数菜单.clear()
	var 筛选文本 = 文本.strip_edges()#去除首尾空格
	for 参数 in 缓存参数:
		var 参数文本 = str(参数)# 统一转字符串，兼容非文本类型参数
		if 筛选文本=="" or 筛选文本 in 参数文本:
			参数菜单.add_item(参数文本)
func 打印字典内容(字典:Dictionary)-> void:
	for 键 in 字典:
		print ("键:", 键,"，值:", 字典 [键])
func 节点有效性检查(节点名称:String)->bool:
	return 节点名称 in 计划.节点 and 计划.节点[节点名称] != null
# 技能升级费用测试函数（无需存档，直接运行）
# 技能升级费用测试函数（无需存档，直接运行，修正GDScript语法）
func 技能升级费用测试函数() -> void:
	var 最大等级: int = 4
	var 基础金币价格: int = 1000
	var 核心系数: float = pow(最大等级, 1.0 / 最大等级)
	var 增长率: float = 核心系数 * 1
	# 初始化累计金币
	var 累计金币: int = 0
	# 打印表头
	print("技能升级费用测试（最大等级=%d，基础价格=%d，增长率≈%.6f）" % [最大等级, 基础金币价格, 增长率])
	print("%-6s %-12s %-15s %-15s" % ["等级", "倍率", "当前升级费用", "累计金币"])
	# 修正语法：使用range()遍历1~100级（range左闭右开，故结束值为最大等级+1）
	for 技能等级 in range(1, 最大等级 + 1):
		# 计算当前等级倍率（增长率^技能等级）
		var 当前倍率: float = pow(增长率, 技能等级)
		if 技能等级>=1:
			当前倍率+=2*pow(技能等级/10.0, 1.25)
		var 当前升级费用: int = int(基础金币价格 * 当前倍率)# 计算当前升级费用（取整，游戏中金币为整数）
		累计金币 += 当前升级费用# 累加累计金币
		# 格式化打印当前等级数据（对齐展示，更清晰）
		print("%-6d %-12.6f %-15d %-15d" % [技能等级, 当前倍率, 当前升级费用, 累计金币])
	# 打印汇总信息
	print("测试汇总：")
	print("1. 最大倍率（100级）：%.6f" % pow(增长率, 最大等级))
	print("2. 100级升级费用：%d 金币" % int(基础金币价格 * pow(增长率, 最大等级)))
	print("3. 1~100级总升级费用：%d 金币" % 累计金币)
	print("4. 满足倍率约束（100级倍率≈%.6f ≤ 100）：%s" % [pow(增长率, 最大等级), pow(增长率, 最大等级) <= 100])

