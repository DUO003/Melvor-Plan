extends 基类梅窗口
var 资源每秒 = {"木材":1, "矿石":1, "皮革":1, "药草":1}
var 制作队列节点=[]
# 存储最近一分钟内的帧间隔数据
var 帧率数据: Array[float] = []
# 累计最近一分钟的总时间（用于快速判断是否超过60秒）
var 总时间: float = 0.0
# 计算得到的一分钟平均帧率
var 平均帧率: float = 0.0
var 类型="基础素材"
var 筛选器条件:Array=[]
var 筛选器本体:Button
func _ready() -> void:
	super._ready()#注册
	#资源回复逻辑
	筛选器条件=计划.手工.数据灵感("研究方向")
	if not 筛选器条件.has("基础素材"):
		筛选器条件+=["基础素材"]
	if not 筛选器条件.has("特殊"):
		筛选器条件+=["特殊"]
	筛选器本体=%"筛选类型"
	类型="基础素材"
	生成筛选器()
	注册进度条()
	处理资源回复()
	#熟练度逻辑
	计划.处理时间戳(计划.梅存档["手工"])
	生命周期计时器+=[计划.创建计时器(1.0, Callable(self, "更新信息"))]#更新在线合成结算的精通熟练显示信息
	生命周期计时器+=[计划.创建计时器(8,func(): 定期更新提示文本(%"温馨提示"))]#每隔8秒更新一次文本
	定期更新提示文本(%"温馨提示")
	计划.connect("更新_UI",Callable(self, "_更新_UI"))
	%动作进度条.开始动作("资源回复",5.0,self)
	注册按钮()
	_更新_UI()

func _process(delta: float) -> void:
	更新制作队列进度条()
	帧率数据.append(delta)# 1. 记录当前帧的间隔时间
	总时间 += delta
	while 总时间 > 60.0:# 2. 移除超过1分钟的旧数据
		var  oldest_delta = 帧率数据.pop_front()  # 移除最早的帧数据
		总时间 -= oldest_delta
	if 总时间 > 0:# 3. 计算平均帧率（总帧数 / 总时间）
		var 原始帧率 = 帧率数据.size() / 总时间
		平均帧率 = round(原始帧率 * 10) / 10  # 保留1位小数（精度0.1）
	else:
		平均帧率 = 0.0
func _exit_tree() -> void:#我知道可以省略但防止忘了加"super._exit_tree()"还是规范一下
	super._exit_tree()
func 生成筛选器():
	清除子节点(%"筛选器容器",筛选器本体)
	筛选器本体.visible=false
	for 条件 in 筛选器条件:
		var 条件按钮=筛选器本体.duplicate()
		条件按钮.visible=true
		条件按钮.text=条件
		条件按钮.pressed.connect(func():
			类型=条件
			生成筛选器())
		%"筛选器容器".add_child(条件按钮)
	生成配方节点()
func 生成配方节点():
	清除子节点(%"配方表格",%"配方表格".原始配方节点)
	%"配方表格".原始配方节点.visible=false
	var 配方列表 = 获取配方(类型)
	%"配方表格".克隆配方节点(配方列表)
func 获取配方(类型参数="基础素材"):
	var 图纸数据=计划.表格.创世蓝图
	var 图纸条件=图纸数据[0].find("类型")
	if 类型参数=="特殊":
		图纸条件=图纸数据[0].find("图纸集")
	var 图纸数组=[]
	for 图纸 in 图纸数据:
		if 图纸[图纸条件] ==类型参数:
			图纸数组+=[图纸[0]]
	return 图纸数组
func 注册按钮():
	%强化.pressed.connect(计划.无功能方法)
	%抽奖机.pressed.connect(func(): 计划.切换场景("合成_抽奖机界面"))
	%蓝图库.pressed.connect(func(): 计划.切换场景("合成_蓝图库界面"))
	print("按钮已注册")
func 更新信息():
	#print ("更新信息触发")
	var 熟练值 = 计划.精通收益(计划.处理时间戳(计划.梅存档["手工"]))
	%提示文本.text="暂存熟练\r"+str(熟练值)+"\rfps:"+str(平均帧率)
	pass
func 注册进度条():
	var 制造队列 = %圆形进度条
	%圆形进度条.visible = false
	if 制造队列:
		for i in range(6):
			var 克隆节点
			var 制作队列配方按钮节点
			if 制作队列节点.size()==6:
				克隆节点 = 制作队列节点[i]
				制作队列配方按钮节点 = 克隆节点.get_node("配方")
			else:
				克隆节点 = 制造队列.duplicate()
				制作队列配方按钮节点 = 克隆节点.get_node("配方")
				%制作队列.add_child(克隆节点)
				制作队列节点.append(克隆节点)
				克隆节点.name = "制作队列" + str(i + 1)  # 命名为配方1、配方2...
				克隆节点.visible = true  # 克隆节点设为可见
				克隆节点.更新进度(0.0)
				制作队列配方按钮节点.gui_input.connect(func(按键信号): 
					if 按键信号 is InputEventMouseButton and 按键信号.pressed:
						制作队列更新(按键信号,i))
			var 纹理 = null
			var 制作队列配方名节点 = 制作队列配方按钮节点.get_node("配方名")
			var 制作队列 = 计划.手工.队列合成()
			if i < 制作队列.size():
				var 配方的名称=制作队列[i]
				纹理 = 计划.表格.道具贴图(配方的名称)
				克隆节点.配方序号 = 计划.表格.获取表格信息(计划.表格.创世蓝图,配方的名称,"名称")
				#print("配方名: ", 配方的名称)
				#print("配方序号: ", str(克隆节点.配方序号))
				制作队列配方名节点.text=配方的名称
			else :
				克隆节点.配方序号 = null
				制作队列配方名节点.text=""
			var 制作队列贴图节点 = 制作队列配方按钮节点.get_node("配方贴图")
			制作队列贴图节点.texture = 纹理

func _更新_UI():
	更新信息()
	for 资源 in %"资源管理器".get_children():# 循环处理每个资源的UI更新
		if 资源 is 资源进度条:
			资源.更新UI()
func 处理动作(_动作名称):
	处理资源回复()
func 处理资源回复():
	var 优化倍率: float = 0.3
	var 进度条时长:int = 计划.处理时间戳(计划.梅存档["手工"]["基础资源"])
	if 进度条时长<1:
		return
	var 处理时间段 = []# 计算需要处理的时间段
	if 进度条时长 > 60:  # 处理超过60秒的长离线情况
		while 进度条时长 > 60:
			var 时间段 = max(floor(进度条时长 * 优化倍率),10)  # 按倍率计算下一段时长（向下取整）
			处理时间段.append(时间段)  # 添加当前计算的时间段
			进度条时长 -= 时间段  # 更新当前时长为下一段基础
	@warning_ignore("integer_division")
	var 完整循环次数 = floor(进度条时长 / 10)
	var 剩余秒数 = 进度条时长 % 10
	if 完整循环次数 >= 1:
		for i in range(完整循环次数):
			处理时间段.append(10)
	if 剩余秒数 > 0:
		处理时间段.append(剩余秒数)
	print("处理时间段:",处理时间段)
	for 时长 in 处理时间段:# 循环处理所有时间段，累加资源增加量
		资源回复动作(时长,false)
	计划.处理时间戳(计划.梅存档["手工"]["基础资源"],-1)
	计划.更新_UI.emit()# 触发UI更新和保存
	计划.保存存档("资源回复")
func 资源回复动作(进度条时长 = 1.0,更新UI=true):
	资源每秒=计划.手工.资源回复
	for 资源名 in 资源每秒:
		var 特性倍率=1
		if 资源名=="木材":
			特性倍率=1
		elif 资源名=="矿石":
			特性倍率=0
			if randf() <= 0.5:
				特性倍率=2
		elif 资源名=="皮革":
			特性倍率=randf_range(0.25, 1.75)
		elif 资源名=="药草":
			特性倍率=0
			if randf() <= 0.8:
				特性倍率=randf_range(0.25, 2.1875)
		var 基础量 = 资源每秒[资源名] * 进度条时长 * 特性倍率
		计划.手工.获得资源(资源名, 基础量, true, false)
	if 更新UI:
		计划.emit_signal("更新_UI")# 统一触发UI更新
func 更新制作队列进度条():#仅处理显示效果
	计划.梅手工单例.更新制作队列进度条()
	var 制作参数=计划.手工.队列合成("",true,true)
	var 序号=0
	for 节点 in 制作队列节点:
		if 序号+1>制作参数.size():
			节点.更新进度(-1)
		else :
			var 制作时长=制作参数[序号]["制作时长"]
			var 时间差=Time.get_unix_time_from_system()-制作参数[序号]["时间戳"]
			节点.更新进度(1.0*时间差/制作时长)
		序号+=1
func 制作队列更新(按键信号,i):
	if 按键信号.button_index == MOUSE_BUTTON_LEFT:
		计划.语法糖通知( "合成队列可以右键移除","手工提示")
	elif 按键信号.button_index == MOUSE_BUTTON_RIGHT:
		var 制作队列 = 计划.手工.队列合成()# 获取当前制作队列
		if i >= 0 and i < 制作队列.size():# 检查索引是否有效（在数组范围内）
			var 装备名称 = 制作队列[i]
			计划.手工.队列合成(装备名称)
		# 索引无效时什么也不做
	else :
		pass
