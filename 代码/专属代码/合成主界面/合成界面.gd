extends 基类梅窗口
var 资源每秒 = {"木材":1, "矿石":1, "皮革":1, "药草":1}
var 制作队列节点=[]
var 制作指针=0
# 存储最近一分钟内的帧间隔数据
var 帧率数据: Array[float] = []
# 累计最近一分钟的总时间（用于快速判断是否超过60秒）
var 总时间: float = 0.0
# 计算得到的一分钟平均帧率
var 平均帧率: float = 0.0
var 类型="基础素材"
var 筛选器条件:Array=[]
var 筛选器本体:Button

func _ready() -> void:
	super._ready()#注册
	#资源回复逻辑
	筛选器条件=初始化.梅存档["手工"].get("研究方向",[])
	if not 筛选器条件.has("基础素材"):
		筛选器条件+=["基础素材"]
	筛选器本体=%"筛选类型"
	类型="基础素材"
	生成筛选器()
	注册进度条()#加载后会更新一次UI,无需重复
	处理资源回复()
	#熟练度逻辑
	var 当前时间 = Time.get_unix_time_from_system ()
	var 手工熟练时间戳 = 初始化.时间戳字典.get("手工熟练", 当前时间)
	初始化.时间戳字典["手工熟练"] = int(手工熟练时间戳)
	初始化.创建计时器(1.0, Callable(self, "更新信息"))#更新在线合成结算的精通熟练显示信息
	初始化.connect("更新_UI",Callable(self, "_更新_UI"))
	%动作进度条.开始动作("资源回复",5.0,self)
	注册按钮()

func _process(delta: float) -> void:
	更新制作队列进度条()
	帧率数据.append(delta)# 1. 记录当前帧的间隔时间
	总时间 += delta
	while 总时间 > 60.0:# 2. 移除超过1分钟的旧数据
		var  oldest_delta = 帧率数据.pop_front()  # 移除最早的帧数据
		总时间 -= oldest_delta
	if 总时间 > 0:# 3. 计算平均帧率（总帧数 / 总时间）
		var 原始帧率 = 帧率数据.size() / 总时间
		平均帧率 = round(原始帧率 * 10) / 10  # 保留1位小数（精度0.1）
	else:
		平均帧率 = 0.0
		
func 生成筛选器():
	清除子节点(%"筛选器容器",筛选器本体)
	筛选器本体.visible=false
	for 条件 in 筛选器条件:
		var 条件按钮=筛选器本体.duplicate()
		条件按钮.visible=true
		条件按钮.text=条件
		条件按钮.pressed.connect(func():
			类型=条件
			生成筛选器())
		%"筛选器容器".add_child(条件按钮)
	清除子节点(%"配方表格",%"配方表格".原始配方节点)
	%"配方表格".原始配方节点.visible=false
	var 配方列表 = 获取配方(类型)
	%"配方表格".克隆配方节点(配方列表)
func 获取配方(类型参数="基础素材"):
	if 类型参数=="符文":
		return ["火符文", "水符文", "冰符文","草符文"]
	return ["铁锭", "纤维", "鞣革"]
func 注册按钮():
	%派遣队.pressed.connect(初始化.无功能方法)
	%装备充能.pressed.connect(初始化.无功能方法)
	%抽奖机.pressed.connect(func(): 初始化.切换场景("合成_抽奖机界面"))
	%蓝图库.pressed.connect(func(): 初始化.切换场景("合成_蓝图库界面"))
	print("按钮已注册")
func 更新信息():
	#print ("更新信息触发")
	var 熟练值 = 初始化.精通收益(初始化.时间戳字典.get("手工熟练",-1))
	%提示文本.text="暂存熟练\r"+str(熟练值)+"\rfps:"+str(平均帧率)
	pass
func 注册进度条():
	重算资源回复()
	var 制造队列 = %圆形进度条
	制作指针=0
	%圆形进度条.visible = false
	if 制造队列:
		for i in range(6):
			var 克隆节点
			var 制作队列配方按钮节点
			if 制作队列节点.size()==6:
				克隆节点 = 制作队列节点[i]
				制作队列配方按钮节点 = 克隆节点.get_node("配方")
			else:
				克隆节点 = 制造队列.duplicate()
				制作队列配方按钮节点 = 克隆节点.get_node("配方")
				%制作队列.add_child(克隆节点)
				制作队列节点.append(克隆节点)
				克隆节点.name = "制作队列" + str(i + 1)  # 命名为配方1、配方2...
				克隆节点.visible = true  # 克隆节点设为可见
				克隆节点.更新进度(0.0)
				制作队列配方按钮节点.gui_input.connect(func(按键信号): 
					if 按键信号 is InputEventMouseButton and 按键信号.pressed:
						制作队列更新(按键信号,i))
			var 图片路径 = ""
			var 制作队列配方名节点 = 制作队列配方按钮节点.get_node("配方名")
			var 制作队列 = 初始化.梅存档.get("手工",{}).get("制作队列", [])
			if i < 制作队列.size():
				var 配方的名称=制作队列[i]
				图片路径 = 梅表格.获取表格信息(梅表格.装备蓝图,配方的名称,"icon")
				克隆节点.配方序号 = 梅表格.获取表格信息(梅表格.装备蓝图,配方的名称,"名称")
				#print("配方名: ", 配方的名称)
				#print("配方序号: ", str(克隆节点.配方序号))
				制作队列配方名节点.text=配方的名称
			else :
				克隆节点.配方序号 = null
				制作队列配方名节点.text=""
			var 制作队列贴图节点 = 制作队列配方按钮节点.get_node("配方贴图")
			if 图片路径 != "":
				var 纹理 = load(图片路径)
				if 纹理 != null:
					制作队列贴图节点.texture = 纹理
			else:
				if not 克隆节点.配方序号 == null:
					print("无法加载图片: ", 图片路径)
				制作队列贴图节点.texture = null
func _更新_UI():
	更新信息()
	for 资源 in %"资源管理器".get_children():# 循环处理每个资源的UI更新
		if 资源 is 资源进度条:
			资源.更新UI(资源每秒)
func 处理动作(_动作名称):
	处理资源回复()
func 处理资源回复():
	var 优化倍率: float = 0.3
	var 当前时间 = Time.get_unix_time_from_system()# 获取当前时间和离线时间
	var 进度条时长:int = int(当前时间 - 初始化.时间戳字典.get("资源回复", 当前时间))
	if 进度条时长<1:
		if not "资源回复" in 初始化.时间戳字典:
			初始化.时间戳字典["资源回复"] = int(当前时间)# 更新时间戳
		#print("进度条时长:",进度条时长)
		return
	var 处理时间段 = []# 计算需要处理的时间段
	if 进度条时长 > 60:  # 处理超过60秒的长离线情况
		while 进度条时长 > 60:
			var 时间段 = max(floor(进度条时长 * 优化倍率),10)  # 按倍率计算下一段时长（向下取整）
			处理时间段.append(时间段)  # 添加当前计算的时间段
			进度条时长 -= 时间段  # 更新当前时长为下一段基础
	@warning_ignore("integer_division")
	var 完整循环次数 = floor(进度条时长 / 10)
	var 剩余秒数 = 进度条时长 % 10
	if 完整循环次数 >= 1:
		for i in range(完整循环次数):
			处理时间段.append(10)
	if 剩余秒数 > 0:
		处理时间段.append(剩余秒数)
	#print("处理时间段:",处理时间段)
	for 时长 in 处理时间段:# 循环处理所有时间段，累加资源增加量
		资源回复动作(时长,false)
	初始化.时间戳字典["资源回复"] = int(当前时间)# 更新时间戳
	初始化.emit_signal("更新_UI")# 触发UI更新和保存
	初始化.保存存档("资源回复")
func 资源回复动作(进度条时长 = 1.0,更新UI=true):
	for 资源名 in 资源每秒:
		var 特性倍率=1
		if 资源名=="木材":
			特性倍率=1
		elif 资源名=="矿石":
			特性倍率=0
			if randf() <= 0.5:
				特性倍率=2
		elif 资源名=="皮革":
			特性倍率=randf_range(0.25, 1.75)
		elif 资源名=="药草":
			特性倍率=0
			if randf() <= 0.8:
				特性倍率=randf_range(0.25, 2.1875)
		var 基础量 = 资源每秒[资源名] * 进度条时长 * 特性倍率
		初始化.获得资源(资源名, 基础量, true, false)
	if 更新UI:
		初始化.emit_signal("更新_UI")# 统一触发UI更新
func 更新制作队列进度条():#仅处理显示效果
	初始化.梅手工单例.更新制作队列进度条()
	var 制作参数=初始化.梅存档["手工"].get("制作参数", [])
	var 序号=0
	for 节点 in 制作队列节点:
		if 序号+1>制作参数.size():
			节点.更新进度(-1)
		else :
			var 制作时长=制作参数[序号]["制作时长"]
			var 时间差=Time.get_unix_time_from_system()-制作参数[序号]["时间戳"]
			节点.更新进度(1.0*时间差/制作时长)
		序号+=1
func 制作队列更新(按键信号,i):
	if 按键信号.button_index == MOUSE_BUTTON_LEFT:
		引擎.屏幕.滚动提示( "合成队列可以右键移除","手工提示")
	elif 按键信号.button_index == MOUSE_BUTTON_RIGHT:
		var 制作队列 = 初始化.梅存档.get("手工",{}).get("制作队列", [])# 获取当前制作队列
		# 检查索引是否有效（在数组范围内）
		if i >= 0 and i < 制作队列.size():
			# 获取要删除的装备名称
			var 装备名称 = 制作队列[i]
			# 从队列中移除该元素
			制作队列.erase(制作队列[i])
			# 更新存档
			初始化.梅存档["手工"].set("制作队列", 制作队列)
			# 显示提示信息
			引擎.屏幕.滚动提示( "已从制作队列移除:"+装备名称,"手工提示")
			# 刷新进度条显示
			注册进度条()
		# 索引无效时什么也不做
	else :
		pass
func 重算资源回复():
	var 缓存资源每秒 = 初始化.基础资源每秒# 基础资源每秒回复量
	var 消耗统计 = {}
	for 资源 in 缓存资源每秒:
		消耗统计[资源]=0.0
	var 制作队列 = 初始化.梅存档.get("手工", {}).get("制作队列", [])# 获取当前制作队列
	var 配方耗时=[]
	for 队列项 in 制作队列:# 第一步：统计所有制作队列的资源消耗
		var 表格字典 = 梅表格.获取表格字典(梅表格.装备蓝图, -1,队列项)
		var 每秒消耗 = 计算每秒材料消耗(表格字典)
		配方耗时.append(max(表格字典.get("冷却", 10),10))
		for 资源名 in 每秒消耗:# 累加消耗到统计中
			if 资源名 in 消耗统计:
				消耗统计[资源名] += 每秒消耗[资源名]
	# 第二步：计算制作倍率（取最慢的瓶颈）
	var 制作时间倍 = 1.0  # 默认为1（无减速）
	for 资源名 in 缓存资源每秒.keys():
		var 基础回复 = max(缓存资源每秒[资源名],1)
		var 当前倍率 = 消耗统计[资源名] / (基础回复-0.1)
		if 当前倍率 > 制作时间倍:
			制作时间倍 = 当前倍率
	制作时间倍 = max(制作时间倍, 1.0)  # 确保倍率不小于1
	资源每秒 = {
		"木材": 缓存资源每秒["木材"] - (消耗统计["木材"] / 制作时间倍),
		"矿石": 缓存资源每秒["矿石"] - (消耗统计["矿石"] / 制作时间倍),
		"皮革": 缓存资源每秒["皮革"] - (消耗统计["皮革"] / 制作时间倍),
		"药草": 缓存资源每秒["药草"] - (消耗统计["药草"] / 制作时间倍)}
	#更新制作参数
	var 制作参数=初始化.梅存档.get("手工",{}).get("制作参数", [])
	var 新制作参数 = []
	var 序号=0
	for 当前物品名 in 制作队列:# 第一步：筛选保留匹配的元素
		if 序号 < 制作参数.size() and 制作参数[序号].get("名称") == 当前物品名:
			var 新值=制作参数[序号]
			新值["制作时长"]=1.0*配方耗时[序号]*制作时间倍
			新制作参数.append(新值)
		序号+=1
	for i in range(新制作参数.size(), 制作队列.size()):# 第二步：补充制作队列中新增的部分
		var 当前物品名 = 制作队列[i]
		新制作参数.append({
			"名称": 当前物品名,
			"制作时长": 1.0*配方耗时[i]*制作时间倍,
			"时间戳": Time.get_unix_time_from_system()})
	初始化.梅存档["手工"]["制作参数"] = 新制作参数
	初始化.保存存档("更新制作参数")
	_更新_UI()

func 计算每秒材料消耗(表格字典):
	var 冷却时间 = 表格字典.get("冷却", 10)
	if 冷却时间 <= 0:
		冷却时间 = 10  # 避免冷却时间为0导致的除零错误
	var 资源字典 = 初始化.材料对照  # 二级资源转化规则
	var 每秒消耗 = {}  # 最终结果字典
	for 材料类型 in 资源字典.keys():
		每秒消耗[材料类型] = 0.0# 初始化所有材料消耗为0.0（确保即使无消耗也返回0）
	for 材料类型 in 资源字典.keys():# 遍历材料类型计算基础消耗
		var 基础消耗 = 表格字典.get(材料类型, 0) / 冷却时间  # 计算当前材料的基础每秒消耗
		if 资源字典[材料类型] is Dictionary:# 二级资源转化为对应一级资源的消耗
			var 转化规则 = 资源字典[材料类型]  # 获取该二级资源的转化配方
			for 一级材料 in 转化规则:
				每秒消耗[一级材料] += 基础消耗 * 转化规则[一级材料]# 累加转化后的消耗
		elif 资源字典[材料类型] == "特殊":# 三级资源特殊始终为0
			每秒消耗[材料类型] = 0.0
		else:
			每秒消耗[材料类型] += 基础消耗# 一级资源：直接累加基础消耗
	return 每秒消耗
