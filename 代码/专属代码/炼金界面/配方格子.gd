extends Control
var 配方容器节点: Array=[]
##催化剂节点
var 催化剂:Panel
@export var 可修改:bool=false
@export var 配方编号=0
var 配方: Dictionary=	{"材料名称"=[],
						"材料数量"=[],
						"催化剂"=null}
var 修改返回对象=null
func _ready() -> void:
	配方容器节点=[%"配方容器1", %"配方容器2", %"配方容器3", %"配方容器4"]
	催化剂=%"催化剂"
	for 节点名称 in 配方容器节点:
		节点名称.修改返回对象=self
		节点名称.可修改=可修改
		节点名称.催化剂=false
		节点名称.初始更新()
	催化剂.可修改=可修改
	催化剂.催化剂=true
	催化剂.修改返回对象=self
	催化剂.初始更新()

func 加载配方信息():
	for i in 4:
		var 节点=配方容器节点[i]
		if i<配方["材料名称"].size():
			节点.当前值=配方["材料数量"][i]
			节点.道具名称=配方["材料名称"][i]
		else :
			节点.当前值=0
			节点.道具名称=null
		节点.更新文本()
	催化剂.当前值=1
	催化剂.道具名称=配方["催化剂"]
	催化剂.更新文本()
func 返回处理方法():
	配方={"材料名称"=[],"材料数量"=[],"催化剂"=null}
	for 容器节点 in 配方容器节点:# 遍历配方容器节点，收集有效材料（名称不为null且数量>0）
		var 材料名称 = 容器节点.道具名称
		var 材料数量 = 容器节点.当前值
		if 材料名称 != null and 材料数量 > 0:# 仅添加：材料名称不为null 且 数量>0 的数据
			配方["材料名称"].append(材料名称)
			配方["材料数量"].append(材料数量)
	# 处理催化剂：仅当催化剂节点存在且其名称不为null时记录，否则设为null
	配方["催化剂"] = 催化剂.道具名称 if (催化剂 != null and 催化剂.道具名称 != null) else null
	if not 修改返回对象==null:
		修改返回对象.返回处理方法()
	#print(配方)
