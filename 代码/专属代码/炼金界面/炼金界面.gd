extends 基类梅窗口
#var 配方默认值: Dictionary=	{"材料名称"=["炽心草茎","发条虫蜕","风翎符片","腐翼鳞粉"],
						#"材料数量"=[5,6,7,10],
						#"催化剂"="圣盾徽记"}
var 配方默认值: Dictionary={"材料名称":[],
						"材料数量":[],
						"催化剂":null}
var 配方: Dictionary=配方默认值.duplicate(true)
var 配方编号=-1
var 存档配方数组=[]
var 配方格子
var 管理选项卡:TabContainer
func _ready() -> void:
	super._ready()
	管理选项卡=$"内容节点/选项卡"
	生成预览描述()
	生成配方详情文本()
	配方格子=%"配方格子"
	配方格子.配方编号=-1
	配方格子.配方=配方
	配方格子.修改返回对象=self
	配方格子.加载配方信息()
	生命周期计时器+=[计划.创建计时器(8,func(): 定期更新提示文本(%"温馨提示"))]#每隔8秒更新一次文本
	定期更新提示文本(%"温馨提示")
	加载炼金配方()
	加载炼金队列()
	%"扩容配方列表".pressed.connect(扩容配方列表)
	%"保存配方".pressed.connect(保存配方)
	%"清空配方".pressed.connect(清空配方)
	%"确认".pressed.connect(func():删除制作队列())
	%"取消".pressed.connect(func():关闭弹窗())
	关闭弹窗()
func 扩容配方列表():
	计划.语法糖通知("功能锁定中","炼金提示")
func 保存配方():
	if 计划.手工.配方格式检查(配方,true):
		var 队列:Array=计划.手工.读取炼金配方列表(配方)
		if 配方 in 队列:
			清空配方()
			加载炼金配方()
			生成配方详情文本()
		else :
			计划.语法糖通知("配方未能加入队列,可能因为超过上限","炼金提示")
func 清空配方():
	配方=配方默认值.duplicate(true)
	配方格子.配方=配方
	配方格子.加载配方信息()
	生成配方详情文本()
func 加载炼金配方():
	var 配方节点:炼金配方卡片=preload("res://界面/插件/炼金配方.tscn").instantiate()
	var 炼金配方列表=计划.梅手工单例.读取炼金配方列表()
	清除子节点(%"炼金配方容器",%"标题")
	var 序号:int=0
	for 配方字典 in 炼金配方列表:
		#print("加载成功",配方字典)
		var 克隆节点:炼金配方卡片=配方节点.duplicate()
		克隆节点.配方=配方字典
		克隆节点.序号=序号
		克隆节点.使用事件=func(数量:int=1):
			制作队列添加配方(配方字典,数量)
		克隆节点.删除事件=func():
			移除炼金配方(序号)
		克隆节点.查看事件=func():
			生成预览描述(序号)
			%"预览配方".visible=true
		序号+=1
		%"炼金配方容器".add_child(克隆节点)
func 加载炼金队列():
	var 配方节点:炼金队列卡片=preload("res://界面/插件/炼金队列.tscn").instantiate()
	var 队列炼金存档=计划.梅手工单例.队列炼金()
	清除子节点(%"炼金台队列",%"标题2")
	var 序号:int=0
	for 队列字典 in 队列炼金存档:
		print("加载成功",队列字典)
		var 克隆节点:炼金队列卡片=配方节点.duplicate()
		克隆节点.炼金哈希=队列字典["配方"]
		克隆节点.序号=序号
		克隆节点.领取事件=func():领取奖励(序号)
		克隆节点.取消事件=func():取消制作弹窗(序号)
		序号+=1
		%"炼金台队列".add_child(克隆节点)

func 领取奖励(序号):
	print("领取被执行",序号)
	var 炼金队列: Array=计划.手工.队列炼金()
	if 炼金队列.size()>序号:
		var 配方数据 = 炼金队列[序号]
		if 配方数据["完成"]>0:
			var 哈希结果=配方数据["配方"]
			var 炼金药水=计划.手工.数据炼金配方(哈希结果,"药水")
			var 炼金数量=计划.手工.数据炼金配方(哈希结果,"数量")
			var 药水长度=炼金药水.size()
			var 统计奖励=[]
			var 炼金次数=计划.手工.数据炼金配方(哈希结果,"炼金次数")
			for i in 配方数据["完成"]:
				var 药水名称=炼金药水[炼金次数%药水长度]
				var 药水数量=炼金数量[炼金次数%药水长度]
				炼金次数+=1
				统计奖励+=[计划.语法糖获得物品(药水名称,药水数量)]
			计划.手工.数据炼金配方(哈希结果,"炼金次数",配方数据["完成"])
			计划.语法糖奖励显示(统计奖励,"获得药水",1)
			配方数据["完成"]=0
			if 配方数据["剩余"]<=0:
				计划.手工.队列炼金("",1,序号)
				加载炼金队列()
			计划.更新_UI.emit()
			计划.保存存档("领取炼金奖励")
func 取消制作弹窗(序号):
	%"弹窗文本".text="[color=#f1c40f]注意[/color]：当前炼金台正在炼制的这一炉，若确认终止：
	• 正在炼制的该炉炼金材料[color=#f1c40f]将不予返还[/color]
	• 已添加的其他排队配方不受影响
	是否确认终止本次炼制？"
	配方编号=序号
	%"弹窗提示".visible=true
func 删除制作队列():
	var 炼金队列: Array=计划.梅手工单例.队列炼金()
	if 配方编号<炼金队列.size():
		var 剩余数量=炼金队列[配方编号]["剩余"]-1
		if 剩余数量>=1:
			var 配方哈希=炼金队列[配方编号]["配方"]
			var 炼金配方: Dictionary=计划.梅手工单例.手工系统["炼金配方"]
			扣除炼金材料(炼金配方[配方哈希]["配方"],-剩余数量)
		计划.手工.队列炼金("",1,配方编号)
	关闭弹窗()
	加载炼金队列()
func 关闭弹窗():
	配方编号=-1
	%"弹窗提示".visible=false
func 移除炼金配方(序号):
	var 炼金配方存档: Array=计划.手工.读取炼金配方列表()
	if 序号>=炼金配方存档.size():
		加载炼金配方()
		计划.语法糖通知("错误:尝试删除一个未知配方","炼金窗口")
		return
	计划.手工.读取炼金配方列表({},序号)
	计划.语法糖通知("移除成功","炼金窗口")
	加载炼金配方()
func 制作队列添加配方(配方字典,数量:int=1):
	if not 计划.手工.配方格式检查(配方字典):
		计划.语法糖通知("配方不完整无法使用","炼金窗口")
		return false#格式错误
	if 材料数量检查(配方字典,数量):#材料足够
		var 炼金队列: Array=计划.手工.队列炼金()
		var 配方哈希结果=计划.手工.哈希配方(配方字典)
		if 炼金队列.any(func(队列项): return 队列项["配方"] == 配方哈希结果):
			计划.语法糖通知("配方已经在队列中","炼金窗口")
			return false#配方已经在队列中
		计划.手工.数据炼金配方(配方哈希结果,"添加配方",配方字典)#如果不存在注册炼金配方
		扣除炼金材料(配方字典, 数量)
		计划.手工.队列炼金(配方哈希结果,数量)
		加载炼金队列()
		计划.保存存档("炼金队列")
		计划.语法糖通知("配方加入队列,材料已扣除","炼金窗口")

func 打印抽奖结果(抽取结果):
	var 药水数量统计: Dictionary = {}
	# 2. 获取原字典的两个数组（确保长度一致，避免越界）
	var 药水名称数组: Array = 抽取结果["药水"]
	var 数量数组: Array = 抽取结果["数量"]
	if 药水名称数组.size() != 数量数组.size():
		print("错误：药水数组和数量数组长度不一致！")
		return 抽取结果 # 长度异常时返回原结果
	# 3. 遍历数组，累加每个药水的总数量
	for i in 药水名称数组.size():
		var 药水名: String = 药水名称数组[i]
		var 数量: int = 数量数组[i]
		# 如果药水名已存在，累加数量；不存在则初始化
		if 药水数量统计.has(药水名):
			药水数量统计[药水名] += 数量
		else:
			药水数量统计[药水名] = 数量
	# 4. 打印统计后的字典（格式化输出更易读）
	print("=== 药水数量统计结果 ===")
	for 药水名 in 药水数量统计:
		print(药水名, "：", 药水数量统计[药水名], "个")

func 材料数量检查(配方字典,数量:int=1):
	for i in 配方字典["材料名称"].size():
		var 物品名称=配方字典["材料名称"][i]
		var 背包内数量=计划.检查背包物品数量(物品名称)
		var 需求数量=配方字典["材料数量"][i]*数量
		if 需求数量>背包内数量:
			计划.语法糖通知("材料:"+物品名称+"数量不足","炼金窗口")
			return false#数量不足
	if 数量>计划.检查背包物品数量(配方字典["催化剂"]):
		计划.语法糖通知("催化剂:"+配方字典["催化剂"]+"数量不足","炼金窗口")
		return false#数量不足
	return true
func 扣除炼金材料(配方字典, 数量:int=1):
	if 数量 == 0:
		return# 数量为0时直接返回，不执行任何操作
	for i in range(配方字典["材料名称"].size()):
		var 物品名称 = 配方字典["材料名称"][i]
		var 变动数量 = 配方字典["材料数量"][i] * 数量
		if 变动数量 > 0:# 正数调用消耗，负数取绝对值调用获得
			计划.语法糖消耗物品(物品名称, 变动数量)
		elif 变动数量 < 0:
			计划.语法糖获得物品(物品名称, -变动数量)
	var 催化剂名称 = 配方字典["催化剂"]# 2. 处理催化剂（正数扣除，负数获得）
	if 数量 > 0:
		计划.语法糖消耗物品(催化剂名称, 数量)
	elif 数量 < 0:
		计划.语法糖获得物品(催化剂名称, -数量)

@warning_ignore("unused_parameter")
func 生成预览描述(序号=-1):
	var 文本:="当你了解配方的奥秘后在配方界面
点击查看预览了解配方详情"
	if 序号!=-1:
		var 炼金配方存档=计划.梅手工单例.读取炼金配方列表()
		var 哈希结果=计划.梅手工单例.哈希配方(炼金配方存档[序号])
		var 炼金配方: Dictionary=计划.梅手工单例.手工系统["炼金配方"]
		var 炼金数据=炼金配方[哈希结果]
		文本="版本号:"+str(炼金数据["版本号"])
		文本+="\r"+解析配方(炼金数据["配方"])
		var 药水=炼金数据["药水"]
		var 数量=炼金数据["数量"]
		文本+="\r药水列表:"
		for i in 药水.size():
			文本+=查询图片(药水[i],60)+"*"+str(数量[i])
	%"配方预览".text=文本
func 生成配方详情文本():
	var 文本="当前配方\r"+解析配方(配方)
	%"配方详情".text=文本
func 解析配方(配方字典):
	var 文本="催化剂:"+(查询图片(配方字典["催化剂"],100)+"\r"if not 配方字典["催化剂"]==null else "\r")
	文本+="材料:"
	if 配方字典.get("材料名称",[]).size()>=1:
		var 序号=0
		for 图片名称 in 配方字典["材料名称"]:
			文本+=(""if 序号==0 else",")+查询图片(图片名称,80)+"*"+str(配方字典["材料数量"][序号])
			序号+=1
	return 文本
func 查询图片(图片,尺寸:int):
	if 图片 in 计划.表格.蓝图字典:
		var 图片文本=计划.表格.蓝图字典[图片][计划.表格.蓝图表头["icon"]]
		return "[img="+str(尺寸)+"x"+str(尺寸)+"]"+图片文本+"[/img]"
	return
func 返回处理方法(_节点=null):
	配方=%"配方格子".配方
	生成配方详情文本()



