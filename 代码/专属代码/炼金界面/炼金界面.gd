extends 基类梅窗口
#var 配方默认值: Dictionary=	{"材料名称"=["炽心草茎","发条虫蜕","风翎符片","腐翼鳞粉"],
						#"材料数量"=[5,6,7,10],
						#"催化剂"="圣盾徽记"}
var 配方默认值: Dictionary={"材料名称":[],
						"材料数量":[],
						"催化剂":null}
var 配方: Dictionary=配方默认值.duplicate(true)
var 删除方法:Callable
var 存档配方数组=[]
var 管理选项卡:TabContainer
@onready var 配方格子: Control = %配方格子
func _ready() -> void:
	super._ready()
	管理选项卡=$"内容节点/选项卡"
	生成配方详情文本()
	配方格子.配方编号=-1
	配方格子.配方=配方
	配方格子.修改返回对象=self
	配方格子.加载配方信息()
	描述容器.修改返回对象=self
	描述容器.初始更新()
	生命周期计时器+=[计划.创建计时器(8,func(): 定期更新提示文本(%"温馨提示"))]#每隔8秒更新一次文本
	定期更新提示文本(%"温馨提示")
	更新检查炼金队列()
	计划.过去一秒.connect(更新检查炼金队列)
	加载炼金配方(true)
	加载炼金队列()
	%"扩容配方列表".pressed.connect(扩容配方列表)
	%"保存配方".pressed.connect(保存配方)
	%"清空配方".pressed.connect(清空配方)
	%"确认".pressed.connect(func():
		删除方法.call()
		计划.语法糖通知("移除成功,未使用材料已返回材料","炼金提示")
		加载炼金队列()
		关闭弹窗())
	%"取消".pressed.connect(关闭弹窗)
	更新配方.pressed.connect(更新描述配方)
	关闭弹窗()
func 更新检查炼金队列():
	计划.手工.检查并更新队列("炼金")
func 扩容配方列表():
	计划.语法糖通知("功能锁定中","炼金提示")
func 保存配方():
	var 炼金数据:梅炼金数据=梅炼金数据.new(配方)
	if 炼金数据.配方格式检查(true):
		if 炼金数据.计算配方(true):
			var 配方队列=计划.手工.读取炼金配方列表(炼金数据,计划.修改枚举.添加)
			if 配方队列.has(炼金数据):
				清空配方()
				加载炼金配方()
				生成配方详情文本()
				计划.语法糖通知("添加成功","炼金提示")
				print("添加配方成功")
		else :
			print("错误配方计算失败")
			计划.语法糖通知("错误配方计算失败","炼金提示")
func 清空配方():
	配方=配方默认值.duplicate(true)
	配方格子.配方=配方
	配方格子.加载配方信息()
	生成配方详情文本()
func 加载炼金配方(更新预览:bool=false):
	var 配方节点:炼金配方卡片=preload("res://界面/插件/炼金配方.tscn").instantiate()
	var 炼金配方列表=计划.手工.读取炼金配方列表()
	清除子节点(%"炼金配方容器",%"标题")
	if 炼金配方列表.size()>=1:
		var 序号:int=0
		for 炼金数据:梅炼金数据 in 炼金配方列表:
			#print("加载成功",配方字典)
			var 克隆节点:炼金配方卡片=配方节点.duplicate()
			克隆节点.炼金数据=炼金数据
			克隆节点.序号=序号
			克隆节点.使用事件=func(数量:int=1):
				制作队列添加配方(炼金数据,数量)
			克隆节点.删除事件=func():
				移除炼金配方(炼金数据)
			克隆节点.查看事件=func():
				生成预览描述(炼金数据)
				%"预览配方".visible=true
			克隆节点.移动事件=加载炼金配方
			序号+=1
			%"炼金配方容器".add_child(克隆节点)
		if 更新预览:生成预览描述(炼金配方列表[0])
	else :
		if 更新预览:生成预览描述()
	
func 加载炼金队列():
	var 配方节点:队列卡片=preload("res://界面/插件/队列卡片.tscn").instantiate()
	var 队列炼金存档=计划.手工.队列炼金()
	清除子节点(%"炼金台队列",%"标题2")
	var 序号:int=0
	for 队列数据 in 队列炼金存档:
		var 克隆节点:队列卡片=配方节点.duplicate()
		克隆节点.序号=序号
		克隆节点.队列数据=队列数据
		克隆节点.回调节点=self
		克隆节点.界面更新方法=队列界面更新方法
		序号+=1
		%"炼金台队列".add_child(克隆节点)
func 队列界面更新方法(队列数据:梅队列数据):
	加载炼金队列()
	生成预览描述(队列数据)
func 取消制作弹窗(队列删除方法:Callable):
	%"弹窗文本".text="[color=#f1c40f]注意[/color]：当前炼金台正在炼制的这一炉，若确认终止：
	• 正在炼制的该炉炼金材料[color=#f1c40f]将不予返还[/color]
	• 已添加的其他排队配方不受影响
	是否确认终止本次炼制？"
	删除方法=队列删除方法
	%"弹窗提示".visible=true
func 关闭弹窗():
	%"弹窗提示".visible=false
func 移除炼金配方(炼金数据:梅炼金数据):
	var 炼金配方存档: Array=计划.手工.读取炼金配方列表()
	if not 炼金配方存档.has(炼金数据):
		加载炼金配方()
		计划.语法糖通知("错误:尝试删除一个未知配方","炼金窗口")
		return
	计划.手工.读取炼金配方列表(炼金数据,计划.修改枚举.删除)
	计划.语法糖通知("移除成功","炼金窗口")
	加载炼金配方()
func 制作队列添加配方(炼金数据:梅炼金数据,数量:int=1):
	if not 炼金数据.配方格式检查(true):
		计划.语法糖通知("配方不完整无法使用","炼金窗口")
		return false#格式错误
	计划.手工.队列炼金(炼金数据,数量)
	加载炼金队列()
	计划.保存存档("炼金队列")
@onready var 卡片区: 手牌容器 = %卡片区
@onready var 描述容器: 梅物品格子 = %描述容器
@onready var 更新配方: Button = %更新配方
var 保存描述配方:梅炼金数据=null
func 生成预览描述(炼金数据:梅炼金数据=null):
	var 文本:=""
	if 炼金数据:
		文本="%s\r版本:v%d"%[解析配方(炼金数据.配方字典),炼金数据.版本号]
		卡片区.更新手牌(炼金数据)
		保存描述配方=炼金数据
		更新格子上限()
	else :
		计划.清除子节点(卡片区)
		文本="当你保存配方后就可以点击配方查看炼金结果\r或者更改第四个材料"
		保存描述配方=null
		更新格子上限()
	%"配方预览".text=文本
func 更新格子上限():
	if 保存描述配方:
		var 炼金催化剂=保存描述配方.催化剂
		var 格子上限=计划.手工.数据炼金催化剂(炼金催化剂,"材料容量")
		var 材料:Dictionary=保存描述配方.返回材料(4)
		描述容器.道具名称=材料.名称
		描述容器.当前值=max(5,材料.数量)
		描述容器.物品数量限制=Vector2i(5,格子上限)
		if 描述容器.输入:
			描述容器.输入.min_value=5
			描述容器.输入.max_value=格子上限
		描述容器.更新文本()
	else :
		描述容器.物品数量限制=Vector2i(5,15)
		if 描述容器.输入:
			描述容器.输入.min_value=5
			描述容器.输入.max_value=15
	#breakpoint#断点
func 更新描述配方():
	if 保存描述配方 and 描述容器:
		if 保存描述配方.队列中:
			计划.语法糖通知("你不能修改正在制作中的配方","炼金通知")
			return
		计划.语法糖通知("正在修改配方","炼金通知")
		保存描述配方.更新附加材料(描述容器.道具名称,描述容器.当前值)
		生成预览描述(保存描述配方)
	else :
		计划.语法糖通知("需要先保存配方","炼金通知")
		生成预览描述()
func 生成配方详情文本():
	var 文本=解析配方(配方)
	%"配方详情".text=文本
func 解析配方(配方字典):
	var 文本="催化剂:"+(查询图片(配方字典["催化剂"],60)+"\r"if not 配方字典["催化剂"]==null else "\r")
	文本+="材料:"
	if 配方字典.get("材料名称",[]).size()>=1:
		var 序号=0
		for 图片名称 in 配方字典["材料名称"]:
			文本+=(""if 序号==0 else",")+查询图片(图片名称,60)+"*"+str(配方字典["材料数量"][序号])
			序号+=1
	return 文本
func 查询图片(图片,尺寸:int)->String:
	if 图片 in 计划.表格.蓝图字典:
		var 图片文本=计划.表格.蓝图字典[图片][计划.表格.蓝图表头["icon"]]
		return "[img="+str(尺寸)+"x"+str(尺寸)+"]"+图片文本+"[/img]"
	return ""
func 返回处理方法(_节点=null):
	if _节点==描述容器:
		if 保存描述配方:
			if 保存描述配方.队列中:
				计划.语法糖通知("你不能修改正在制作中的配方","炼金通知")
				return
	else :
		配方=%"配方格子".配方
		生成配方详情文本()



#一、核心层级颜色方案（适配子区域）
#主色调（基础区域）：#8d6e2f（原始色，用于主界面、核心模块）
#一级子区域色：#b08e45（比主色亮 20%，明度提升，视觉优先级高，适配主要功能子区）
#二级子区域色：#6b5423（比主色暗 20%，明度降低，视觉从属，适配次级功能子区）
#三级子区域色（可选）：#d4b466（比一级色更亮 15%，用于细分小模块，避免层级混淆）
#二、辅助强调色（增强区分）
#功能强调色：#a13d30（暗红棕，与主色调同色系，用于按钮、警示等关键交互元素）
#背景过渡色：#f5eee0（浅米白，搭配主色调不突兀，用于子区域背景分层）
