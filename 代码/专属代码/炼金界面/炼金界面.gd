extends 基类梅窗口
#var 配方默认值: Dictionary=	{"材料名称"=["炽心草茎","发条虫蜕","风翎符片","腐翼鳞粉"],
						#"材料数量"=[5,6,7,10],
						#"催化剂"="圣盾徽记"}
var 配方默认值: Dictionary={"材料名称":[],
						"材料数量":[],
						"催化剂":null}
var 配方: Dictionary=配方默认值.duplicate(true)
var 配方编号=-1
var 存档配方数组=[]
var 配方格子
func _ready() -> void:
	#print(打印抽奖结果(计算配方({"材料名称"=["炽心草茎","血牙结晶","腐翼鳞粉"],
						#"材料数量"=[32,32,5],
						#"催化剂"="圣盾徽记"},20)))
	super._ready()
	背包折叠(true)
	%"背包栏".folding_changed.connect(func(折叠): 背包折叠(折叠))
	GBIS.connect("鼠标物品",func():
		背包折叠(true))
	生成预览描述()
	生成配方详情文本()
	配方格子=%"配方格子"
	配方格子.配方编号=-1
	配方格子.配方=配方
	配方格子.修改返回对象=self
	配方格子.加载配方信息()
	生命周期计时器+=[计划.创建计时器(8,func(): 定期更新提示文本(%"温馨提示"))]#每隔8秒更新一次文本
	定期更新提示文本(%"温馨提示")
	加载炼金配方()
	加载炼金队列()
	%"扩容配方列表".pressed.connect(扩容配方列表)
	%"保存配方".pressed.connect(保存配方)
	%"清空配方".pressed.connect(清空配方)
	%"确认".pressed.connect(func():删除制作队列())
	%"取消".pressed.connect(func():关闭弹窗())
	关闭弹窗()
func 扩容配方列表():
	pass
func 保存配方():
	if 配方格式检查(配方,true):
		计划.梅存档["手工"]["炼金配方列表"]+=[配方]
		清空配方()
		加载炼金配方()
		生成配方详情文本()
func 清空配方():
	配方=配方默认值.duplicate(true)
	配方格子.配方=配方
	配方格子.加载配方信息()
	生成配方详情文本()
func 背包折叠(折叠:=true):
	%"背包栏".folded=折叠
	if 折叠:
		%"背包栏".title="<背包"
		%"背包栏".size=Vector2(180,60)
		%"背包栏".position=Vector2(1520,100)
	else :
		%"背包栏".title="背包>"
		%"背包栏".size=Vector2(1000,900)
		%"背包栏".position=Vector2(675,100)
func 加载炼金配方():
	var 配方节点:炼金配方卡片=preload("res://界面/插件/炼金配方.tscn").instantiate()
	var 炼金配方存档=计划.梅手工单例.读取炼金配方列表()
	清除子节点(%"炼金配方容器",%"标题")
	var 序号:int=0
	for 配方字典 in 炼金配方存档:
		print("加载成功",配方字典)
		var 克隆节点:炼金配方卡片=配方节点.duplicate()
		克隆节点.配方=配方字典
		克隆节点.序号=序号
		克隆节点.使用事件=func(数量:int=1):
			制作队列添加配方(配方字典,数量)
		克隆节点.删除事件=func():
			移除炼金配方(序号)
		克隆节点.查看事件=func():
			生成预览描述(序号)	
			%"预览配方".visible=true
		序号+=1
		%"炼金配方容器".add_child(克隆节点)
func 加载炼金队列():
	var 配方节点:炼金队列卡片=preload("res://界面/插件/炼金队列.tscn").instantiate()
	var 队列炼金存档=计划.梅手工单例.队列炼金()
	清除子节点(%"炼金台队列",%"标题2")
	var 序号:int=0
	for 队列字典 in 队列炼金存档:
		print("加载成功",队列字典)
		var 克隆节点:炼金队列卡片=配方节点.duplicate()
		克隆节点.炼金哈希=队列字典["配方"]
		克隆节点.序号=序号
		克隆节点.领取事件=func():领取奖励(序号)
		克隆节点.取消事件=func():取消制作弹窗(序号)
		序号+=1
		%"炼金台队列".add_child(克隆节点)

func 领取奖励(序号):
	print("领取被执行",序号)
	var 炼金队列: Array=计划.梅手工单例.队列炼金()
	if 炼金队列.size()>序号:
		var 配方数据 = 炼金队列[序号]
		if 配方数据["完成"]>0:
			var 哈希结果=配方数据["配方"]
			var 炼金配方: Dictionary=计划.梅手工单例.手工系统["炼金配方"]
			var 炼金数据=炼金配方[哈希结果]
			var 药水数组=炼金数据["药水"]
			var 数量数组=炼金数据["数量"]
			var 药水长度=药水数组.size()
			var 统计奖励=[]
			for i in 配方数据["完成"]:
				var 药水名称=药水数组[炼金数据["炼金次数"]%药水长度]
				var 药水数量=数量数组[炼金数据["炼金次数"]%药水长度]
				炼金数据["炼金次数"]+=1
				统计奖励+=[计划.语法糖获得物品(药水名称,药水数量)]
			计划.语法糖奖励显示(统计奖励,"获得药水",1)
			配方数据["完成"]=0
			if 配方数据["剩余"]<=0:
				计划.手工.队列炼金("",1,序号)
				加载炼金队列()
			计划.保存存档("领取炼金奖励")
func 取消制作弹窗(序号):
	%"弹窗文本".text="[color=#f1c40f]注意[/color]：当前炼金台正在炼制的这一炉，若确认终止：
	• 正在炼制的该炉炼金材料[color=#f1c40f]将不予返还[/color]
	• 已添加的其他排队配方不受影响
	是否确认终止本次炼制？"
	配方编号=序号
	%"弹窗提示".visible=true
func 删除制作队列():
	var 炼金队列: Array=计划.梅手工单例.队列炼金()
	if 配方编号<炼金队列.size():
		var 剩余数量=炼金队列[配方编号]["剩余"]-1
		if 剩余数量>=1:
			var 配方哈希=炼金队列[配方编号]["配方"]
			var 炼金配方: Dictionary=计划.梅手工单例.手工系统["炼金配方"]
			扣除炼金材料(炼金配方[配方哈希]["配方"],-剩余数量)
		计划.手工.队列炼金("",1,配方编号)
	关闭弹窗()
	加载炼金队列()
func 关闭弹窗():
	配方编号=-1
	%"弹窗提示".visible=false
func 移除炼金配方(序号):
	var 炼金配方存档: Array=计划.梅手工单例.读取炼金配方列表()
	if 序号>=炼金配方存档.size():
		加载炼金配方()
		计划.语法糖通知("错误:尝试删除一个未知配方","炼金窗口")
		return
	炼金配方存档.remove_at(序号)
	计划.语法糖通知("移除成功","炼金窗口")
	加载炼金配方()
func 制作队列添加配方(配方字典,数量:int=1):
	if not 配方格式检查(配方字典):
		计划.语法糖通知("配方不完整无法使用","炼金窗口")
		return false#格式错误
	if 材料数量检查(配方字典,数量):#材料足够
		var 炼金队列: Array=计划.梅手工单例.队列炼金()
		var 配方哈希结果=计划.梅手工单例.哈希配方(配方字典)
		if 炼金队列.any(func(队列项): return 队列项["配方"] == 配方哈希结果):
			计划.语法糖通知("配方已经在队列中","炼金窗口")
			return false#配方已经在队列中
		var 炼金配方: Dictionary=计划.梅手工单例.手工系统["炼金配方"]
		if not 配方哈希结果 in 炼金配方:
			var 炼金结果=计算配方(配方字典,20)
			炼金配方[配方哈希结果]=炼金结果
		扣除炼金材料(配方字典, 数量)
		计划.梅手工单例.队列炼金(配方哈希结果,数量)
		加载炼金队列()
		计划.保存存档("炼金队列")
		计划.语法糖通知("配方加入队列,材料已扣除","炼金窗口")
# 核心方法：计算配方并返回{药水: [], 数量: []}字典（含装备药水保底）
func 计算配方(配方字典, 抽取次数: int=20) -> Dictionary:
	# 1. 计算配方的6个属性总和（创造/勇气/奇异/洞察/复苏/齿轮）
	var 属性总和字典 = 计算权重(配方字典)
	# 2. 筛选药水类物品并生成项目/权重列表
	var 药水类物品 = 计划.表格.筛选物品("分类","药水")
	var 项目列表: Array = []
	var 权重列表: Array = []
	for 药水 in 药水类物品:
		var 权重:int = 0
		var 药水倾向 = 计划.表格.获取属性(药水,"药水倾向",[])
		# 原有权重计算逻辑（完全保留）
		for i in (药水倾向.size()/3):
			if 药水倾向[i*3] == "任意":
				权重 += 药水倾向[i*3+2]
			elif 属性总和字典.get(药水倾向[i*3], 0) >= 药水倾向[i*3+1]:
				权重 += 药水倾向[i*3+2]
		if 权重 > 0:
			项目列表.append(药水)
			权重列表.append(权重)
	var 催化剂名称 = 配方字典["催化剂"]#装备药水逻辑
	var 炼金药水 = 计划.表格.获取属性(催化剂名称,"炼金药水",[])
	var 装备药水 = null
	# 判断是否满足装备药水解锁条件
	if 炼金药水.size()>=3:
		装备药水 = 炼金药水[0]  # 装备药水名称（比如"圣坚药水"）
	print(炼金药水)
	# 若装备药水有效，加入抽取池
	if 装备药水 != null:
		var 药水权重=属性总和字典.get(炼金药水[1], 0)
		if 药水权重>=炼金药水[2]:
			项目列表.append(装备药水)
			权重列表.append(min(药水权重+5,炼金药水[2]*2))  # 给装备药水设置权重随属性递增额外+5,但不超过两倍
		else :
			项目列表.append(装备药水)
			权重列表.append(炼金药水[2])  # 给装备药水设置权重至少
	# 3. 初始化固定种子的随机数生成器（保证抽取+保底替换都稳定）
	var 随机 = RandomNumberGenerator.new()
	var 哈希字符串 = 计划.梅手工单例.哈希配方(配方字典)
	随机.seed = 哈希字符串.hash()
	# 4. 初始化返回字典（药水数组+数量数组）其他数据用于调试
	var 抽取结果: Dictionary = {
		"药水": [],
		"数量": [],
		"版本号":1,
		"炼金次数":0,
		"催化剂":催化剂名称,
		"配方":配方字典.duplicate(true),
		#"属性总和字典":属性总和字典,
		#"项目列表":项目列表,
		#"权重列表":权重列表,
		}
	# 5. 权重抽取+数量计算核心逻辑
	if 项目列表.size() > 0 and 抽取次数 > 0:
		var 权重数组 = PackedFloat32Array(权重列表)
		for i in range(抽取次数):
			# 5.1 抽取药水（内置rand_weighted）
			var 随机索引 = 随机.rand_weighted(权重数组)
			if 随机索引 < 0 or 随机索引 >= 项目列表.size():
				continue # 极端情况跳过（外部已验证，仅兜底）
			var 选中药水 = 项目列表[随机索引]
			# 5.2 计算该药水的数量（核心逻辑）
			var 药水数量配置 = 计划.表格.获取属性(选中药水, "药水数量", [])
			var 最终数量:int= 1 # 默认数量
			if 药水数量配置.size() >= 4: # 配置有效：[属性名, 阈值, 最小数量, 最大数量]
				var 目标属性名 = 药水数量配置[0]
				var 每X点属性 = max(药水数量配置[1], 1) # 避免除以0
				var 基础最小数量 = 药水数量配置[2]
				var 基础最大数量 = 药水数量配置[3]
				var 属性总值 = max(属性总和字典.get(目标属性名, 0),0)+属性总和字典.get("任意", 0)*0.15
				var 属性次数:int = int(属性总值**0.8 / 每X点属性)
				var 随机数量 = 随机.randi_range(0, 属性次数)
				最终数量 = clamp(随机数量, 基础最小数量, 基础最大数量)
			else:
				var 随机数量 = 随机.randi_range(1, 1)#消耗掉这个随机机会,保持种子一致
				最终数量 = clamp(随机数量, 1, 1)
			# 5.3 加入结果字典
			抽取结果["药水"].append(选中药水)
			抽取结果["数量"].append(最终数量)
	# ===== 核心新增：装备药水保底逻辑 =====
	if 装备药水 != null and 抽取结果["药水"].size() > 0:
		# 检查抽取结果中是否包含装备药水
		var 包含装备药水 = 装备药水 in 抽取结果["药水"]
		if not 包含装备药水:
			# 随机选一个位置替换为装备药水（数量强制为1）
			# 基于固定种子的随机数，保证替换位置稳定
			var 替换索引 = 随机.randi_range(0, 抽取结果["药水"].size() - 1)
			抽取结果["药水"][替换索引] = 装备药水
			抽取结果["数量"][替换索引] = 1  # 保底的装备药水数量固定为1
	return 抽取结果
func 打印抽奖结果(抽取结果):
	var 药水数量统计: Dictionary = {}
	# 2. 获取原字典的两个数组（确保长度一致，避免越界）
	var 药水名称数组: Array = 抽取结果["药水"]
	var 数量数组: Array = 抽取结果["数量"]
	if 药水名称数组.size() != 数量数组.size():
		print("错误：药水数组和数量数组长度不一致！")
		return 抽取结果 # 长度异常时返回原结果
	# 3. 遍历数组，累加每个药水的总数量
	for i in 药水名称数组.size():
		var 药水名: String = 药水名称数组[i]
		var 数量: int = 数量数组[i]
		# 如果药水名已存在，累加数量；不存在则初始化
		if 药水数量统计.has(药水名):
			药水数量统计[药水名] += 数量
		else:
			药水数量统计[药水名] = 数量
	# 4. 打印统计后的字典（格式化输出更易读）
	print("=== 药水数量统计结果 ===")
	for 药水名 in 药水数量统计:
		print(药水名, "：", 药水数量统计[药水名], "个")
func 计算权重(配方字典):
	var 目标属性列表 = ["创造", "勇气", "奇异", "洞察", "复苏", "齿轮"]
	var 材料名称列表 = 配方字典.get("材料名称", [])# 从配方中提取材料名称和数量
	var 材料数量列表 = 配方字典.get("材料数量", [])
	var 属性总和字典 = {"任意":0}
	var 材料属性字典 = {}
	for 材料名称 in 材料名称列表:
		var 材料字典 = 计划.表格.获取属性(材料名称, "炼金属性",{})
		材料属性字典[材料名称]=材料字典
	for 属性 in 目标属性列表:
		属性总和字典[属性] = 0
		for i in 材料名称列表.size():
			var 目标属性=材料属性字典[材料名称列表[i]].get(属性,0)
			属性总和字典[属性]+=目标属性*材料数量列表[i]
			属性总和字典["任意"]+=目标属性*材料数量列表[i]
	return 属性总和字典
func 材料数量检查(配方字典,数量:int=1):
	for i in 配方字典["材料名称"].size():
		var 物品名称=配方字典["材料名称"][i]
		var 背包内数量=计划.检查背包物品数量(物品名称)
		var 需求数量=配方字典["材料数量"][i]*数量
		if 需求数量>背包内数量:
			计划.语法糖通知("材料:"+物品名称+"数量不足","炼金窗口")
			return false#数量不足
	if 数量>计划.检查背包物品数量(配方字典["催化剂"]):
		计划.语法糖通知("催化剂:"+配方字典["催化剂"]+"数量不足","炼金窗口")
		return false#数量不足
	return true
func 扣除炼金材料(配方字典, 数量:int=1):
	if 数量 == 0:
		return# 数量为0时直接返回，不执行任何操作
	for i in range(配方字典["材料名称"].size()):
		var 物品名称 = 配方字典["材料名称"][i]
		var 变动数量 = 配方字典["材料数量"][i] * 数量
		if 变动数量 > 0:# 正数调用消耗，负数取绝对值调用获得
			计划.语法糖消耗物品(物品名称, 变动数量)
		elif 变动数量 < 0:
			计划.语法糖获得物品(物品名称, -变动数量)
	var 催化剂名称 = 配方字典["催化剂"]# 2. 处理催化剂（正数扣除，负数获得）
	if 数量 > 0:
		计划.语法糖消耗物品(催化剂名称, 数量)
	elif 数量 < 0:
		计划.语法糖获得物品(催化剂名称, -数量)
func 配方格式检查(配方字典, 生成通知:bool=false):
	if not ("材料名称" in 配方字典 and "材料数量" in 配方字典 and "催化剂" in 配方字典):# 1. 检查字典必备键是否存在
		if 生成通知:
			计划.语法糖通知("添加失败:配方损坏","炼金窗口")
		return false # 字典格式错误
	var 材料名称类型合法 = 配方字典["材料名称"] is Array
	var 材料数量类型合法 = 配方字典["材料数量"] is Array
	var 催化剂类型合法 = 配方字典["催化剂"] is String and 配方字典["催化剂"] != ""
	if not (材料名称类型合法 and 材料数量类型合法 and 催化剂类型合法):# 2. 检查各字段数据类型
		if 生成通知:
			if not 催化剂类型合法:
				计划.语法糖通知("添加失败:缺少催化剂","炼金窗口")
			else:
				计划.语法糖通知("添加失败:配方损坏","炼金窗口")
		return false # 数据类型错误
	var 数组长度匹配 = 配方字典["材料名称"].size() == 配方字典["材料数量"].size()
	var 材料数量达标 = 配方字典["材料名称"].size() >= 3
	if not (数组长度匹配 and 材料数量达标):# 3. 检查材料数组长度匹配且最少3种材料
		if 生成通知:
			if not 材料数量达标:
				计划.语法糖通知("添加失败:至少放入3种炼金材料","炼金窗口")
			else:
				计划.语法糖通知("添加失败:配方损坏","炼金窗口")
		return false # 配方错误
	var 已记录的材料名:Array=[]
	for 材料名 in 配方字典["材料名称"]:
		if 材料名 == "":#检查材料名称非空
			if 生成通知:
				计划.语法糖通知("添加失败:材料名称不能为空","炼金窗口")
			return false
		if 材料名 in 已记录的材料名:#检查材料名称重复
			if 生成通知:
				计划.语法糖通知("添加失败:材料名称重复","炼金窗口")
			return false
		已记录的材料名.append(材料名)
	return true# 所有检查通过
@warning_ignore("unused_parameter")
func 生成预览描述(序号=-1):
	var 文本:="当你了解配方的奥秘后在配方界面
点击查看预览了解配方详情"
	if 序号!=-1:
		var 炼金配方存档=计划.梅手工单例.读取炼金配方列表()
		var 哈希结果=计划.梅手工单例.哈希配方(炼金配方存档[序号])
		var 炼金配方: Dictionary=计划.梅手工单例.手工系统["炼金配方"]
		var 炼金数据=炼金配方[哈希结果]
		文本="版本号:"+str(炼金数据["版本号"])
		文本+="\r"+解析配方(炼金数据["配方"])
		var 药水=炼金数据["药水"]
		var 数量=炼金数据["数量"]
		文本+="\r药水列表:"
		for i in 药水.size():
			文本+=查询图片(药水[i],60)+"*"+str(数量[i])
	%"配方预览".text=文本
func 生成配方详情文本():
	var 文本="当前配方\r"+解析配方(配方)
	%"配方详情".text=文本
func 解析配方(配方字典):
	var 文本="催化剂:"+(查询图片(配方字典["催化剂"],100)+"\r"if not 配方字典["催化剂"]==null else "\r")
	文本+="材料:"
	if 配方字典.get("材料名称",[]).size()>=1:
		var 序号=0
		for 图片名称 in 配方字典["材料名称"]:
			文本+=(""if 序号==0 else",")+查询图片(图片名称,80)+"*"+str(配方字典["材料数量"][序号])
			序号+=1
	return 文本
func 查询图片(图片,尺寸:int):
	if 图片 in 计划.表格.蓝图字典:
		var 图片文本=计划.表格.蓝图字典[图片][计划.表格.蓝图表头["icon"]]
		return "[img="+str(尺寸)+"x"+str(尺寸)+"]"+图片文本+"[/img]"
	return
func 返回处理方法():
	配方=%"配方格子".配方
	生成配方详情文本()
	
	
	
