@tool  # 标记为工具脚本，支持在编辑器中运行
extends EditorScript
# 右键运行的入口方法（编辑器中右键脚本→Run Script执行）
func _run():
	print("===== 开始测试新建存档 =====")
	
	# 1. 创建梅存档数据库实例
	var 存档数据库: 梅存档格式 = 梅存档格式.new()
	存档数据库.梅存档={"测试":0}
	# 2. 测试1：使用默认存档名新建
	print("\n【测试1：默认命名】")
	var 默认创建结果: bool = 存档数据库.存档()
	if 默认创建结果:
		print("默认命名存档创建成功")
	else:
		print("默认命名存档创建失败")
	
	# 3. 测试2：使用自定义命名新建（模拟玩家输入）
	print("\n【测试2：自定义命名】")
	var 自定义存档名: String = "测试存档_2025"
	var 自定义创建结果: bool = 存档数据库.存档(自定义存档名)
	if 自定义创建结果:
		print("自定义命名存档创建成功 → ", 自定义存档名)
	else:
		print("自定义命名存档创建失败 → ", 自定义存档名)
	
	# 4. 测试3：加载所有存档，验证创建结果
	print("\n【测试3：加载所有存档】")
	var 所有存档: Dictionary = 存档数据库.加载所有存档()
	print("当前存档列表：", 所有存档.keys())
	
	print("\n===== 存档测试结束 =====")
