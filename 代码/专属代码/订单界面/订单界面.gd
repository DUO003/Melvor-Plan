extends 基类梅窗口
var 种子
var 订单更新计时器: Timer=null
var UI更新计时器: Timer=null
var 订单上限=[3,0]
var 订单数组=[0,0]
var 生成间隔:int=300
var 网格容器
func _ready() -> void:
	super._ready()
	订单上限=初始化.梅存档["挂机"].get("订单上限",订单上限)
	初始化.梅存档["挂机"]["订单上限"]=订单上限
	网格容器=%"网格容器"
	种子=randi()
	检查生成订单()
	加载订单()
	UI更新计时器=初始化.创建计时器(1,更新UI)
	%"手动刷新".pressed.connect(func(): 手动刷新订单())
	单独更新订单(%"订单上限/文本",0,300)
	%"订单上限/升级".pressed.connect(func():
		升级订单容量(0,300)
		单独更新订单(%"课题订单/文本",0,300))
	单独更新订单(%"课题订单/文本",1,500)
	%"课题订单/升级".pressed.connect(func():
		升级订单容量(1,500)
		单独更新订单(%"课题订单/文本",1,500))
func _exit_tree() -> void:
	if not 订单更新计时器==null:
		订单更新计时器.queue_free()
	if not UI更新计时器==null:
		UI更新计时器.queue_free()
func 手动刷新订单():
	if 初始化.体力门票(5):
		新增订单()
		更新UI()
		初始化.emit_signal("更新_UI")
func 升级订单容量(类型=0,增长需求=200):
	订单上限=初始化.梅存档["挂机"].get("订单上限",订单上限)
	if 初始化.梅存档["金币"]>=(订单上限[类型]+1)*增长需求:
		订单上限[类型]+=1
		初始化.梅存档["挂机"]["订单上限"]=订单上限
		更新UI()
		初始化.保存存档("订单扩容 类型:"+str(类型))
	else :
		引擎.屏幕.滚动提示("金币不足","订单提示")
func 单独更新订单(节点,类型,增长需求):
	订单上限=初始化.梅存档["挂机"].get("订单上限",订单上限)
	节点.text=str((订单上限[类型]+1)*增长需求)+"金币\r"
	节点.text+="增加栏位"
func 更新UI():
	var 当前时间: float=Time.get_unix_time_from_system()
	var 订单时间戳: float = 初始化.梅存档["挂机"].get("订单时间戳",当前时间-生成间隔*3)
	var 剩余时间 = max(1,生成间隔 - int(当前时间 - 订单时间戳) % 生成间隔)
	检查订单容量()
	%"刷新倒计时".text="刷新倒计时:"+初始化.格式化时间(剩余时间,2)
	%"订单上限".text="订单上限:"+str(订单数组[0])+"/"+str(订单上限[0])
	%"课题订单".text="课题订单:"+str(订单数组[1])+"/"+str(订单上限[1])
func 检查订单容量():
	var 订单存档=初始化.梅存档["挂机"].get("订单存档",[])
	订单数组=[0,0]
	for 订单 in 订单存档:
		#print(订单)
		订单数组[订单.get("订单标记")]+=1
func 检查生成订单():
	var 当前时间: float=Time.get_unix_time_from_system()
	var 订单时间戳: float = 初始化.梅存档["挂机"].get("订单时间戳",当前时间-生成间隔*订单上限[0])
	var 新增订单数量:int = int((当前时间 - 订单时间戳) / 生成间隔)  # 显式取整
	if 新增订单数量>=1:
		订单时间戳+=新增订单数量*生成间隔
	初始化.梅存档["挂机"]["订单时间戳"]=订单时间戳
	if 订单更新计时器==null or 订单更新计时器.is_queued_for_deletion():
		if not is_queued_for_deletion():#预防最后一帧触发导致没有对象
			var 剩余时间 = max(1,生成间隔 - int(当前时间 - 订单时间戳) % 生成间隔)
			订单更新计时器=初始化.创建计时器(剩余时间,func():
				检查生成订单(),false)
	if 新增订单数量>=1:
		新增订单(新增订单数量)
	更新UI()
func 加载订单():
	# 第一步：检查并清理没有唯一ID的订单
	var 订单存档 = 初始化.梅存档["挂机"].get("订单存档", [])
	var 有效订单 = []
	for 订单信息 in 订单存档:
		if 订单信息.get("ID", "") != "":  # 检查ID是否为空
			有效订单.append(订单信息)
		else:
			print("发现无效订单（缺少ID）：", 订单信息)
	# 更新存档（只保留有效订单）
	if 有效订单.size() != 订单存档.size():
		初始化.梅存档["挂机"]["订单存档"] = 有效订单
		初始化.保存存档("清理无效订单")
		print("已清理无效订单，原数量：", 订单存档.size(), "，现数量：", 有效订单.size())
	# 第二步：加载有效订单
	清除子节点(%"网格容器")
	var 随机生成器: RandomNumberGenerator= RandomNumberGenerator.new()
	随机生成器.seed = 种子
	for 订单信息 in 有效订单:
		var 订单场景实例:订单卡片 = preload("res://界面/插件/订单.tscn").instantiate()
		订单场景实例.订单字典 = 订单信息
		订单场景实例.装饰随机数=随机生成器.randi() % 订单场景实例.装饰词数组.size()
		%"网格容器".add_child(订单场景实例)
		
func 新增订单(订单数量:int=1,订单类型=-1,订单池=["铁锭","纤维","鞣革"],禁用保存=false):#默认值完成一轮订单刷新
	if 订单类型==-1:#-1为尝试刷新所有类型的订单
		检查订单容量()
		新增订单(订单数量,0,订单池,true)
		var 课题订单=0
		for i in 订单数量:
			if 0.25>=randf():
				课题订单+=1
		var 课题=获取已解锁指定类型图纸()
		if 课题.size()>=1 and 课题订单>=1:
			新增订单(课题订单,1,课题,true)
		elif 课题.size()==0:
			引擎.屏幕.滚动提示("课题订单需要先解锁至少1张图纸")
	else :
		订单数量=min(订单上限[订单类型]-订单数组[订单类型],订单数量)
		print("订单类型",订单类型,"*",订单数量)
		if 订单数组[订单类型]<订单上限[订单类型]:
			var 缓存订单=初始化.梅存档["挂机"].get("订单存档",[])
			for i in 订单数量:
				if 订单数组[订单类型]<订单上限[订单类型]:
					var 随机索引 = randi() % 订单池.size()
					缓存订单+=[{"名称":订单池[随机索引],
				"ID":初始化.唯一ID(缓存订单.size()),
				"订单量":随机订单数量(订单类型),
				"幸运值":max(5*(-5+randi() % 10),0),
				"订单标记":订单类型,
				#"时限":Time.get_unix_time_from_system()+7200
				}]
				订单数组[订单类型]+=1
			初始化.梅存档["挂机"]["订单存档"]=缓存订单
	if not 禁用保存:
		加载订单()
		初始化.保存存档("测试资源订单")
func 随机订单数量(类型):
	if 类型==1:
		return 10+(randi() % 6)
	return 10+5*(randi() % 4)
func 获取已解锁指定类型图纸():
	var 图纸数据=梅表格.装备蓝图
	var 类型=图纸数据[0].find("类型")
	var 手工数据: Dictionary=初始化.梅存档["手工"]
	var 研究方向: Array =手工数据.get("研究方向",[])
	var 图纸数组=[]
	for 图纸 in 图纸数据:
		if 图纸[类型] in 研究方向:
			var 名称=图纸[0]
			if 名称 in 手工数据:
				图纸数组=[名称]
	return 图纸数组
