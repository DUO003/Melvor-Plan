func 任务全局更新(初始化=false):
	for 任务数据:任务资源 in 当前任务数据:
		if 任务数据.任务完成:
			任务全局.erase(任务数据)
		else :
			追加全局字典任务(任务数据)
		if 初始化 and 唯一任务字典.has(任务数据.任务名称):
			计划.红点.红点字典["任务_"+任务数据.任务名称]=func():return 任务红点检查(任务数据.任务名称)
	更新_任务UI.emit()
func 检查主线任务完成(任务名称:String)->bool:
	if 唯一任务字典.has(任务名称):
		var 资源:任务资源=唯一任务字典[任务名称]
		if 资源 and 资源.任务完成:
			return true
	return false
##返回红点应该显示的数量
func 任务红点检查(任务名称:String)->int:
	if not 任务字典.has(任务名称):return 0
	if 唯一任务字典[任务名称].任务完成:return 0
	var 来源=任务字典[任务名称].get("来源","循环")
	if 来源=="循环" or 来源=="成就":return 0
	elif 唯一任务字典.has(任务名称) and 唯一任务字典[任务名称].任务状态:return 0
	if not 检查前置任务(任务名称):return 0
	if 计划.红点.红点数据.has("任务_"+任务名称) and not 计划.红点.红点数据["任务_"+任务名称]==0:return 0
	return 1
func 检查前置任务(任务名称:String)->bool:
	return 统计未完成前置任务(任务名称).size()==0
func 统计未完成前置任务(任务名称:String)->Array:
	if not 任务字典.has(任务名称):return []
	var 前置任务=任务字典[任务名称].get("前置任务",[])
	var 未完成:Array=[]
	for 条件 in 前置任务:
		if 唯一任务字典.has(条件):
			if not 唯一任务字典[条件].任务完成:
				未完成.append(条件)
	return 未完成
func 追加全局字典任务(任务数据:任务资源):
	var 任务可用:bool=任务数据.任务目标检查()
	if not 任务可用 or 任务全局.has(任务数据) or 任务数据.前置条件.is_empty():
		return
	var 任务名称:String=任务数据.任务名称
	var 条件数组:Array=任务数据.前置条件
	var 该任务存档:Array=任务数据.任务数据
	var 任务目标列表:Array=[]#1.构建任务目标列表
	var 当前进度列表:Array=[]#2.构建当前进度列表（从存档读取）
	var 缓存任务数据={}
	for i in range(条件数组.size()):
		var 条件:Dictionary=条件数组[i]
		if 条件.has_all(["类型","目标值"]):
			var 类型:进度类型=条件.类型
			if not 缓存任务数据.has(类型):
				缓存任务数据[类型]=[]
			缓存任务数据[类型].append([任务数据,i])
			任务目标列表.append({
				"条件类型":类型,
				"白名单":条件.get("白名单",[]),
				"限制标签":条件.get("限制标签",[]),
				"目标值":max(1,int(条件.目标值))})
			var 存档进度:int=int(该任务存档[i] if i < 该任务存档.size() else 0)
			当前进度列表.append(存档进度)
		else :
			print("[b]任务[/b]:",任务名称,"/r存在非法类型参数:",条件数组)
			return#非法结果跳出循环,打印日志放弃当前任务.
	for 任务的数据:进度类型 in 缓存任务数据:
		if not 缓存任务.has(任务的数据):
			缓存任务[任务的数据]=[]
		缓存任务[任务的数据]+=缓存任务数据[任务的数据]
		任务数据.循环来源.append(进度类型映射[任务的数据])
		#print("任务检查:<%s>:%s"%[任务数据.任务名称,进度类型映射[任务的数据]])
	var 目标完成标记:Array=[]#3.构建目标完成标记
	var 完成总进度=0
	for i in range(任务目标列表.size()):
		var 目标值:int=任务目标列表[i]["目标值"]
		var 当前进度:int=当前进度列表[i]  # 获取当前目标的进度
		var 目标占比:float=1.0# 计算当前目标的进度占比,默认1
		if not 当前进度 >= 目标值:
			目标占比 = 1.0*当前进度 / 目标值  # 未完成，按比例计算
		完成总进度+=目标占比
		目标完成标记.append(当前进度>=目标值)
	任务数据.任务本地={#赋值到任务全局字典
		"任务目标列表":任务目标列表,
		"完成总进度":完成总进度,
		"当前进度列表":当前进度列表,
		"目标完成标记":目标完成标记}
	任务全局[任务数据]=任务数据.任务本地
var 记录任务完成={}
func 结算任务完成():
	记录任务完成.手工=完成任务计数("手工")
var 来源缓存:Dictionary={}
func 筛选任务来源(任务)->Array:
	var 来源数组:Array=[]
	if 来源缓存.has(任务):
		来源数组=来源缓存[任务]
	else :
		for 任务名 in 任务字典:
			if 任务字典[任务名].has("来源") and 任务字典[任务名]["来源"]==任务:
				来源数组.append(任务名)
		来源缓存[任务]=来源数组
	return 来源数组
func 筛选任务来源资源(任务类型:String)->Array[任务资源]:
	var 任务类型数组:Array[任务资源]=[]
	for 任务数据 in 当前任务数据:
		if 任务数据.任务类型==任务类型:
			任务类型数组.append(任务数据)
	return 任务类型数组
func 完成任务计数(任务)->int:
	var 来源数组:Array[任务资源]=筛选任务来源资源(任务)
	var 完成次数 = 0  # 统计满足条件的任务数量
	for 任务数据 in 来源数组:
		if 任务数据.任务完成:
			完成次数 += 1  # 每满足一个，次数+1
	return 完成次数

## 返回更新后任务总进度
func 返回完成度(任务本地:Dictionary)-> float:
	var 完成总进度=0
	var 任务目标列表=任务本地["任务目标列表"]
	var 当前进度列表=任务本地["当前进度列表"]
	for i in range(任务目标列表.size()):
		var 目标值:int=任务目标列表[i]["目标值"]
		var 当前进度:int=当前进度列表[i]  # 获取当前目标的进度
		var 目标占比:float=1.0# 计算当前目标的进度占比,默认1
		if not 任务本地["目标完成标记"][i] and 当前进度 < 目标值:#任务条件标记为真 优先
			目标占比 = 1.0*当前进度 / 目标值  # 未完成，按比例计算
		完成总进度+=目标占比
	return 完成总进度

##手工系统的合成物品完成会调用此方法
func 更新检查(本次更新任务:Array[任务资源]) -> void:
	if 本次更新任务.size() > 0:# 8. 发送更新信号（仅刷新有变化的任务）
		for 任务数据:任务资源 in 本次更新任务:
			var 任务完成度=任务数据.任务本地.完成总进度
			var 任务目标列表=任务数据.任务本地.任务目标列表
			if 任务完成度==任务目标列表.size():
				var 任务来源=任务数据.任务类型
				if 任务来源=="循环":
					计划.语法糖通知("<"+任务数据.任务名称+">任务 以完成")
				else :
					计划.语法糖强调通知("<"+任务数据.任务名称+">任务 以完成",任务数据.任务名称,完成任务跳转逻辑.bind(任务数据.任务名称)
					,获取处理样式("原罪_傲慢界面")if 任务来源=="成就"else 获取处理样式("任务窗口"))
		任务更新.emit(本次更新任务)
func 完成任务跳转逻辑(任务名称):
	var 任务来源=任务字典[任务名称].get("来源","其他")
	if 任务来源=="成就":
		计划.steam.解锁成就(任务名称)
		计划.切换场景("原罪_傲慢界面",true)
	else :
		if ["作者","挂机","其他"].has(任务来源):
			计划.窗口状态管理("任务界面", "标签", null, "主线任务")
		else :
			计划.窗口状态管理("任务界面", "标签", null, "支线任务")
			计划.窗口状态管理("任务界面", "支线任务", null, 任务来源)
		计划.切换场景("任务窗口",true)
func 获取处理样式(类型="任务窗口"):
	var 纹理地址:String=计划.窗口.窗口数据[类型].贴图
	if not 纹理地址=="":
		return "[img=50x50]%s[/img]"%纹理地址
	else :return "[b]<跳转>[/b]"
#enum 进度类型 {无进度,计时,合成,研究,炼金,烹饪,订单,预制,消费}
##计划.任务.任务通用(计划.任务.进度类型.无进度,1,"")
func 任务通用(进度:进度类型,推进进度:float,目标参数:String="",额外参数:Dictionary={}) -> void:
	var 剩余数量:float=推进进度
	if 剩余数量 <= 0:return#有效输入
	var 本次更新任务:Array[任务资源] = []  # 需刷新的任务列表
	for 任务项:Array in 缓存任务[进度]:# 解析任务项：[任务资源, 条件序号]
		var 任务数据: 任务资源 = 任务项[0]
		if 剩余数量 <= 0 and 任务数据.消耗次数:continue#剩余次数不足时跳过需要消耗次数的任务
		var 条件序号: int = 任务项[1]
		if not 检查任务有效性(任务数据, 条件序号):continue#检查格式
		var 任务条件: Dictionary = 任务数据.任务本地["任务目标列表"][条件序号]
		var 白名单: Array = 任务条件["白名单"]
		if not 白名单==[] and not 白名单.has(目标参数):continue#白名单检查
		var 限制标签: Array = 任务条件["限制标签"]
		if not 限制标签.is_empty():
			match 进度:
				进度类型.合成,进度类型.烹饪,进度类型.订单:#这类任务传入的目标参数表示物品名称
					print(目标参数,"/",限制标签,计划.表格.蓝图标签检查(目标参数,限制标签))
					if not 计划.表格.蓝图标签检查(目标参数,限制标签):continue
				进度类型.研究:
					if not 限制标签.has(额外参数.get("方向","其他")):continue
				进度类型.预制:
					if not 限制标签.has(额外参数.get("工序","其他")):continue
				进度类型.炼金:
					if not 限制标签.has(额外参数.get("催化剂","其他")):continue
				_:print("错误,%d该类型标签功能不可用"%进度)
		if 任务数据.消耗次数:
			var 实际消耗: int = 更新任务进度(任务数据, 条件序号, 剩余数量)# 6. 更新进度,并扣除数量
			剩余数量 -= 实际消耗
		else :更新任务进度(任务数据,条件序号,推进进度)#仅更新进度
		if 任务数据 not in 本次更新任务:本次更新任务.append(任务数据)# 7. 记录需刷新的任务（去重）
	更新检查(本次更新任务)
## 返回实际的进度(并执行更新任务数据)
func 更新任务进度(任务数据:任务资源, 条件序号:int, 可分配量:float):
	#print(任务数据.任务名称,"更新+",可分配量)
	var 任务本地:=任务数据.任务本地
	var 当前进度: int = 任务本地["当前进度列表"][条件序号]
	var 目标值: int = 任务本地["任务目标列表"][条件序号]["目标值"]
	var 可增加量:float = min(可分配量, max(0, 目标值 - 当前进度))# 计算最大可增加量（不超过目标差值，且不超过可分配量）
	if 可增加量 > 0:# 仅在有增量时更新进度
		任务本地["当前进度列表"][条件序号] += 可增加量
		任务本地["完成总进度"]=返回完成度(任务本地)
		任务数据.任务数据=任务本地["当前进度列表"]#导出存档
	if 任务本地["当前进度列表"][条件序号] >= 目标值:# 检查并更新完成标记
		任务本地["目标完成标记"][条件序号] = true
	if not 任务数据.任务类型=="循环":#导出存档
		if not 打包数据.进行中任务.has(任务数据):
			打包数据.进行中任务.append(任务数据)
	return 可增加量
##检查第X项是否可以正常读取
func 检查任务有效性(任务数据:任务资源, 条件序号:int) -> bool:
	if not 任务数据:return false#任务类型错误
	var 来源=任务数据.任务类型
	if 来源=="成就":
		pass
	elif not 任务数据.任务状态:
		return false#任务未领取,无效
	var 任务本地:Dictionary = 任务数据.任务本地
	if 任务本地.has("任务目标列表") and 条件序号 < 0 or 条件序号 >= 任务本地["任务目标列表"].size():
		return false# 2. 条件序号越界（小于0或超出目标列表长度）→ 无效
	if 任务本地["目标完成标记"][条件序号]:#跳过已完成的任务
		return false
	return true
func 清理无效项():
	for 缓存类型:进度类型 in 缓存任务:
		var 待删除元素:Array=[]
		for 任务项 in 缓存任务[缓存类型]:
			if not 任务项 is Array or 任务项.size()!=2:
				待删除元素.append(任务项)
				continue
			if not 任务项[0] or not 任务项[0] is 任务资源:
				待删除元素.append(任务项)
				continue
		for 删除元素 in 待删除元素:
			缓存任务[缓存类型].erase(删除元素)
