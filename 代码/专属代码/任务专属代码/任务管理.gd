func _ready() -> void:
	if not 计划.梅存档.挂机.has("任务") or not 计划.梅存档.挂机.任务 is 任务打包资源:
		计划.梅存档.挂机["任务"]=任务打包资源.new()
	打包数据=计划.梅存档.挂机.任务
	打包数据.初始化()
	当前任务数据=[]
	for 数据 in 打包数据.进行中任务:
		if 数据 is 任务资源:
			当前任务数据.append(数据)
			if not 数据.任务类型=="循环":
				唯一任务字典[数据.任务名称]=数据
	for 任务名称 in 任务字典:
		if not 唯一任务字典.has(任务名称):
			var 任务来源=任务字典[任务名称].get("来源","循环")
			if not 任务来源=="循环":
				var 任务资源数据:任务资源=任务资源.new(任务名称)
				if 打包数据.已完成任务.has(任务名称):
					任务资源数据.任务完成=true
				唯一任务字典[任务名称]=任务资源数据
				当前任务数据.append(任务资源数据)
	for 类型 in 进度类型:
		缓存任务[进度类型[类型]]=[]
		进度类型映射[进度类型[类型]]=类型
	for 任务数据:任务资源 in 当前任务数据:
		if 任务字典.has(任务数据.任务名称):
			任务数据.当前任务数据=任务字典[任务数据.任务名称]
		任务数据.初始化(打包数据)
	var 成就:=筛选任务来源资源("成就")
	var 成就名:=筛选任务来源("成就")
	var 存档数据=计划.梅存档["挂机"].get("成就",{})
	if not 存档数据 is Dictionary:
		存档数据={}
	计划.steam.读取成就(成就名,任务字典,存档数据)
	计划.steam.读取成就验证(成就)
	任务全局={}
	任务全局更新(true)
	结算任务完成()
