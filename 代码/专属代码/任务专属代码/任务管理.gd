func _ready() -> void:
	初始化任务全局字典()
	结算任务完成()
func 初始化任务全局字典() -> void:
	任务全局={}
	for 主容器名 in 任务字典:
		for 子容器名 in 任务字典[主容器名]:
			var 条件数组=任务字典[主容器名][子容器名].get("前置条件",[])
			if not 计划.梅存档["挂机"].get("任务进度",{}).get(子容器名,0)==1 and not 条件数组==[] and 检查前置任务(任务字典[主容器名][子容器名]):
				追加全局字典任务(条件数组,子容器名)
			计划.红点.红点字典["任务_"+子容器名]=func():return 任务检查(主容器名,子容器名)
func 任务全局更新():
	for 主容器名 in 任务字典:
		for 子容器名 in 任务字典[主容器名]:
			var 条件数组=任务字典[主容器名][子容器名].get("前置条件",[])
			if 计划.梅存档["挂机"].get("任务进度",{}).get(子容器名,0)==1:
				任务字典.erase(子容器名)
				if 计划.梅存档["挂机"].has("任务数据"):
					计划.梅存档["挂机"]["任务数据"].erase(子容器名)
			elif not 条件数组==[] and 检查前置任务(任务字典[主容器名][子容器名]):
				追加全局字典任务(条件数组,子容器名)
func 任务检查(任务类型,任务名称):
	if 计划.梅存档["挂机"].get("任务进度",{}).get(任务名称,0)==1:
		return 0
	if not 检查前置任务(任务字典[任务类型][任务名称]):
		return 0
	if 计划.红点.红点数据.has("任务_"+任务名称) and not 计划.红点.红点数据["任务_"+任务名称]==0:
		return 0
	#print("可完成任务",任务名称,检查前置任务(任务字典[任务类型][任务名称]))
	return 1
func 检查前置任务(任务数据)->bool:
	var 前置任务=任务数据.get("前置任务",[])
	var 任务数量=前置任务.size()
	var 任务完成量=0
	for 条件 in 前置任务:
		var 前置剧情进度=计划.梅存档["挂机"].get("任务进度",{}).get(条件,0)
		if 前置剧情进度==1:
			任务完成量+=1
	return 任务完成量==任务数量
func 追加全局字典任务(条件数组:Array,任务名称:String):
	var 任务目标列表:Array=[]#1.构建任务目标列表
	var 当前进度列表:Array=[]#2.构建当前进度列表（从存档读取）
	var 该任务存档:Array=计划.梅存档["挂机"].get("任务数据",{}).get(任务名称,[])
	var 缓存合成任务=[]
	var 缓存预制任务=[]
	var 缓存在线任务=[]
	var 缓存研究任务=[]
	#print("该任务存档",该任务存档)
	for i in range(条件数组.size()):
		var 条件=条件数组[i]
		var 类型=条件.get("类型","")
		if 类型=="合成":
			缓存合成任务+=[[任务名称,i]]#仅在整个任务都正确解析才能存入"合成任务"数组
		elif 类型=="预制":
			缓存预制任务+=[[任务名称,i]]#同理
		elif 类型=="在线":
			缓存在线任务+=[[任务名称,i]]#同理
		elif 类型=="研究":
			缓存研究任务+=[[任务名称,i]]#同理
		else :
			任务目标列表=[]
			break#非法结果跳出循环,并撤回缓存
		任务目标列表.append({
			"条件类型":类型,
			"目标对象":条件.get("限制类型",[]),
			"目标标签":条件.get("限制标签",[]),
			"目标值":max(1,int(条件.get("目标值",1)))})
		var 存档进度:int=int(该任务存档[i] if i < 该任务存档.size() else 0)
		当前进度列表.append(存档进度)
	if 任务目标列表==[]:
		print("[b]任务[/b]:",任务名称,"/r存在非法类型参数:",条件数组)
		return#非法结果跳出循环,打印日志放弃当前任务.
	合成任务+=缓存合成任务
	预制任务+=缓存预制任务
	在线任务+=缓存在线任务
	研究任务+=缓存研究任务
	var 目标完成标记:Array=[]#3.构建目标完成标记
	var 完成总进度=0
	for i in range(任务目标列表.size()):
		var 目标值:int=任务目标列表[i]["目标值"]
		var 当前进度:int=当前进度列表[i]  # 获取当前目标的进度
		var 目标占比:float=1.0# 计算当前目标的进度占比,默认1
		if not 当前进度 >= 目标值:
			目标占比 = 1.0*当前进度 / 目标值  # 未完成，按比例计算
		完成总进度+=目标占比
		目标完成标记.append(当前进度>=目标值)
	任务全局[任务名称]={#赋值到任务全局字典
		"任务目标列表":任务目标列表,
		"完成总进度":完成总进度,
		"当前进度列表":当前进度列表,
		"目标完成标记":目标完成标记}
func 结算任务完成():
	var 缓存资源每秒 = {"木材": 1, "矿石": 1, "皮革": 1, "药草": 1}
	var 叠加次数 = 完成任务计数("手工")
	if 叠加次数 > 0:
		var 总增加量 = 叠加次数 * 0.1  # 总增加量 = 次数 × 0.1
		for 资源名 in 缓存资源每秒:# 遍历字典，给每个资源值加上总增加量
			缓存资源每秒[资源名] += 总增加量
	计划.基础资源每秒=缓存资源每秒
func 完成任务计数(任务)->int:
	var 完成次数 = 0  # 统计满足条件的任务数量
	var 任务进度 = 计划.梅存档["挂机"].get("任务进度",{})
	for 任务名 in 任务字典[任务]:
		if 任务进度.get(任务名,0)==1:
			完成次数 += 1  # 每满足一个，次数+1
	return 完成次数
## 公共方法：检查任务+条件序号是否有效（所有任务通用）
func 检查任务有效性(任务名称:String, 条件序号:int) -> bool:
	if 任务名称 not in 任务全局:
		return false# 1. 任务不在全局字典 → 无效
	var 任务数据:Dictionary = 任务全局[任务名称]
	if 条件序号 < 0 or 条件序号 >= 任务数据["任务目标列表"].size():
		return false# 2. 条件序号越界（小于0或超出目标列表长度）→ 无效
	return true
## 返回更新后任务总进度
func 返回完成度(任务数据:Dictionary)-> float:
	var 完成总进度=0
	var 任务目标列表=任务数据["任务目标列表"]
	var 当前进度列表=任务数据["当前进度列表"]
	for i in range(任务目标列表.size()):
		var 目标值:int=任务目标列表[i]["目标值"]
		var 当前进度:int=当前进度列表[i]  # 获取当前目标的进度
		var 目标占比:float=1.0# 计算当前目标的进度占比,默认1
		if not 任务数据["目标完成标记"][i] and 当前进度 < 目标值:#任务条件标记为真 优先
			目标占比 = 1.0*当前进度 / 目标值  # 未完成，按比例计算
		完成总进度+=目标占比
	return 完成总进度
## 返回实际的进度(并执行更新任务数据)
func 更新任务进度(任务数据:Dictionary, 条件序号:int, 可分配量:int,任务名称:String) -> int:
	var 当前进度: int = 任务数据["当前进度列表"][条件序号]
	var 目标值: int = 任务数据["任务目标列表"][条件序号]["目标值"]
	var 可增加量: int = min(可分配量, max(0, 目标值 - 当前进度))# 计算最大可增加量（不超过目标差值，且不超过可分配量）
	if 可增加量 > 0:# 仅在有增量时更新进度
		任务数据["当前进度列表"][条件序号] += 可增加量
		任务数据["完成总进度"]=返回完成度(任务数据)
		if not 计划.梅存档["挂机"].has("任务数据"):
			计划.梅存档["挂机"]["任务数据"]={}
		计划.梅存档["挂机"]["任务数据"][任务名称]=任务数据["当前进度列表"]
	if 任务数据["当前进度列表"][条件序号] >= 目标值:# 检查并更新完成标记
		任务数据["目标完成标记"][条件序号] = true
	return 可增加量

##手工系统的合成物品完成会调用此方法
func 更新检查(本次更新任务) -> void:
	if 本次更新任务.size() > 0:# 8. 发送更新信号（仅刷新有变化的任务）
		for 任务名称 in 本次更新任务:
			var 任务完成度=任务全局[任务名称].get("完成总进度",0)
			var 任务目标列表=任务全局[任务名称].get("任务目标列表",[])
			if 任务完成度==任务目标列表.size():
				计划.语法糖强调通知("<"+任务名称+">任务 以完成",任务名称,func():计划.切换场景(null,"任务窗口"),获取处理样式())
		计划.emit_signal("任务更新", 本次更新任务)
func 获取处理样式():
	var 纹理地址=计划.窗口.界面路径映射["任务窗口"]
	if 纹理地址.size()>=1:return "[img=50x50]%s[/img]"%纹理地址[1]
	else :return "[b]<跳转>[/b]"
##手工系统的合成物品完成会调用此方法
func 完成任务合成(物品名称:String, 数量:int) -> void:
	#print("物品名称",物品名称,"*",数量)
	if 数量 <= 0:# 1. 输入有效性校验（数量必须为正）
		return
	var 剩余数量: int = 数量  # 剩余可分配的合成数量
	var 本次更新任务: Array = []  # 需刷新的任务列表（去重）
	for 任务项 in 合成任务:# 2. 遍历合成任务数组（按优先级处理）
		if 剩余数量 <= 0:
			break# 退出条件：剩余数量已分配完
		var 任务名称: String = 任务项[0]# 解析任务项：[任务名称, 条件序号]
		var 条件序号: int = 任务项[1]
		if not 检查任务有效性(任务名称, 条件序号):# 3. 基础有效性检查（调用公共方法）
			continue
		var 任务数据: Dictionary = 任务全局[任务名称]
		if 任务数据["目标完成标记"][条件序号]:#跳过已完成的任务
			continue
		var 目标对象: Array = 任务数据["任务目标列表"][条件序号]["目标对象"]
		if not (目标对象==[] or 物品名称 in 目标对象):# 5. 白名单检查（目标为空=不限制，否则需匹配物品）
			continue
		var 目标标签: Array = 任务数据["任务目标列表"][条件序号]["目标标签"]
		if not 目标标签==[]:
			var 物品标签=计划.表格.缓存蓝图标签[物品名称]
			if not 物品标签 in 目标标签:
				continue
		var 实际消耗: int = 更新任务进度(任务数据, 条件序号, 剩余数量,任务名称)# 6. 更新进度,并扣除数量
		if 任务名称 not in 本次更新任务:# 7. 记录需刷新的任务（去重）
			本次更新任务.append(任务名称)
		剩余数量 -= 实际消耗
	更新检查(本次更新任务)
