func 任务创建():
	if not 检查循环任务过期():
		生成循环任务()
	生成订单任务()
	#breakpoint#断点
func 检查循环任务过期()->bool:
	var 当前时间:=Time.get_unix_time_from_system()
	var 需要删除的任务:Array=[]
	for 任务数据:任务资源 in 当前任务数据:
		if 任务数据.任务类型=="循环":
			if 当前时间+1>=任务数据.时限 and not 任务数据.任务状态:
				需要删除的任务.append(任务数据)
	if 需要删除的任务.size()>=1:
		for 任务数据:任务资源 in 需要删除的任务:
			任务数据.删除任务方法()
		生成循环任务()
	return 需要删除的任务.size()>=1
func 生成循环任务():
	var 任务数量:int=打包数据.循环任务数量
	var 循环任务:int=0
	for 任务数据 in 当前任务数据:
		if 任务数据.任务类型=="循环":
			循环任务+=1
	for i in 任务数量-循环任务:
		创建循环任务()
	清理无效项()
	更新_任务UI.emit()
func 生成订单任务():
	var 任务数量:int=打包数据.订单任务数量
	for i in 任务数量-打包数据.订单任务.size():
		var 订单:梅订单数据=梅订单数据.new()
		订单.打包数据=打包数据
		订单.生成订单数据()
		打包数据.订单任务.append(订单)
		
func 创建循环任务(任务类型:进度类型=进度类型.无进度):
	if 任务类型==进度类型.无进度:
		var 可用类型:Array[进度类型]=[]
		for 类型 in 任务模板.任务类型:
			if 任务模板.任务类型[类型].call():
				可用类型.append(类型)
		if 可用类型.size()<=0:
			print("错误,找不到可用任务类型")
			return
		任务类型=可用类型[randi()%(可用类型.size())]
	var 可用任务类:Array=[]
	var 当前模板:Dictionary=任务模板[任务类型]
	for 任务类 in 当前模板:
		if not 当前模板[任务类].has("检查") or 当前模板[任务类].检查.call():
			可用任务类.append(任务类)
	if 可用任务类.size()<=0:
		print("错误,%d.任务,没有可用任务"%[任务类型])
		return
	var 任务名称:String=可用任务类[randi()%(可用任务类.size())]
	var 模板:Dictionary=当前模板[任务名称]
	var 文本模板组:Array=模板.模板
	var 任务数量:int=randi_range(模板.数量.x,int((0.8+0.2*打包数据.循环任务难度)*模板.数量.y))
	var 数据:Dictionary=任务模板.通用模板
	#var 运气:float=randf()
	var 奖励字典:Dictionary={}
	for 奖励数据 in 模板.奖励:
		var 奖励名:String=""
		if 奖励数据 is String:
			奖励名=奖励数据
		elif 奖励数据 is Array and 奖励数据.size()>=1:
			奖励数据.shuffle()
			奖励名=奖励数据[0]
		if 奖励名=="":
			continue
		var 取值范围:Vector2=模板.奖励[奖励数据]
		var 最终数量:int=int(randf_range(取值范围.x,取值范围.y)*任务数量)
		if 最终数量>=1:
			奖励字典[奖励名]=最终数量
	数据["任务描述"]=["[b]任务[/b]:{计时}",
			"消耗10体力刷新",
			文本模板组[0]%[任务数量],
			"[b]奖励[/b]:当前进度: {当前进度}\n{奖励字典}"]
	数据["奖励方法"]=奖励字典
	var 前置条件:Dictionary={"类型":任务类型, "目标值":任务数量, "条件名称": "任务条件"}
	if 模板.has("标签"):
		前置条件["限制标签"]=[模板.标签]
	if 模板.has("白名单"):
		前置条件["白名单"]=[模板.白名单]
	数据["前置条件"]=[前置条件]
	var 新任务:任务资源=任务资源.new(任务名称,数据)
	新任务.初始化(打包数据)
	追加全局字典任务(新任务)
	当前任务数据.append(新任务)
	打包数据.进行中任务.append(新任务)
