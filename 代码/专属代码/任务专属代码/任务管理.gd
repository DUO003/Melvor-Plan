var 来源缓存:Dictionary={}
func 筛选任务来源(任务)->Array:
	var 来源数组:Array=[]
	if 来源缓存.has(任务):
		来源数组=来源缓存[任务]
	else :
		for 任务名 in 任务字典:
			if 任务字典[任务名].has("来源") and 任务字典[任务名]["来源"]==任务:
				来源数组.append(任务名)
		来源缓存[任务]=来源数组
	return 来源数组
func 完成任务计数(任务)->int:
	var 来源数组:Array=筛选任务来源(任务)
	var 完成次数 = 0  # 统计满足条件的任务数量
	for 任务名 in 来源数组:
		if 唯一任务字典.has(任务名) and 唯一任务字典[任务名].任务完成:
			完成次数 += 1  # 每满足一个，次数+1
	return 完成次数
## 公共方法：检查任务+条件序号是否有效（所有任务通用）
func 检查任务有效性(任务名称:String, 条件序号:int) -> bool:
	if 任务名称 not in 任务全局:
		return false# 1. 任务不在全局字典 → 无效
	var 来源=任务字典[任务名称].get("来源","循环")
	if 来源=="成就":
		pass
	elif not 唯一任务字典.has(任务名称) or 唯一任务字典[任务名称].任务状态:
		return false#任务未领取,无效
	var 任务数据:Dictionary = 任务全局[任务名称]
	if 条件序号 < 0 or 条件序号 >= 任务数据["任务目标列表"].size():
		return false# 2. 条件序号越界（小于0或超出目标列表长度）→ 无效
	return true
## 返回更新后任务总进度
func 返回完成度(任务数据:Dictionary)-> float:
	var 完成总进度=0
	var 任务目标列表=任务数据["任务目标列表"]
	var 当前进度列表=任务数据["当前进度列表"]
	for i in range(任务目标列表.size()):
		var 目标值:int=任务目标列表[i]["目标值"]
		var 当前进度:int=当前进度列表[i]  # 获取当前目标的进度
		var 目标占比:float=1.0# 计算当前目标的进度占比,默认1
		if not 任务数据["目标完成标记"][i] and 当前进度 < 目标值:#任务条件标记为真 优先
			目标占比 = 1.0*当前进度 / 目标值  # 未完成，按比例计算
		完成总进度+=目标占比
	return 完成总进度
## 返回实际的进度(并执行更新任务数据)
func 更新任务进度(任务数据:Dictionary, 条件序号:int, 可分配量,任务名称:String):
	var 当前进度: int = 任务数据["当前进度列表"][条件序号]
	var 目标值: int = 任务数据["任务目标列表"][条件序号]["目标值"]
	var 可增加量 = min(可分配量, max(0, 目标值 - 当前进度))# 计算最大可增加量（不超过目标差值，且不超过可分配量）
	if 可增加量 > 0:# 仅在有增量时更新进度
		任务数据["当前进度列表"][条件序号] += 可增加量
		任务数据["完成总进度"]=返回完成度(任务数据)
		if 唯一任务字典.has(任务名称):
			唯一任务字典[任务名称].任务数据=任务数据["当前进度列表"]
		else :
			print("错误或循环任务")
	if 任务数据["当前进度列表"][条件序号] >= 目标值:# 检查并更新完成标记
		任务数据["目标完成标记"][条件序号] = true
	return 可增加量

