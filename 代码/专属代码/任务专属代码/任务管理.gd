func 任务红点检查(任务名称:String):
	if 唯一任务字典[任务名称].任务完成:
		return 0
	var 来源=任务字典[任务名称].get("来源","循环")
	if 来源=="循环" or 来源=="成就":
		return 0
	elif 唯一任务字典.has(任务名称) and 唯一任务字典[任务名称].任务状态:
		return 0
	if not 检查前置任务(任务名称):
		return 0
	if 计划.红点.红点数据.has("任务_"+任务名称) and not 计划.红点.红点数据["任务_"+任务名称]==0:
		return 0
	return 1
func 检查前置任务(任务名称:String)->bool:
	return 统计未完成前置任务(任务名称).size()==0
func 统计未完成前置任务(任务名称:String)->Array:
	var 前置任务=任务字典[任务名称].get("前置任务",[])
	var 未完成:Array=[]
	for 条件 in 前置任务:
		if 唯一任务字典.has(条件):
			if not 唯一任务字典[条件].任务完成:
				未完成.append(条件)
	return 未完成

func 追加全局字典任务(条件数组:Array,任务名称:String):
	var 任务目标列表:Array=[]#1.构建任务目标列表
	var 当前进度列表:Array=[]#2.构建当前进度列表（从存档读取）
	var 该任务存档:Array=唯一任务字典[任务名称].任务数据
	var 缓存任务数据={}
	for i in range(条件数组.size()):
		var 条件:Dictionary=条件数组[i]
		if 条件.has("类型"):
			var 类型:进度类型=条件["类型"]
			if not 缓存任务数据.has(类型):
				缓存任务数据[类型]=[]
			缓存任务数据[类型].append([任务名称,i])
			任务目标列表.append({
				"条件类型":类型,
				"目标对象":条件.get("限制类型",[]),
				"目标标签":条件.get("限制标签",[]),
				"目标值":max(1,int(条件.get("目标值",1)))})
			var 存档进度:int=int(该任务存档[i] if i < 该任务存档.size() else 0)
			当前进度列表.append(存档进度)
		else :
			print("[b]任务[/b]:",任务名称,"/r存在非法类型参数:",条件数组)
			return#非法结果跳出循环,打印日志放弃当前任务.
	for 任务数据:进度类型 in 缓存任务数据:
		if not 缓存任务.has(任务数据):
			缓存任务[任务数据]=[]
		缓存任务[任务数据]+=缓存任务数据[任务数据]
	var 目标完成标记:Array=[]#3.构建目标完成标记
	var 完成总进度=0
	for i in range(任务目标列表.size()):
		var 目标值:int=任务目标列表[i]["目标值"]
		var 当前进度:int=当前进度列表[i]  # 获取当前目标的进度
		var 目标占比:float=1.0# 计算当前目标的进度占比,默认1
		if not 当前进度 >= 目标值:
			目标占比 = 1.0*当前进度 / 目标值  # 未完成，按比例计算
		完成总进度+=目标占比
		目标完成标记.append(当前进度>=目标值)
	任务全局[任务名称]={#赋值到任务全局字典
		"任务目标列表":任务目标列表,
		"完成总进度":完成总进度,
		"当前进度列表":当前进度列表,
		"目标完成标记":目标完成标记}
