extends Resource
class_name 任务打包资源
##包含循环任务.
@export var 进行中任务:Array[任务资源]=[]
##仅储存名称
@export var 已完成任务:Array[String]=[]
##仅储存类型+任务积分
@export var 已完成循环任务:int=0
##刷新几个循环任务
@export var 循环任务数量:int=1
##刷新几个循环任务
@export var 循环任务难度:int=0
##储存订单的数据
@export var 订单任务:Array[梅订单数据]=[]
##刷新几个订单任务
@export var 订单任务数量:int=1
##只有获得过的物品才会加入到记录,基础材料例外
@export var 获得物品记录:Dictionary[String,int]={"铁锭":0,"纤维":0,"鞣革":0,"麻布":0}
##刷新订单任务的类型
@export var 订单解锁标签:Array=["材料"]
##在这里添加可以作为随机条件的标签
var 标签白名单:Array=["工具","宝石","符文","材料","炼金","食材","药水"]
func 可用标签()->Array:
	var 交集结果: Array = []
	for 元素 in 标签白名单: # 遍历数组A的每个元素
		if 元素 in 订单解锁标签 and 元素 not in 交集结果:
			交集结果.append(元素)
	return 交集结果
func 返回翻译标签()->Array:
	var 翻译标签:=[]
	for 标签 in 订单解锁标签:
		翻译标签.append(tr(标签))
	return 翻译标签
##每次获得物品时尝试增加记录
func 增加记录(物品名称:String,数量:int):
	if 数量 <= 0:
		if not 数量 == 0:
			print("错误数量小于0记录失败_%s数量:%d"%[物品名称,数量])
		return
	var 当前数量:int=获得物品记录.get(物品名称,0)
	if 当前数量==0:
		var 标签字典:Dictionary=计划.表格.缓存蓝图标签
		if 标签字典.has(物品名称):
			var 标签数组:=标签字典[物品名称] as PackedStringArray
			for 标签:String in 标签数组:
				if 订单解锁标签.has(标签):
					continue#判断标签是否在黑名单或已解锁
				订单解锁标签.append(标签)
	获得物品记录[物品名称]=clampi(当前数量+数量,当前数量,9223372036854775807)#防护,避免整数溢出
## 根据标签筛选已获得的物品名称，返回符合条件的物品数组
## 输入参数：标签 - 要匹配的标签字符串
## 返回值：Array[String] - 符合标签的已获得物品名称数组
func 根据标签获取已获得物品(标签:String)->Array[String]:
	# 初始化结果数组，确保返回值始终为数组类型
	var 符合条件的物品数组:Array[String] = []
	# 1. 校验输入标签有效性，避免空标签筛选
	if 标签.is_empty():
		print("错误：输入的筛选标签为空字符串，无法执行筛选")
		return 符合条件的物品数组
	# 2. 校验物品记录是否为空，避免无效遍历
	if 获得物品记录.is_empty():
		print("提示：获得物品记录为空，暂无已获得物品可筛选")
		return 符合条件的物品数组
	# 3. 核心逻辑：遍历所有已获得物品，匹配标签
	for 物品名称:String in 获得物品记录:
		if 计划.表格.蓝图标签检查(物品名称, 标签):
			符合条件的物品数组.append(物品名称)
	# 返回最终筛选结果
	return 符合条件的物品数组
##初始化方法：[br]
##1.清理存档中残留的非法标签并去重
##2.给内部订单资源初始化(任务由任务管理器另外处理)
func 初始化():
	# 创建临时数组存储合法且不重复的标签
	var 合法标签数组:Array = []
	# 遍历原有订单解锁标签，过滤非法标签并去重
	for 标签 in 订单解锁标签:
		# 排除黑名单标签 + 确保标签不重复
		if not 合法标签数组.has(标签):
			合法标签数组.append(标签)
	订单解锁标签 = 合法标签数组
	for 订单数据:梅订单数据 in 订单任务:
		订单数据.打包数据=self
		if 订单数据.名称=="":
			if 订单数据.时限==-1:#筛选生成失败的订单
				订单数据.生成订单数据()
		
