func 更新检查方法(属性列表,等级,默认,增长):
	for 属性名 in 属性列表:
		# 错误检查：验证挂机默认/增长字典中是否存在当前属性
		if not 默认.has(属性名):
			push_error("挂机默认字典缺少属性：", 属性名)
			continue
		if not 增长.has(属性名):
			push_error("挂机增长字典缺少属性：", 属性名)
			continue
		var 基础值:float = 默认[属性名] + 等级 * 增长[属性名]# 计算基础属性值
		set(属性名, 基础值)
		#print("更新%s:%d"%[属性名, 基础值])
	#print(属性列表,等级,默认,增长)
	for 装备:物品装备 in 装备来源栏:
		if not 装备:
			print("装备来源栏中存在无效装备实例，已跳过")
			continue
		var 加成倍率:float=装备来源栏[装备].倍率()
		var 基础属性 = 装备.基础属性
		if not 基础属性 is Dictionary:
			print("装备", 装备, "的基础属性不是字典类型，已跳过")
			continue
		for 属性名 in 属性列表:
			if 基础属性.has(属性名):
				var 属性值:float = float(基础属性[属性名])
				var 当前值:float = get(属性名)
				set(属性名, 当前值 + 属性值 * 加成倍率)
