func 更新游历数据():
	var 等级:int=max(0,计划.数据系统("游历"))
	攻速=游历默认.默认攻速
	攻击距离=游历默认.默认攻击距离
	var 承受伤害比例 = 1.0 - (游历默认.默认减伤 / 1.0)
	var 增加攻击:float=0.0
	var 攻击乘数:float=0.0
	var 增加血量:float=0.0
	var 血量乘数:float=1.0
	var 增加魔法:float=0.0
	var 魔法乘数:float=1.0
	for 装备:物品装备 in 装备来源栏:
		var 加成倍率:float=装备来源栏[装备].倍率()
		if 装备.通用检查("魔法"):
			魔法乘数+=装备.基础数值[装备.类型].魔法
		if 装备.通用检查("血量"):
			血量乘数+=装备.基础数值[装备.类型].血量
		if 装备.通用检查("攻击"):
			攻击乘数+=装备.基础数值[装备.类型].攻击
		if 装备.分类 == "武器" and 装备.通用检查("攻速") and 装备.通用检查("攻击距离"):#合法情况下仅有一件武器直接设置
			攻速=游历默认.默认攻速*装备.基础数值[装备.类型].攻速
			攻击距离=int(游历默认.默认攻击距离*装备.基础数值[装备.类型].攻击距离)
		elif 装备.分类 == "护甲" and 装备.通用检查("减伤"):
			var 装备减伤 = clamp(装备.基础数值[装备.类型].减伤, 0.0, 1.0)
			承受伤害比例 *= (1.0 - 装备减伤) / 1.0
		var 基础属性=装备.基础属性
		for 属性名 in 基础属性:
			if 属性名=="攻击力":
				增加攻击+=基础属性[属性名]*加成倍率
			if 属性名=="血量力":
				增加血量+=基础属性[属性名]*加成倍率
			if 属性名=="魔法力":
				增加魔法+=基础属性[属性名]*加成倍率
	血量 = (游历默认.血量+int(等级*游历增长.血量)+增加血量)*max(1.0,血量乘数)
	攻击 = (游历默认.攻击+int(等级*游历增长.攻击)+增加攻击)*max(0.5,攻击乘数)#如果没有装备空手倍率0.5
	魔法 = (游历默认.魔法+int(等级*游历增长.魔法)+增加魔法)*max(0.0,魔法乘数)#如果没有装备空手倍率0
	减伤 = min(0.8,1.0 - 承受伤害比例)
func 战力文本更新(系统="游历") -> Array:
	更新属性(系统)
	var 等级:int = 计划.数据系统(系统)
	var 文本数组:Array = []
	文本数组.append("%s等级:%d" % [系统, 等级])
	文本数组.append("精通:%.0f" % [精通力])
	match 系统:
		"手工":
			文本数组.append("懒惰:%.0f" % [懒惰力])
			文本数组.append("制作:%.0f" % [制作力])
			文本数组.append("研究:%.0f" % [研究力])
			文本数组.append("炼金:%.0f" % [炼金力])
			文本数组.append("烹饪:%.0f" % [烹饪力])
		"游历":
			文本数组.append("血量:%d" % [血量])
			文本数组.append("魔法:%d" % [魔法])
			文本数组.append("攻击:%d" % [攻击])
			文本数组.append("距离%.0f" % [攻击距离])
			文本数组.append("攻速:%.1f秒" % [攻速])
			文本数组.append("减伤:%.0f%%" % [减伤*100])
			文本数组.append("暴怒:%.0f" % [暴怒力])
		_:pass
	return 文本数组
func 战力文本详情(系统) -> String:
	更新属性(系统)
	var 文本数组:Array = []
	文本数组.append("所有系统精通上限+%d" % [100*精通力])
	match 系统:
		"手工":
			var 阶级=计划.数据系统("手工","阶级")
			var 保留比例:float=懒惰力/(800+懒惰力)
			文本数组.append("懒惰上限+%d,保留%.1f%%" % [20*懒惰力,保留比例*100])
			文本数组.append("%s手工系统离线时长120+%d分钟" % [系统,制作力])
			if 制作力>=阶级*(阶级+1):
				阶级+=1
				文本数组.append("%s已解锁T%d配方" % [系统, 阶级])
			else :
				文本数组.append("%s需要%d制作提前解锁T%d配方" % [系统,阶级*(阶级+1), 阶级+1])
			文本数组.append("研究:%d开发中,图纸碎片" % [研究力])
			文本数组.append("炼金:%d贤者点数超额部分按0.75次方结算" % [炼金力])
			文本数组.append("烹饪 快速反应事件增益%.0f%%" % [(100*(烹饪力+100)/(烹饪力+500))])
		"游历":
			文本数组.append("血量:%d" % [血量])
			文本数组.append("魔法:%d" % [魔法])
			文本数组.append("攻击:%d" % [攻击])
			文本数组.append("距离%.0f" % [攻击距离])
			文本数组.append("攻速:%.1f秒" % [攻速])
			文本数组.append("减伤:%.0f%%" % [减伤*100])
			文本数组.append("暴怒:%.0f" % [暴怒力])
		_:pass
	return "\r".join(文本数组)
func 安全访问(变量,默认值=0):
	var 缓存值=get(变量)
	if 缓存值 == null:
		return 默认值# 如果找不到变量，返回默认值
	if 缓存值 is float or 缓存值 is int:
		return 缓存值
	return 默认值
