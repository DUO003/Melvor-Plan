## 安全检查合成制作队列并更新进度，获取完成制作的物品,成功发出更新信号 [br]
## 前台时合成窗口每帧调用保证 UI 信息一致，后台每 2 秒调用一次
func 更新制作队列进度条(跳过时间:int=0):
	同步存档()
	var 制作参数=队列合成("制作参数")
	var 获得物品 = []
	for 参数 in 制作参数:
		var 制作时长=参数["制作时长"]
		if 跳过时间>0:参数["时间戳"]-=跳过时间
		var 时间差=Time.get_unix_time_from_system()-参数["时间戳"]
		var 完整次数 = floor(时间差 / 制作时长)
		if 完整次数>=1:
			参数["时间戳"]+=int(完整次数*制作时长)
			获得物品+=完成制作(参数["名称"],完整次数)
	if 获得物品.size()>=1:
		if 离线:
			计划.语法糖奖励显示(获得物品,"手工离线奖励")
		计划.保存存档("合成触发")
		计划.emit_signal("更新_UI")
##完成物品制作逻辑，处理残缺图纸奖励、基础素材倍率、熟练度、任务进度等[br]
##参数物品名称：要制作的物品名称[br]
##参数制作次数：制作次数，默认值为1[br]
##返回值：获得的物品列表（含图纸、礼盒等奖励）
func 完成制作(物品名称,制作次数=1):
	同步存档()
	var 获得物品 = []
	var 图纸数据 = 手工系统["合成配方"].get(物品名称, {})
	var 图纸等级 = 数据合成配方(物品名称)
	var 图纸升星 = 数据合成配方(物品名称,"升星")
	var 残缺图纸 = 数据合成配方(物品名称,"残缺图纸数量")
	var 类型=计划.表格.获取表格信息(计划.表格.创世蓝图,物品名称,"类型")
	if 残缺图纸>=1:# 残缺图纸逻辑不在允许残缺配方自动制作,自动制作时无需移除队列
		var 蓝图纸奖励=int(10*min(残缺图纸,制作次数))
		获得物品+=[计划.语法糖获得物品("蓝图纸",蓝图纸奖励)]
		获得物品+=[计划.语法糖获得物品("黄图纸",5)]
		计划.语法糖通知( "残缺研究,蓝图纸+" + str(蓝图纸奖励)+"黄图纸*5")
		残缺图纸-=制作次数
		if 残缺图纸<=0:
			图纸数据.erase("残缺图纸数量")
		else :
			图纸数据["残缺图纸数量"]=残缺图纸
		if 计划.节点有效性检查("合成界面"):
			计划.节点["合成界面"].生成配方节点()
	var 多重条件=[]
	if 配方精通效果["多重"].has(类型):
		var 原次数=制作次数
		制作次数=多重计算(制作次数,图纸等级* 0.05)
		if 原次数!=制作次数:多重条件+=["精通"]
	if 图纸升星>=2:
		var 原次数=制作次数
		制作次数=多重计算(制作次数,0.1)
		if 原次数!=制作次数:多重条件+=["升星"]
	var 通知文本="制作成功:"+str(物品名称)+("*"+str(制作次数)+"次"if 制作次数>1 else"")
	if 多重条件.size()>0:
		var 多重条件文本="("
		多重条件文本+=",".join(多重条件)
		多重条件文本+=")"
		通知文本+=多重条件文本
	计划.语法糖通知(通知文本)# 获得制作的物品及相关处理
	if 图纸等级>=0:
		计划.语法糖_快速熟练精通("手工", 物品名称,true,"合成",false)
	else :
		计划.语法糖_快速熟练精通("手工", null,true,"合成",false)
	计划.任务.完成任务合成(物品名称, 制作次数)
	if 物品名称=="随机礼盒":
		var 礼盒=["随机礼盒","炼金礼盒","符文礼盒"]
		获得物品+=[计划.语法糖获得物品(礼盒[randi() % 礼盒.size()], 制作次数, "标准物品")]
	else :
		获得物品+=[计划.语法糖获得物品(物品名称, 制作次数, "标准物品")]
	return 获得物品
func 多重计算(制作次数:int,多重:float)->int:
	return int(制作次数*(1+多重)+randf())
