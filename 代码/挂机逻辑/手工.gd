			return float(配方.get(返回, 0.0))
## 读取/修改炼金配方哈希结果的核心方法
##   哈希结果:配方的唯一哈希标识字符串,不存在返回0并打印报错
##   返回: 要读取的键名（支持：药水/数量/版本号/炼金次数/催化剂/配方/炼金字典）
##   修改: 仅对「炼金次数」生效，传入整数会累加（允许负值，最终保证非负）
## 返回值: 对应键的有效值（数组/字典/字符串/整数），不存在时返回对应默认值
func 数据炼金配方(哈希结果:String, 返回:String="炼金次数", 修改:Variant="") -> Variant:
	同步存档()
	var 炼金结果: Dictionary = 手工系统["炼金配方"].get(哈希结果, {"错误":0})
	if 炼金结果.has("错误"):
		match 返回:
			"添加配方":
				if 修改 is Dictionary and 配方格式检查(修改,false):
					var 配方结果=计算配方(修改,20)
					var 哈希值=哈希配方(修改)
					手工系统["炼金配方"][哈希值]=配方结果
					print(哈希值,"炼金结果",配方结果)
					return true
				return false
			_:return -1
	# 第二步：处理「哈希结果存在」的场景，按返回键处理逻辑
	match 返回:
		"添加配方":return false
		"炼金次数":
			var 当前次数 = int(炼金结果.get(返回, 0))
			if 修改 is int:
				炼金结果[返回] = 当前次数 + 修改
			return 当前次数
		"药水","数量":
			if 炼金结果.get(返回) is Array:return 炼金结果[返回]
			else:return []
		"版本号":##通常存为int 但假设存了其他值直接返回
			var 版本值 = 炼金结果.get("版本号", -1)
			return 版本值
		"催化剂":return str(炼金结果.get("催化剂", ""))
		"配方":
			if 炼金结果.get("配方") is Dictionary:
				return 炼金结果["配方"]
			else:
				return {}
		"炼金字典":
			var 药水数组 = 炼金结果.get("药水", [])
			var 数量数组 = 炼金结果.get("数量", [])
			if not (药水数组 is Array and 数量数组 is Array) or 药水数组.size() != 数量数组.size():# 校验：必须都是数组且长度一致
				return {}
			var 炼金字典 = {}
			for i in 药水数组.size():
				var 药水名 = 药水数组[i]
				var 数量值 = int(数量数组[i])  # 确保数量是整数
				炼金字典[药水名] = 数量值
			return 炼金字典
		_:
			print("报错:数据炼金配方的 返回 定义错误",返回)
			return 0
func 配方格式检查(配方字典, 生成通知:bool=false):
	if not ("材料名称" in 配方字典 and "材料数量" in 配方字典 and "催化剂" in 配方字典):# 1. 检查字典必备键是否存在
		if 生成通知:计划.语法糖通知("添加失败:配方损坏","炼金窗口")
		return false # 字典格式错误
	var 材料名称类型合法 = 配方字典["材料名称"] is Array
	var 材料数量类型合法 = 配方字典["材料数量"] is Array
	var 催化剂类型合法 = 配方字典["催化剂"] is String and 配方字典["催化剂"] != ""
	if not (材料名称类型合法 and 材料数量类型合法 and 催化剂类型合法):# 2. 检查各字段数据类型
		if 生成通知:
			if not 催化剂类型合法:计划.语法糖通知("添加失败:缺少催化剂","炼金窗口")
			else:计划.语法糖通知("添加失败:配方损坏","炼金窗口")
		return false # 数据类型错误
	var 数组长度匹配 = 配方字典["材料名称"].size() == 配方字典["材料数量"].size()
	var 材料数量达标 = 配方字典["材料名称"].size() >= 3
	if not (数组长度匹配 and 材料数量达标):# 3. 检查材料数组长度匹配且最少3种材料
		if 生成通知:
			if not 材料数量达标:
				计划.语法糖通知("添加失败:至少放入3种炼金材料","炼金窗口")
			else:
				计划.语法糖通知("添加失败:配方损坏","炼金窗口")
		return false # 配方错误
	var 已记录的材料名:Array=[]
	for 材料名 in 配方字典["材料名称"]:
		if 材料名 == "":#检查材料名称非空
			if 生成通知:
				计划.语法糖通知("添加失败:材料名称不能为空","炼金窗口")
			return false
		if 材料名 in 已记录的材料名:#检查材料名称重复
			if 生成通知:
				计划.语法糖通知("添加失败:材料名称重复","炼金窗口")
			return false
		已记录的材料名.append(材料名)
	return true# 所有检查通过
