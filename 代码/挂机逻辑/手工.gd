	var 配方=手工系统["合成配方"].get(配方名称,{})
	match 返回:
		"等级":
			return int(配方.get(返回,-1))
		"精通":
			if 增改量 is int and 增改量>0 and 手工系统["合成配方"].has(配方名称):
				配方[返回]=int(配方.get(返回,0))+增改量
				计划.结算升级("手工","合成",配方名称)
			return int(配方.get(返回,0))
		"升星":
