func 数据灵感(返回="等级",增加值=0):
	同步存档()
	var 灵感=手工系统["灵感"].get(返回,{})
	if 返回=="等级":
		return int(灵感.get(返回,1))
	elif 返回=="精通":
		if 增加值 is int and 增加值>0:
			灵感["精通"]=int(灵感.get("精通",0))+增加值
			计划.结算升级("手工","灵感","灵感")
		return int(灵感.get(返回,0))
	elif 返回=="研究方向":
		if 增加值 is String and not 灵感["研究方向"].has(增加值):
			灵感["研究方向"]+=增加值
		return 灵感.get(返回,[])
	return int(灵感.get(返回,0))
