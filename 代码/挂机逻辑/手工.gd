func _exit_tree():#理论上这个代码挂在全局下面不可能删除这里这是为了统一代码
	if 后台计时器:
		后台计时器.queue_free()
func 更新界面(场景名称 = null):
	是否前台 = 场景名称 == "合成界面"
	if 是否前台:
		print("合成位于前台")
		后台计时器.stop()#停止方法
	else:
		print("合成位于后台")
		后台计时器.start()#启动方法
func 更新制作队列进度条():
	var 制作参数=初始化.梅存档["手工"].get("制作参数", [])
	var 获得物品 = []
	for 参数 in 制作参数:
		var 物品名称=参数["名称"]
		var 制作时长=参数["制作时长"]
		var 时间差=Time.get_unix_time_from_system()-参数["时间戳"]
		var 完整次数 = floor(时间差 / 制作时长)
		if 完整次数>=1:
			参数["时间戳"]+=int(完整次数*制作时长)
			获得物品+=完成制作(物品名称,完整次数)
	if 获得物品.size()>=1:
		if 离线:
			初始化.语法糖奖励显示(获得物品,"手工离线奖励")
		初始化.保存存档("合成触发")
		初始化.emit_signal("更新_UI")
		离线=false
func 完成制作(物品名称,制作次数=1):
	var 获得物品 = []
	var 图纸等级 = 初始化.梅存档["手工"].get(物品名称, 0)
	var 残缺图纸等级=初始化.梅存档["手工"].get(物品名称+"碎片", 0)
	var 类型=梅表格.获取表格信息(梅表格.装备蓝图,物品名称,"类型")
	if 残缺图纸等级>=1:# 残缺图纸逻辑不在允许残缺配方自动制作,自动制作时无需移除队列
		var 蓝图纸奖励=int(60*min(残缺图纸等级,制作次数))
		获得物品+=[初始化.语法糖获得物品("蓝图纸",蓝图纸奖励)]
		获得物品+=[初始化.语法糖获得物品("黄图纸",5)]
		引擎.屏幕.滚动提示( "残缺研究,蓝图纸+" + str(蓝图纸奖励)+"黄图纸*5")
		残缺图纸等级-=制作次数
		if 残缺图纸等级<=0:
			初始化.梅存档["手工"].erase(物品名称+"碎片")
		else :
			初始化.梅存档["手工"][物品名称+"碎片"]=残缺图纸等级
		if 初始化.节点有效性检查("合成界面"):
			初始化.节点["合成界面"].生成配方节点()
	if 类型=="基础素材":
		制作次数=制作次数*int(1+(图纸等级* 0.05)+randf())
	引擎.屏幕.滚动提示("制作成功:"+str(物品名称)+("*"+str(制作次数)+"次"if 制作次数>1 else""))# 获得制作的物品及相关处理
	if 图纸等级>=1:
		初始化.语法糖_快速熟练精通("手工熟练", "手工", 物品名称)
	else :
		初始化.语法糖_快速熟练精通("手工熟练", "手工", null)
	初始化.梅任务单例.完成任务合成(物品名称, 制作次数)
	if 物品名称=="随机礼盒":
		var 礼盒=["随机礼盒","炼金礼盒","符文礼盒"]
		获得物品+=[初始化.语法糖获得物品(礼盒[randi() % 礼盒.size()], 制作次数, "标准物品")]
	else :
		获得物品+=[初始化.语法糖获得物品(物品名称, 制作次数, "标准物品")]
	return 获得物品
func 获得蓝图(蓝图名称,提示=false):
	var 蓝图精通等级=初始化.梅存档["手工"].get(蓝图名称, 0)
	var 蓝图阶级=int(梅表格.获取表格信息(梅表格.装备蓝图,蓝图名称,"阶级"))
	if 蓝图精通等级==0:
		var 灵感的精通=抽卡精通(蓝图精通等级,蓝图阶级,false)
		if not "灵感等级精通" in 初始化.梅存档["手工"]:
			初始化.梅存档["手工"]["灵感等级精通"]=0
		初始化.梅存档["手工"]["灵感等级精通"]+=灵感的精通
		初始化.梅存档["手工"][蓝图名称]=1
		if 提示:
			引擎.屏幕.滚动提示( "恭喜获得新蓝图<"+蓝图名称+">灵感值增加:"+str(灵感的精通),"手工提示")
	else :
		var 灵感的精通=抽卡精通(蓝图精通等级,蓝图阶级)
		初始化.梅存档["手工"]["灵感等级精通"]+=灵感的精通
		初始化.语法糖获得物品("蓝图纸",8*(6+蓝图阶级))
		初始化.语法糖获得物品("黄图纸",蓝图阶级)
		if 提示:
			引擎.屏幕.滚动提示( "蓝图<"+蓝图名称+">已重复获得转化为灵感值:"+str(灵感的精通),"手工提示")
func 抽卡精通(等级: int,等阶: int,重复=true):
	if 重复:
		return 等级 * (1.25 ** 等阶) + 100# 每次抽卡获得的精通
	return int(等阶**1.2) * 100
func 筛选符合条件蓝图(分类: Array = [], 类型: Array = [], 职业: Array = [], 阶级: Array = [], 图纸集: Array = []) -> Array:
	var 符合条件的序号 = []
	var 装备蓝图数组 = 梅表格.装备蓝图
	# 检查是否有数据
	if 装备蓝图数组.size() < 2:
		return 符合条件的序号  # 没有数据或只有表头
	var 表头 = 装备蓝图数组[0]# 获取表头行
	var 分类索引 = 表头.find("分类")# 从表头获取各属性的索引
	var 类型索引 = 表头.find("类型")
	var 职业索引 = 表头.find("职业")
	var 阶级索引 = 表头.find("阶级")
	var 图纸集索引 = 表头.find("图纸集")
	for i in range(1, 装备蓝图数组.size()):# 从索引1开始遍历实际装备数据
		var 当前装备 = 装备蓝图数组[i]
		var 满足条件 = true
		# 检查分类条件（如果找到了对应的索引且有筛选条件）
		if 分类.size() > 0 and 分类索引 != -1:
			if not 分类.has(当前装备[分类索引]):
				满足条件 = false
		# 检查类型条件
		if 满足条件 and 类型.size() > 0 and 类型索引 != -1:
			if not 类型.has(当前装备[类型索引]):
				满足条件 = false
		# 检查职业条件
		if 满足条件 and 职业.size() > 0 and 职业索引 != -1:
			if not 职业.has(当前装备[职业索引]):
				满足条件 = false
		# 检查阶级条件
		if 满足条件 and 阶级.size() > 0 and 阶级索引 != -1:
			if not 阶级.has(当前装备[阶级索引]):
				满足条件 = false
		# 检查图纸集条件
		if 满足条件 and 图纸集.size() > 0 and 图纸集索引 != -1:
			if not 图纸集.has(当前装备[图纸集索引]):
				满足条件 = false
		# 如果所有条件都满足，添加序号到结果
		if 满足条件:
			符合条件的序号.append(i)
	return 符合条件的序号
# 获取指定数量的质数，返回int数组
func 获取质数列表(需要的数量: int) -> Array[int]:
	var 质数列表: Array[int] = []  # 存储找到的质数
	var 当前数字: int = 2  # 从2开始检查（最小的质数）
	
	# 循环直到收集到足够数量的质数
	while 质数列表.size() < 需要的数量:
		var 是否为质数: bool = true  # 标记当前数字是否为质数
		
		# 检查当前数字是否能被已找到的质数整除
		for 除数 in 质数列表:
			if 当前数字 % 除数 == 0:
				是否为质数 = false
				break  # 能被整除，不是质数，跳出循环
		
		# 如果是质数则加入列表
		if 是否为质数:
			质数列表.append(当前数字)
		
		当前数字 += 1  # 检查下一个数字
	
	return 质数列表
# 计算配方字典的哈希（专精于你的结构，顺序不敏感）
func 哈希配方(配方: Dictionary) -> String:
	var 材料名称数组 = 配方.get("材料名称", [])# 1. 提取字典中的三个固定键值（只处理你的特定结构）
	var 材料数量数组 = 配方.get("材料数量", [])
	var 材料组合列表: Array = []# 3. 组合材料名称和数量（如"炽心草茎5"）
	for i in range(材料名称数组.size()):
		var 材料名 = 材料名称数组[i]
		var 数量 = 0
		if not i>=材料数量数组.size():
			数量 = 材料数量数组[i]
		材料组合列表.append(材料名 + str(数量))  # 拼接成"材料名+数量"字符串
	材料组合列表.append(配方.get("催化剂", ""))# 4. 加入催化剂
	# 5. 对组合列表排序（关键：让顺序不影响结果）
	材料组合列表.sort()  # 排序后，元素顺序变化哈希不变
	
	# 6. 转换为字符串并计算哈希
	var 组合字符串:String = "||".join(材料组合列表)
	print("初始参数:",配方,组合字符串)
	return str(组合字符串.hash())
