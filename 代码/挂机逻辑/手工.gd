func 烹饪工序查询(工序,返回):
	if not 工序设定.has(工序):
		if 返回=="倍率":
			if 工序设定["复合工序"].has(工序):
				var 倍率:=1.0
				var 工序字典:Dictionary=工序设定["复合工序"][工序]
				for 工序名称 in 工序字典:
					倍率+=(-1.0+烹饪工序查询(工序名称,"倍率"))*工序字典[工序名称]
				return 倍率
		return 0
	match 返回:
		"需求标签":
			var 返回字典:Dictionary[String,String]={}
			if not 工序设定[工序].has(返回):#复合工没有属性
				return 返回字典
			var 需求标签=工序设定[工序][返回]#返回的内容但格式需要转换
			for 工序名 in 需求标签:
				返回字典[工序名]=需求标签[工序名]
			return 返回字典
		_:
			if 工序设定[工序].has(返回):
				return 工序设定[工序][返回]
			return -0
func 数据调料点数(调料,增加量=0):
	同步存档()
	var 调料点 = 手工系统["调料点数"]
	if 调料=="":
		var 调料数组=[]
		for 调味品名 in 调料点:
			if 调料点[调味品名]>0:
				调料数组.append(调味品名)
		return 调料数组
	if 增加量 is int and not 增加量==0:
		调料点[调料]=int(调料点.get(调料,0)+增加量)
	return 调料点.get(调料,0)
