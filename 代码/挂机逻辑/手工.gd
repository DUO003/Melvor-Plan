## 安全检查合成制作队列并更新进度，获取完成制作的物品,成功发出更新信号 [br]
## 前台时合成窗口每帧调用保证 UI 信息一致，后台每 2 秒调用一次
func 更新制作队列进度条():
	同步存档()
	var 制作参数=手工系统["制作参数"]
	var 获得物品 = []
	for 参数 in 制作参数:
		var 制作时长=参数["制作时长"]
		var 时间差=Time.get_unix_time_from_system()-参数["时间戳"]
		var 完整次数 = floor(时间差 / 制作时长)
		if 完整次数>=1:
			参数["时间戳"]+=int(完整次数*制作时长)
			获得物品+=完成制作(参数["名称"],完整次数)
	if 获得物品.size()>=1:
		if 离线:
			计划.语法糖奖励显示(获得物品,"手工离线奖励")
		计划.保存存档("合成触发")
		计划.emit_signal("更新_UI")
##完成物品制作逻辑，处理残缺图纸奖励、基础素材倍率、熟练度、任务进度等[br]
##参数物品名称：要制作的物品名称[br]
##参数制作次数：制作次数，默认值为1[br]
##返回值：获得的物品列表（含图纸、礼盒等奖励）
func 完成制作(物品名称,制作次数=1):
	同步存档()
	var 获得物品 = []
	var 图纸数据 = 手工系统["合成配方"].get(物品名称, {})
	var 图纸等级 = 图纸数据.get("等级", 0)
	var 残缺图纸 = 图纸数据.get("残缺图纸数量", 0)
	var 类型=计划.表格.获取表格信息(计划.表格.创世蓝图,物品名称,"类型")
	if 残缺图纸>=1:# 残缺图纸逻辑不在允许残缺配方自动制作,自动制作时无需移除队列
		var 蓝图纸奖励=int(60*min(残缺图纸,制作次数))
		获得物品+=[计划.语法糖获得物品("蓝图纸",蓝图纸奖励)]
		获得物品+=[计划.语法糖获得物品("黄图纸",5)]
		计划.语法糖通知( "残缺研究,蓝图纸+" + str(蓝图纸奖励)+"黄图纸*5")
		残缺图纸-=制作次数
		if 残缺图纸<=0:
			图纸数据.erase("残缺图纸数量")
		else :
			图纸数据["残缺图纸数量"]=残缺图纸
		if 计划.节点有效性检查("合成界面"):
			计划.节点["合成界面"].生成配方节点()
	if 类型=="基础素材":
		制作次数=制作次数*int(1+(图纸等级* 0.05)+randf())
	计划.语法糖通知("制作成功:"+str(物品名称)+("*"+str(制作次数)+"次"if 制作次数>1 else""))# 获得制作的物品及相关处理
	if 图纸等级>=1:
		计划.语法糖_快速熟练精通("手工", 物品名称)
	else :
		计划.语法糖_快速熟练精通("手工", null)
	计划.梅任务单例.完成任务合成(物品名称, 制作次数)
	if 物品名称=="随机礼盒":
		var 礼盒=["随机礼盒","炼金礼盒","符文礼盒"]
		获得物品+=[计划.语法糖获得物品(礼盒[randi() % 礼盒.size()], 制作次数, "标准物品")]
	else :
		获得物品+=[计划.语法糖获得物品(物品名称, 制作次数, "标准物品")]
	return 获得物品
##为合成玩法增加蓝图,或残缺图纸数量
##完整图纸判断条件为等级大于等于0,残缺图纸数量最大5,每张残缺图纸可以制作一次道具
func 获得蓝图(蓝图名称,完整=true,提示=false):
	同步存档()
	var 合成配方 = 手工系统["合成配方"]
	var 图纸数据 = 手工系统["合成配方"].get(蓝图名称, {})
	if 完整:
		var 图纸等级 = 图纸数据.get("等级", -1)
		var 蓝图阶级 = int(计划.表格.获取表格信息(计划.表格.创世蓝图,蓝图名称,"阶级"))
		if 图纸等级==-1:
			var 灵感的精通=抽卡精通(手工系统["精通"],蓝图阶级,false)
			手工系统["灵感"]["精通"]=灵感的精通+手工系统["灵感"].get("精通", 0)
			合成配方[蓝图名称]["等级"]=0
			合成配方[蓝图名称]["精通"]=0
			if 提示:
				计划.语法糖通知( "恭喜获得新蓝图<"+蓝图名称+">灵感值增加:"+str(灵感的精通),"手工提示")
		else :
			var 蓝图精通等级=合成配方[蓝图名称].get("等级", 0)
			var 灵感的精通=抽卡精通(蓝图精通等级,蓝图阶级)
			手工系统["灵感"]["精通"]=灵感的精通+手工系统["灵感"].get("精通", 0)
			计划.语法糖获得物品("蓝图纸",160)
			计划.语法糖获得物品("黄图纸",蓝图阶级)
			if 提示:
				计划.语法糖通知( "蓝图<"+蓝图名称+">已重复获得转化为灵感值:"+str(灵感的精通),"手工提示")
	else :
		var 残缺图纸数量=图纸数据.get("残缺图纸数量",0)
		if 残缺图纸数量==0:
			图纸数据["残缺图纸数量"]=1
			计划.语法糖通知( "首次获得残缺蓝图<"+蓝图名称+">#残缺图纸仅可制作一次","手工提示")
		elif 残缺图纸数量<5:
			图纸数据["残缺图纸数量"]=残缺图纸数量+1
			计划.语法糖通知( "获得残缺蓝图<"+蓝图名称+">+1数量("+str(残缺图纸数量)+")","手工提示")
		else :
			计划.语法糖获得物品("蓝图纸",40)
			计划.语法糖通知("残缺蓝图<"+蓝图名称+">超出上限补偿","手工提示")
##辅助函数,在获得蓝图时候重复则累计灵感精通
func 抽卡精通(等级: int,等阶: int,重复=true):
	if 重复:
		return 等级 * (1.25 ** 等阶) + 100# 每次抽卡获得的精通
	return int(等阶**1.2) * 100
## 全能型蓝图筛选函数[br]
## 参数: 筛选条件 - 字典类型，键为表头名称，值为符合条件的值数组[br]
## 参数: 返回名称 - 布尔类型，true返回蓝图名称，false返回序号，默认false[br]
## 返回值: 符合条件的蓝图序号数组或名称数组
func 筛选符合条件蓝图(筛选条件: Dictionary = {}, 返回名称: bool = false) -> Array:
	var 结果数组 = []
	var 装备蓝图数组 = 计划.表格.创世蓝图
	# 检查是否有数据
	if 装备蓝图数组.size() < 2:
		return 结果数组  # 没有数据或只有表头
	
	for i in range(1, 装备蓝图数组.size()):# 从索引1开始遍历实际装备数据
		var 当前装备 = 装备蓝图数组[i]
		var 满足条件 = true
		
		# 遍历筛选条件字典，动态检查每个条件
		for 筛选字段 in 筛选条件.keys():
			if not 满足条件:
				break  # 已不满足条件，跳过后续检查
			
			var 允许值数组 = 筛选条件[筛选字段]# 获取当前字段的允许值数组
			if 允许值数组.size() == 0:
				continue  # 允许值数组为空，跳过此条件
			
			# 使用计划.表格.蓝图表头获取索引，提高效率
			if 计划.表格.蓝图表头.has(筛选字段):
				var 字段索引 = 计划.表格.蓝图表头[筛选字段]
				# 检查当前装备的该字段值是否在允许值数组中
				if not 允许值数组.has(当前装备[字段索引]):
					满足条件 = false
		
		# 如果所有条件都满足，根据参数添加序号或名称到结果
		if 满足条件:
			if 返回名称:
				结果数组.append(当前装备[0])  # 名称索引固定为0
			else:
				结果数组.append(i)  # 返回序号，兼容旧代码
	return 结果数组
# 获取指定数量的质数，返回int数组
func 获取质数列表(需要的数量: int) -> Array[int]:
	var 质数列表: Array[int] = []  # 存储找到的质数
	var 当前数字: int = 2  # 从2开始检查（最小的质数）
	
	# 循环直到收集到足够数量的质数
	while 质数列表.size() < 需要的数量:
		var 是否为质数: bool = true  # 标记当前数字是否为质数
		
		# 检查当前数字是否能被已找到的质数整除
		for 除数 in 质数列表:
			if 当前数字 % 除数 == 0:
				是否为质数 = false
				break  # 能被整除，不是质数，跳出循环
		
		# 如果是质数则加入列表
		if 是否为质数:
			质数列表.append(当前数字)
		
		当前数字 += 1  # 检查下一个数字
	
	return 质数列表
## 计算配方字典的哈希
func 哈希配方(配方: Dictionary) -> String:
	var 材料名称数组 = 配方.get("材料名称", [])# 1. 提取字典中的三个固定键值（只处理你的特定结构）
	var 材料数量数组 = 配方.get("材料数量", [])
	var 材料组合列表: Array = []# 3. 组合材料名称和数量（如"炽心草茎5"）
	for i in range(材料名称数组.size()):
		var 材料名 = 材料名称数组[i]
		var 数量 = 0
		if not i>=材料数量数组.size():
			数量 = 材料数量数组[i]
		材料组合列表.append(材料名 + str(数量))  # 拼接成"材料名+数量"字符串
	材料组合列表.append(配方.get("催化剂", ""))# 4. 加入催化剂
	# 5. 对组合列表排序（关键：让顺序不影响结果）
	材料组合列表.sort()  # 排序后，元素顺序变化哈希不变
	
	# 6. 转换为字符串并计算哈希
	var 组合字符串:String = "||".join(材料组合列表)
	print("初始参数:",配方,组合字符串)
	return str(组合字符串.hash())
##返回整数,可选参数 等级(默认值-1)"残缺图纸数量"和"精通"(默认值0),"需求"返回升级所需精通值
##增加精通仅在配方已获得后可生效
func 数据合成配方(配方名称:String,返回="等级",增加精通:int=0)->int:
	同步存档()
	var 配方=手工系统["合成配方"].get(配方名称,{})
	if 返回=="等级":
		return int(配方.get(返回,-1))
	elif 返回=="精通":
		if 增加精通>0 and 手工系统["合成配方"].has(配方名称):
			配方["精通"]=int(配方.get("精通",0))+增加精通
			计划.结算升级("手工","合成",配方名称)
		return int(配方.get(返回,0))
	return int(配方.get(返回,0))
