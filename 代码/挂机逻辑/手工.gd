##加入队列需要传入配方数组,且优先级大于移除,执行移除需要传入序号且加入队列值为""
func 队列炼金(加入队列:="",执行次数:int=1,移除队列=-1)->Array:
	同步存档()
	if not "炼金" in 手工系统["队列"]:
		手工系统["队列"]["炼金"]={
				"制作队列": [],
				"制作队列上限":1}
	var 制作队列: Array=手工系统["队列"]["炼金"]["制作队列"]
	if not 加入队列=="":
		制作队列+=[
		{"配方":加入队列,
		"时间戳":int(Time.get_unix_time_from_system()),
		"剩余":执行次数,
		"完成":0,
		"用时":1,}]
	elif 移除队列>=0 and 移除队列<制作队列.size():
		制作队列.remove_at(移除队列)
	return 制作队列
func 检查并更新炼金队列():
	var 炼金队列 = 队列炼金()
	if 炼金队列.size() == 0:
		return  # 队列为空，无需处理
	var 当前时间 = int(Time.get_unix_time_from_system())
	for i in range(炼金队列.size()):# 用索引遍历（避免遍历中修改队列导致的异常）
		var 队列项 = 炼金队列[i]
		if not 队列项.has_all(["时间戳", "用时", "剩余", "完成"]):# 容错：检查队列项是否包含必要字段
			print("错误：炼金队列项缺少字段，索引：", i)
			continue
		var 时间戳 = 队列项["时间戳"]# 提取队列项数据
		var 单次用时 = 队列项["用时"]
		var 剩余次数 = 队列项["剩余"]
		var 完成次数 = 队列项["完成"]
		var 时间差 = 当前时间 - 时间戳# 计算当前时间与周期起点的差值（秒）
		if 时间差 < 0:# 未到周期时间/时间回拨，跳过
			炼金队列[i]["时间戳"] = 当前时间
			continue
		var 可完成次数 = min(int(时间差*1.0 / 单次用时), 剩余次数)# 计算可完成的次数
		if 可完成次数 <= 0:
			continue
		炼金队列[i]["剩余"] = 剩余次数-可完成次数
		炼金队列[i]["完成"] = 完成次数+可完成次数
		炼金队列[i]["时间戳"] = 时间戳+可完成次数 * 单次用时
func 获得资源(名称, 数量=0.0, 检查上限=true, 信号=true):# 增加或减少手工系统的资源数量
	同步存档()
	if 数量==0.0:
		return
	数量 = float(数量)  # 强制转换为浮点
	var 基础资源: Dictionary = 手工系统["基础资源"]
	var 当前数量 = 基础资源.get(名称,0)
	var 新数量 = 当前数量 + 数量
	var 溢出处理 = false  # 标记是否需要处理溢出
	var 溢出量 = 0.0  # 改为浮点数存储
	if 检查上限 and 名称 != "精华":# 检查上限逻辑，且资源不是精华时才执行
		# 建立资源名称与上限变量的映射关系
		var 上限变量名 = 名称 + "上限"
		# 检查当前资源是否有对应的上限设置
		var 上限值 = get(上限变量名)
		# 情况1：当前数量已超过上限，处理本次新增的全部数量作为溢出
		if 当前数量 > 上限值:
			溢出量 = 数量  # 本次新增的数量全部算作溢出
			溢出处理 = true
			新数量 = 当前数量  # 保持当前数量不变（已超上限）
		# 情况2：当前数量未超上限，但新增后超过上限
		elif 新数量 > 上限值:
			溢出量 = 新数量 - 上限值  # 计算超出上限的部分
			新数量 = 上限值  # 限制在最大值
			溢出处理 = true
	# 处理溢出资源转换为零件的逻辑（指定资源类型）
	if 溢出处理 and 名称 in ["木材", "矿石", "皮革", "药草"]:
		var 零件数量 = 溢出量 / 10.0  # 使用浮点数除法，保留小数
		if 零件数量 > 0:
			获得资源("零件", 零件数量, 检查上限, false)  # 递归调用自身
	if 新数量 <= 0:
		print("背包资源扣除",名称,新数量)
		计划.语法糖消耗物品(名称,abs(新数量))#如果背包内有也可以扣
		基础资源[名称] = 0
	else:
		基础资源[名称] = 新数量  # 更新物品数量
	if 信号:
		计划.emit_signal("更新_UI")#调用UI更新信号
