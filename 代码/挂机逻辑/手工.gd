##完整图纸判断条件为等级大于等于0,残缺图纸数量最大5,每张残缺图纸可以制作一次道具
func 获得蓝图(蓝图名称,完整=true,提示=false):
	同步存档()
	var 合成配方 = 手工系统["合成配方"]
	if not 合成配方.has(蓝图名称):
		手工系统["合成配方"][蓝图名称]={}
	var 图纸数据 = 手工系统["合成配方"][蓝图名称]
	var 提示文本=""
	if 完整:
		var 图纸等级 = 图纸数据.get("等级", -1)
		var 蓝图阶级 = int(计划.表格.获取表格信息(计划.表格.创世蓝图,蓝图名称,"阶级"))
		if 图纸等级==-1:
			var 灵感的精通=抽卡精通(手工系统["精通"],蓝图阶级,false)
			数据灵感("精通",灵感的精通)
			合成配方[蓝图名称]["等级"]=0
			合成配方[蓝图名称]["精通"]=0
			提示文本="获取蓝图<"+蓝图名称+">灵感值增加:"+str(灵感的精通)
		else :
			var 蓝图精通等级=合成配方[蓝图名称].get("等级", 0)
			var 灵感的精通=抽卡精通(蓝图精通等级,蓝图阶级)
			手工系统["灵感"]["精通"]=灵感的精通+手工系统["灵感"].get("精通", 0)
			计划.语法糖获得物品("蓝图纸",160)
			计划.语法糖获得物品("黄图纸",蓝图阶级)
			提示文本="获取蓝图<"+蓝图名称+">已重复获得转化为灵感值:"+str(灵感的精通)
	else :
		var 残缺蓝图上限:int=int(计划.数据技能树("研究残缺图纸"))
		var 残缺图纸数量=图纸数据.get("残缺图纸数量",0)
		if 残缺图纸数量==0:
			图纸数据["残缺图纸数量"]=残缺蓝图上限
			提示文本="获得残缺蓝图<"+蓝图名称+">首次获取残缺图纸*6"
		else :
			var 残缺图纸获取量=1+randi() % 残缺蓝图上限
			图纸数据["残缺图纸数量"]=残缺图纸数量+残缺图纸获取量
			提示文本="获得残缺蓝图<%s>+%d数量(%d)"%[蓝图名称,残缺图纸获取量,残缺图纸数量]
	if 提示:计划.语法糖通知(提示文本,"手工系统")
	return 提示文本
