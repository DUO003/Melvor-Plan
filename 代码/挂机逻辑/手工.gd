## 功能：管理合成玩法抽奖机相关灵感数据的读写，保底返回-1[br]
## 1. 等级：整数（默认/最小1，最大100），灵感等级[br]
## 2. 等阶：整数（默认/最小1，最大20），由等级换算得出（等级÷5向下取整）[br]
## 3. 精通：整数（默认0），仅支持正数累加，累加后触发结算升级[br]
## 4. 研究费用：整数（默认0，最小0，最大160），抽卡费用，支持累加且限制范围[br]
## 5. 研究方向：数组（默认[]），仅支持追加不重复的字符串类型方向（如"符文"）[br]
## 6. 研究序号：整数（默认0），选中的研究方向索引，范围0~数组长度-1，超出修正（大取最大/小取0）[br]
## 特殊说明：不含图纸数据，图纸需调用"数据合成配方"方法[br]
func 数据灵感(返回="等级",增加值=0):
	同步存档()
	var 灵感=手工系统["灵感"]
	match 返回:
		"等级":#仅由结算升级修改
			return clampi(int(灵感.get(返回, 1)), 1,100)
		"等阶":#仅读取
			return clampi(int(灵感.get("等级", 1)/20), 1,20)
		"精通":
			if 增加值 is int and 增加值>0:
				灵感[返回]=int(灵感.get(返回,0))+增加值
				计划.结算升级("手工","灵感","灵感")
			return int(灵感.get(返回,0))
		"研究费用":
			if 增加值 is int and 增加值!=0:
				if not 灵感.has(返回):
					灵感[返回]=0
				灵感[返回] = clampi(int(增加值+灵感.get(返回, 0)), 0,160)
			return clampi(int(灵感.get(返回, 0)), 0,160)
		"研究方向":
			if not 灵感.has(返回):
				灵感[返回]=[]
			if not 灵感[返回].has("基础素材"):
				灵感[返回].append("基础素材")
			if 增加值 is String :#为文本表示否定传入增加值
				if not 灵感[返回].has(增加值):
					灵感[返回]+=[增加值]
			return 灵感.get(返回,[])
		"研究序号":
			if 增加值 is int:
				灵感[返回]=clampi(增加值, 0, 灵感.get("研究方向",[]).size()-1)
			return clampi(灵感.get(返回,0), 0, 灵感.get("研究方向",[]).size()-1)
		_:
			print("数据:灵感打印了意外的结果\r传入数据:",返回,增加值)
			return -1

func 数据烹饪菜谱(配方名称:String,返回="等级",增改量=0,进步:float=0.05):
	同步存档()
	var 配方=手工系统["烹饪菜谱"].get(配方名称,{})
	match 返回:
		"等级":return int(配方.get(返回, -1))
		"美味度":
			if 增改量 is float:
				var 基础美味度=计划.表格.获取属性(配方名称,"美味度",0.0)
				var 旧美味度=配方.get(返回, 0.0)
				var 新美味度
				if 增改量>旧美味度:
					新美味度=旧美味度+max(0.1,(增改量-旧美味度)*min(0.25,进步))
				else :
					新美味度=max(旧美味度,min(基础美味度,旧美味度+0.1))
