##加入队列需要传入蓝图名称,如果存在则执行移除,为空仅返回数值
func 队列合成(返回:String="制作队列",加入或移除:="",通知:=true):
	同步存档()
	if not "合成" in 手工系统["队列"]:
		手工系统["队列"]["合成"]={
				"制作队列": [],
				"制作参数": [],
				"制作队列上限":1}
	var 合成: Dictionary=手工系统["队列"]["合成"]
	合成["制作队列上限"]=1+max(0,int(0.1*手工系统["等级"]))
	match 返回:
		"制作队列":
			var 制作队列: Array=合成[返回]
			if not 加入或移除=="":
				if 加入或移除 in 制作队列:# 存在则移除
					制作队列.erase(加入或移除)
					重算资源回复(制作队列)
					计划.更新玩法.emit()
					if 通知:计划.语法糖通知( "已从制作队列移除:"+加入或移除,"手工提示")
				else:
					var 配方等级=数据合成配方(加入或移除)
					if 制作队列.size()<合成["制作队列上限"]:
						if 配方等级!=-1:
							制作队列.append(加入或移除)
							重算资源回复(制作队列)
							计划.更新玩法.emit()
							if 通知:计划.语法糖通知( "已添加到制作队列:"+加入或移除,"手工提示")
						else :
							var 残缺配方 = 数据合成配方(加入或移除,"残缺图纸数量")
							if 残缺配方>0:
								if 通知:计划.语法糖通知( "残缺配方仅限手动制作","手工提示")
							else :
								if 通知:计划.语法糖通知( "配方未解锁，无法加入队列","手工提示")
					else :
						if 通知:计划.语法糖通知( "队列已满","手工提示")
			return 合成[返回]
		"制作参数":return 合成[返回]
		"制作队列上限":return 合成[返回]
		_:return -1
func 重算资源回复(制作队列=队列合成(),自动保存:bool=true):
	var 缓存资源每秒 = 计划.基础资源每秒.duplicate(true)# 基础资源每秒回复量
	for 资源名 in 缓存资源每秒:
		缓存资源每秒[资源名]=缓存资源每秒[资源名]*(1+0.05*手工系统["等级"])
	var 消耗统计 = {}
	for 资源 in 缓存资源每秒:
		消耗统计[资源]=0.0
	var 配方耗时=[]
	for 队列项 in 制作队列:# 第一步：统计所有制作队列的资源消耗
		var 表格字典 = 计划.表格.获取表格字典(计划.表格.创世蓝图, -1,队列项)
		var 图纸升星 = 数据合成配方(队列项,"升星")
		var 每秒消耗 = 计算每秒材料消耗(表格字典,0.9 if 图纸升星>=1 else 1.0)
		配方耗时.append(max(表格字典.get("冷却", 10),10))
		for 资源名 in 每秒消耗:# 累加消耗到统计中
			if 资源名 in 消耗统计:
				消耗统计[资源名] += 每秒消耗[资源名]
	var 制作时间倍 = 1.0# 第二步：计算制作倍率（取最慢的瓶颈）
	for 资源名 in 缓存资源每秒.keys():
		var 基础回复 = max(缓存资源每秒[资源名],1)
		var 当前倍率 = 消耗统计[资源名] / (基础回复)
		if 当前倍率 > 制作时间倍:制作时间倍 = 当前倍率
	制作时间倍 = max(制作时间倍, 1.0)  # 确保倍率不小于1
	for 资源 in 缓存资源每秒:
		资源回复[资源] = 缓存资源每秒[资源] - (消耗统计[资源] / 制作时间倍)
	#更新制作参数
	var 制作参数=队列合成("制作参数")
	var 新制作参数 = []
	var 序号=0
	for 当前物品名 in 制作队列:# 第一步：筛选保留匹配的元素
		if 序号 < 制作参数.size() and 制作参数[序号].get("名称") == 当前物品名:
			var 新值=制作参数[序号]
			新值["制作时长"]=1.0*配方耗时[序号]*制作时间倍
			新制作参数.append(新值)
		序号+=1
	for i in range(新制作参数.size(), 制作队列.size()):# 第二步：补充制作队列中新增的部分
		var 当前物品名 = 制作队列[i]
		新制作参数.append({
			"名称": 当前物品名,
			"制作时长": 1.0*配方耗时[i]*制作时间倍,
			"时间戳": Time.get_unix_time_from_system()})
	手工系统["队列"]["合成"]["制作参数"] = 新制作参数
	if 自动保存:计划.保存存档("更新制作参数")
	计划.更新_UI.emit()
func 计算每秒材料消耗(表格字典,倍率:=1.0):
	var 冷却时间 = 表格字典.get("冷却", 10)
	if 冷却时间 <= 0:冷却时间 = 10  # 避免冷却时间为0导致的除零错误
	var 每秒消耗 = {}  # 最终结果字典
	for 材料类型 in 资源字典.keys():
		每秒消耗[材料类型] = 0.0# 初始化所有材料消耗为0.0（确保即使无消耗也返回0）
	for 材料类型 in 资源字典.keys():# 遍历材料类型计算基础消耗
		var 基础消耗 = (表格字典.get(材料类型, 0)*倍率) / 冷却时间  # 计算当前材料的基础每秒消耗
		if 资源字典[材料类型]["类型"]=="高级":# 二级资源转化为对应一级资源的消耗
			var 转化规则 = 资源字典[材料类型]["转换"]  # 获取该二级资源的转化配方
			for 一级材料 in 转化规则:
				每秒消耗[一级材料] += 基础消耗 * 转化规则[一级材料]# 累加转化后的消耗
		elif 资源字典[材料类型]["类型"] == "特殊":每秒消耗[材料类型] = 0.0# 三级资源特殊始终为0
		else:每秒消耗[材料类型] += 基础消耗# 一级资源：直接累加基础消耗
	return 每秒消耗
##加入队列需要传入配方数组,且优先级大于移除,执行移除需要传入序号且加入队列值为""
func 队列炼金(加入队列:="",执行次数:int=1,移除队列=-1)->Array:
	同步存档()
	if not "炼金" in 手工系统["队列"]:
		手工系统["队列"]["炼金"]={
				"制作队列": [],
				"制作队列上限":1,
				"配方队列上限":1}
	var 炼金: Dictionary=手工系统["队列"]["炼金"]
	if not 加入队列=="" and 执行次数>0:
		炼金["制作队列"]+=[
		{"配方":加入队列,
		"时间戳":int(Time.get_unix_time_from_system()),
		"剩余":执行次数,
		"完成":0,
		"用时":180,}]
	elif 移除队列>=0 and 移除队列<炼金["制作队列"].size():
