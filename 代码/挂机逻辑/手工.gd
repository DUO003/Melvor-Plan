	if 基础资源.has(名称):return 基础资源[名称]
	elif 检查资源类(名称)=="特殊":return 0
	else:return 资源上限字典.get(名称,0)
##计算配方并返回字典
func 计算配方(配方字典, 抽取次数: int=20) -> Dictionary:
	var 属性总和字典 = 计算权重(配方字典)# 1. 计算配方的6个属性总和（创造/勇气/奇异/洞察/复苏/齿轮）
	var 药水类物品 = 筛选符合条件蓝图({"分类":["药水"],"阶级":["1"]},true)# 2. 筛选药水类物品并生成项目/权重列表
	var 项目列表: Array = []
	var 权重列表: Array = []
	var 催化剂名称 = 配方字典["催化剂"]#装备药水逻辑
	for 药水 in 药水类物品:
		var 权重:int = 0
		var 药水倾向 = 计划.表格.获取属性(药水,"药水倾向",[])
		# 原有权重计算逻辑（完全保留）
		for i in (药水倾向.size()/3):
			if 药水倾向[i*3] == "任意":
				权重 += 药水倾向[i*3+2]
			elif 药水倾向[i*3] == 催化剂名称:
				权重 += 药水倾向[i*3+2]
			elif 属性总和字典.get(药水倾向[i*3], 0) >= 药水倾向[i*3+1] and 药水倾向[i*3+1]!=0:
				权重 += 药水倾向[i*3+2]
		#print(药水,权重,药水倾向)
		if 权重 > 0:
			项目列表.append(药水)
			权重列表.append(权重)
	var 炼金药水 = 计划.表格.获取属性(催化剂名称,"炼金药水",[])
	var 装备药水 = null# 装备药水名称（比如"圣坚药水"）
	if 炼金药水.size()>=3:装备药水 = 炼金药水[0]  # 判断是否满足装备药水解锁条件
	if 装备药水 != null:# 若装备药水有效，加入抽取池
		var 药水权重=属性总和字典.get(炼金药水[1], 0)
		if 药水权重>=炼金药水[2]:
			项目列表.append(装备药水)
			权重列表.append(min(药水权重+5,炼金药水[2]*2))  # 给装备药水设置权重随属性递增额外+5,但不超过两倍
		else :
			项目列表.append(装备药水)
			权重列表.append(炼金药水[2])  # 给装备药水设置权重至少
	var 随机 = RandomNumberGenerator.new()# 3. 初始化固定种子的随机数生成器（保证抽取+保底替换都稳定）
	var 哈希字符串 = 哈希配方(配方字典)
	随机.seed = 哈希字符串.hash()
	var 抽取结果: Dictionary = {# 4. 初始化返回字典（药水数组+数量数组）其他数据用于调试
		"药水": [],"数量": [],"版本号":1,"炼金次数":0,"催化剂":催化剂名称,"配方":配方字典.duplicate(true)}
		#"属性总和字典":属性总和字典,"项目列表":项目列表,权重列表":权重列表
	if 项目列表.size() > 0 and 抽取次数 > 0:# 5. 权重抽取+数量计算核心逻辑
		var 权重数组 = PackedFloat32Array(权重列表)
		for i in range(抽取次数):#抽取药水
			var 随机索引 = 随机.rand_weighted(权重数组)
			if 随机索引 < 0 or 随机索引 >= 项目列表.size():continue # 极端情况跳过
			var 选中药水 = 项目列表[随机索引]
			var 药水数量配置 = 计划.表格.获取属性(选中药水, "药水数量", [])#计算该药水的数量
			var 最终数量:int= 1 # 默认数量
			if 药水数量配置.size() >= 4: # 配置有效：[属性名, 阈值, 最小数量, 最大数量]
				var 目标属性名 = 药水数量配置[0]
				var 每X点属性 = max(药水数量配置[1], 1) # 避免除以0
				var 基础最小数量 = 药水数量配置[2]
				var 基础最大数量 = 药水数量配置[3]
				var 属性总值 = max(属性总和字典.get(目标属性名, 0),0)+属性总和字典.get("任意", 0)*0.15
				var 属性次数:int = int(属性总值**0.8 / 每X点属性)
				var 随机数量 = 随机.randi_range(0, 属性次数)
				最终数量 = clamp(随机数量, 基础最小数量, 基础最大数量)
			else:最终数量 = clamp(随机.randi_range(1, 1), 1, 1)#消耗掉这个随机机会,保持种子一致
			抽取结果["药水"].append(选中药水)#加入结果字典
			抽取结果["数量"].append(最终数量)
	if 装备药水 != null and 抽取结果["药水"].size() > 0:#装备药水保底逻辑
		if not 装备药水 in 抽取结果["药水"]:# 检查抽取结果中是否包含装备药水
			var 替换索引 = 随机.randi_range(0, 抽取结果["药水"].size() - 1)
			抽取结果["药水"][替换索引] = 装备药水# 随机选一个位置替换为装备药水（数量强制为1）
			抽取结果["数量"][替换索引] = 1  # 保底的装备药水数量固定为1
	return 抽取结果
func 计算权重(配方字典):
	var 目标属性列表 = ["创造", "勇气", "奇异", "洞察", "复苏", "齿轮"]
	var 材料名称列表 = 配方字典.get("材料名称", [])# 从配方中提取材料名称和数量
	var 材料数量列表 = 配方字典.get("材料数量", [])
	var 属性总和字典 = {"任意":0}
	var 材料属性字典 = {}
	for 材料名称 in 材料名称列表:
		var 材料字典 = 计划.表格.获取属性(材料名称, "炼金属性",{})
		材料属性字典[材料名称]=材料字典
	for 属性 in 目标属性列表:
		属性总和字典[属性] = 0
		for i in 材料名称列表.size():
			var 目标属性=材料属性字典[材料名称列表[i]].get(属性,0)
			属性总和字典[属性]+=目标属性*材料数量列表[i]
			属性总和字典["任意"]+=目标属性*材料数量列表[i]
	return 属性总和字典
# 计算装备统计数据的核心方法
# 参数: 装备字典 - 装备数据嵌套字典（一级键为装备名称，子字典包含"等级"键）
# 返回: Dictionary - 包含固定键的统计结果，结构：{"最高等级":0, "总等级":0, "强化点":0}
func 统计等级(类型:String="合成") -> Dictionary:
	var 统计字典: Dictionary = {
		"最高等级": 0,
		"总等级": 0,
		"强化点": 0}
	var 装备字典: Dictionary
	match 类型:
		"合成":装备字典=手工系统["合成配方"]
	for 装备名称 in 装备字典:# 遍历所有装备
		var 装备数据: Dictionary = 装备字典[装备名称]
		if not 装备数据.has("等级"):# 跳过无等级字段的装备
			continue
		var 等级值: Variant = 装备数据["等级"]
		if not (等级值 is int or 等级值 is float):
			continue
		var 整数等级: int = int(等级值)# 标准化等级（转整数+限制上限100）
		整数等级 = min(整数等级, 100)
		统计字典["总等级"] += 整数等级# 1. 累加总等级
		if 整数等级 > 统计字典["最高等级"]:
			统计字典["最高等级"] = 整数等级
		var 装备点数: int = 0
		if 整数等级 >= 25:装备点数 = 1
		if 整数等级 >= 50:装备点数 = 2
		if 整数等级 >= 75:装备点数 = 3
		if 整数等级 >= 100:装备点数 = 4
		统计字典["强化点"] += 装备点数
	return 统计字典
func 资源回复动作(进度条时长 = 1.0,更新UI=true):
	for 资源名 in 资源回复:
		var 特性倍率=1
		if 资源名=="木材":特性倍率=1
		elif 资源名=="矿石":
			特性倍率=0
			if randf() <= 0.5:特性倍率=2
		elif 资源名=="皮革":特性倍率=randf_range(0.25, 1.75)
		elif 资源名=="药草":
			特性倍率=0
			if randf() <= 0.8:
				特性倍率=randf_range(0.25, 2.1875)
		var 基础量 = 资源回复[资源名] * 进度条时长 * 特性倍率
		获得资源(资源名, 基础量, true, false)
	if 更新UI:计划.更新_UI.emit()# 统一触发UI更新
func 处理资源回复():
	var 优化倍率: float = 0.3
	var 进度条时长:int = 计划.处理时间戳(计划.梅存档["手工"]["基础资源"])
	if 进度条时长<1:return
	var 处理时间段 = []# 计算需要处理的时间段
	if 进度条时长 > 60:  # 处理超过60秒的长离线情况
		while 进度条时长 > 60:
			var 时间段 = max(floor(进度条时长 * 优化倍率),10)  # 按倍率计算下一段时长（向下取整）
			处理时间段.append(时间段)  # 添加当前计算的时间段
			进度条时长 -= 时间段  # 更新当前时长为下一段基础
	@warning_ignore("integer_division")
	var 完整循环次数 = floor(进度条时长 / 10)
	var 剩余秒数 = 进度条时长 % 10
	if 完整循环次数 >= 1:for i in range(完整循环次数):处理时间段.append(10)
	if 剩余秒数 > 0:处理时间段.append(剩余秒数)
	for 时长 in 处理时间段:资源回复动作(时长,false)# 循环处理所有时间段，累加资源增加量
	计划.处理时间戳(计划.梅存档["手工"]["基础资源"],-1)
	计划.更新_UI.emit()# 触发UI更新和保存
	计划.保存存档("资源回复")
##检查预制版本的食材数量,兼容""调用背包数量返回值,但""不能获取或扣除物品.
func 烹饪预制(物品名称:String,处理格式:String="",增加量:int=0)->int:
	var 蓝图标签:Dictionary=计划.表格.缓存蓝图标签
	if not 蓝图标签.has(物品名称):
		print("错误,找不到物品",物品名称)
		return 0
	var 标签=蓝图标签[物品名称]
	if not 标签=="食材":
		print("错误,不能预制非食材",物品名称)
		return 0
	同步存档()
	if 处理格式=="":
		return 计划.检查背包物品数量(物品名称)
	var 料理=手工系统["预制食材"]
	if not 增加量==0:
		if not 料理.has(物品名称):
			料理[物品名称]={}
		料理[物品名称][处理格式]=int(料理[物品名称].get(处理格式,0)+增加量)
		if 料理[物品名称][处理格式]<0:
			料理[物品名称][处理格式]=0
	if 料理.has(物品名称) and 料理[物品名称].has(处理格式):
		return 料理[物品名称][处理格式]
	return 0
func 获取食材数组():
	# 步骤1：同步存档，保证手工系统数据是最新的
	同步存档()
	# 步骤2：从存档中获取预制食材字典
	var 料理 = 手工系统["预制食材"]
	# 步骤3：初始化空数组，用于存放最终结果
	var 食材数组 = []
	# 步骤4：第一层遍历：遍历所有物品类型（字典的键）
	for 物品类型 in 料理:
		# 获取当前物品对应的所有处理格式与数量的子字典
		var 处理格式子字典 = 料理[物品类型]
		# 步骤5：第二层遍历：遍历该物品的所有处理格式（标签）
		for 标签 in 处理格式子字典:
			# 获取当前处理格式对应的食材数量
			var 食材数量 = 处理格式子字典[标签]
			# 过滤掉数量≤0的无效数据（避免冗余空数据）
			if 食材数量 <= 0:
				continue
			# 步骤6：创建符合要求格式的食材项字典
			var 食材项 = {
				"数量": 食材数量,
				"物品类型": 物品类型,
				"标签": 标签}
			# 步骤7：将食材项添加到结果数组中
			食材数组.append(食材项)
	# 步骤8：返回最终的食材数组
	return 食材数组
