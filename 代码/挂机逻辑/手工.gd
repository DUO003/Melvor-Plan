func 检查并更新炼金队列():
	var 炼金队列 = 队列炼金()
	if 炼金队列.size() == 0:
		return  # 队列为空，无需处理
	var 当前时间 = int(Time.get_unix_time_from_system())
	for i in range(炼金队列.size()):# 用索引遍历（避免遍历中修改队列导致的异常）
		var 队列项 = 炼金队列[i]
		if not 队列项.has_all(["时间戳", "用时", "剩余", "完成"]):# 容错：检查队列项是否包含必要字段
			print("错误：炼金队列项缺少字段，索引：", i)
			continue
		var 时间戳 = 队列项["时间戳"]# 提取队列项数据
		var 单次用时 = 队列项["用时"]
		var 剩余次数 = 队列项["剩余"]
		var 完成次数 = 队列项["完成"]
		var 时间差 = 当前时间 - 时间戳# 计算当前时间与周期起点的差值（秒）
		if 时间差 < 0:# 未到周期时间/时间回拨，跳过
			炼金队列[i]["时间戳"] = 当前时间
			continue
		var 可完成次数 = min(int(时间差*1.0 / 单次用时), 剩余次数)# 计算可完成的次数
		if 可完成次数 <= 0:
			continue
		炼金队列[i]["剩余"] = 剩余次数-可完成次数
		炼金队列[i]["完成"] = 完成次数+可完成次数
		炼金队列[i]["时间戳"] = 时间戳+可完成次数 * 单次用时
## 增加或减少手工系统的资源数量
func 获得资源(名称, 数量=0.0, 检查上限=true, 信号=true):
	同步存档()
	if 数量==0.0:
		return
	数量 = float(数量)  # 强制转换为浮点
	var 基础资源: Dictionary = 手工系统["基础资源"]
	var 当前数量 = 基础资源.get(名称,0)
	var 新数量 = 当前数量 + 数量
	var 溢出处理 = false  # 标记是否需要处理溢出
	var 溢出量 = 0.0  # 改为浮点数存储
	if 检查上限 and 名称 != "精华":# 检查上限逻辑，且资源不是精华时才执行
		# 建立资源名称与上限变量的映射关系
		var 上限变量名 = 名称 + "上限"
		# 检查当前资源是否有对应的上限设置
		var 上限值 = get(上限变量名)
		# 情况1：当前数量已超过上限，处理本次新增的全部数量作为溢出
		if 当前数量 > 上限值:
			溢出量 = 数量  # 本次新增的数量全部算作溢出
			溢出处理 = true
			新数量 = 当前数量  # 保持当前数量不变（已超上限）
		# 情况2：当前数量未超上限，但新增后超过上限
		elif 新数量 > 上限值:
			溢出量 = 新数量 - 上限值  # 计算超出上限的部分
			新数量 = 上限值  # 限制在最大值
			溢出处理 = true
	# 处理溢出资源转换为高级资源的逻辑，根据溢出字典配置
	if 溢出处理 and 溢出字典.has(名称):
		for 目标资源 in 溢出字典[名称]:
			var 转换比例 = 溢出字典[名称][目标资源]
			var 转换数量 = 溢出量 * 转换比例  # 根据转换比例计算转换数量
			if 转换数量 > 0:
				获得资源(目标资源, 转换数量, 检查上限, false)  # 递归调用自身，转换为高级资源
	if 新数量 <= 0:
		print("背包资源扣除",名称,新数量)
		计划.语法糖消耗物品(名称,abs(新数量))#如果背包内有也可以扣
		基础资源[名称] = 0
	else:
		基础资源[名称] = 新数量  # 更新物品数量
	if 信号:
		计划.emit_signal("更新_UI")#调用UI更新信号
func 查看资源(名称 = "木材"):
