## 增加或减少手工系统的资源数量
func 获得资源(名称, 数量=0.0, 检查上限=true, 信号=true):
	同步存档()
	if 数量==0.0:return
	数量 = float(数量)  # 强制转换为浮点
	var 基础资源: Dictionary = 手工系统["基础资源"]
	var 当前数量 = 查看资源(名称)
	var 新数量 = 当前数量 + 数量
	var 溢出处理 = false  # 标记是否需要处理溢出
	var 溢出量 = 0.0  # 改为浮点数存储
	if 检查上限 and not 检查资源类(名称)=="特殊":# 检查上限逻辑，且资源不是特殊
		var 上限值 = 资源上限字典.get(名称,0)# 检查当前资源是否有对应的上限设置
		if 当前数量 > 上限值:# 情况1：当前数量已超过上限，处理本次新增的全部数量作为溢出
			溢出量 = 数量  # 本次新增的数量全部算作溢出
			溢出处理 = true
			新数量 = 当前数量  # 保持当前数量不变（已超上限）
		elif 新数量 > 上限值:# 情况2：当前数量未超上限，但新增后超过上限
			溢出量 = 新数量 - 上限值  # 计算超出上限的部分
			新数量 = 上限值  # 限制在最大值
			溢出处理 = true
	if 溢出处理 and 溢出字典.has(名称):# 处理溢出资源转换为高级资源的逻辑，根据溢出字典配置
		for 目标资源 in 溢出字典[名称]:
			var 转换比例 = 溢出字典[名称][目标资源]
			var 转换数量 = 溢出量 * 转换比例  # 根据转换比例计算转换数量
			if 转换数量 > 0:获得资源(目标资源, 转换数量, 检查上限, false)  # 递归调用自身，转换为高级资源
	elif 溢出处理 and 检查资源类(名称)=="高级":计划.数据原罪("原罪值","手工",溢出量*0.2)
	if 新数量 < 0:
		计划.语法糖消耗物品(名称,abs(新数量))#如果背包内有也可以扣
		基础资源[名称] = 0
	else:基础资源[名称] = 新数量  # 更新物品数量
	if 信号:计划.更新_UI.emit()#调用UI更新信号
func 查看资源(名称 = "木材"):
