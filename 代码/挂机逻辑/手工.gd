func _资源上限(初始, 增量, 膨胀, 等级=0):
	return floor((初始 + 等级 * 增量) * (1 + 膨胀 * (等级)))
##资源上限刷新逻辑（适配业务调用）
func 资源刷新():
	同步存档() # 保证取最新存档数据
	var 等级 = 手工系统.get("等级", 0) # 获取当前等级
	var 额外资源上限:Dictionary=计划.BUFF.BUFF统计("资源上限")
	for 资源 in 资源字典:
		资源上限字典[资源] = 资源字典[资源]["上限"].call(等级)
		if 额外资源上限.has(资源):资源上限字典[资源] +=额外资源上限[资源]
## 生成溢出转换规则字典，仅在初始化时调用一次[br]
## 逻辑：遍历所有资源，筛选出类型为"基础"的资源，检查其溢出配置中的目标资源是否为"高级"类型，符合条件则加入溢出字典
func 生成溢出字典():
	溢出字典.clear() # 清空原有数据
	for 资源名称 in 资源字典:
		var 资源属性 = 资源字典[资源名称]
		if 资源属性["类型"] == "基础": # 仅处理基础资源
			var 有效溢出规则 = {}
			for 目标资源 in 资源属性["溢出"]:
				if 资源字典.has(目标资源) and 资源字典[目标资源]["类型"] == "高级": # 检查目标资源是否为高级类型
					有效溢出规则[目标资源] = 资源属性["溢出"][目标资源]
			if not 有效溢出规则 == {}:
				溢出字典[资源名称] = 有效溢出规则
