## 将整数转换为罗马数字（用于装备等级显示）
# 参数: 整数 - 待转换的整数（建议范围1-3999）
# 返回: 对应的罗马数字字符串，若输入无效则返回空字符串
func 罗马数字(整数: int) -> String:
	# 检查输入有效性（装备等级通常为正整数）
	if 整数 <= 0 or 整数 > 3999:
		return ""
	# 罗马数字数值与符号映射表（从大到小排列）
	var 罗马数组 = [
		[1000, "M"],  # 千位
		[900, "CM"],
		[500, "D"],
		[400, "CD"],
		[100, "C"],   # 百位
		[90, "XC"],
		[50, "L"],
		[40, "XL"],
		[10, "X"],    # 十位
		[9, "IX"],
		[5, "V"],
		[4, "IV"],
		[1, "I"]      # 个位
	]
	var 文本 = ""
	for 罗马符号 in 罗马数组:# 从最大数值开始匹配，逐步减少剩余值并拼接符号
		var 值 = 罗马符号[0]
		var 符号 = 罗马符号[1]
		while 整数 >= 值:# 当剩余值大于等于当前数值时，拼接符号并减少剩余值
			文本 += 符号
			整数 -= 值
		if 整数 == 0:# 剩余值为0时提前退出循环
			break
	return 文本
