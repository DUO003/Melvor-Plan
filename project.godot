; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="梅计划"
config/name_localized={
"zh": "梅计划"
}
config/description="游戏手工版本开发中
总进度(1/7)
[手工:95%]
[挂机:10%]"
config/version="0.1.7"
config/tags=PackedStringArray("梅计划")
run/main_scene="uid://kifxwq2enhmp"
config/features=PackedStringArray("4.5", "Mobile")
run/max_fps=60
boot_splash/bg_color=Color(0.39, 0.3289, 0.20669998, 1)
boot_splash/image="uid://b6jdxhylrmsvu"
config/icon="uid://b1hn1lg5d5q5l"

[autoload]

"计划"="*res://代码/梅计划.gd"
GBIS="*res://addons/grid_base_inventory_system/core/grid_base_inventory_system.gd"
Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"

[debug]

settings/max_fps=60

[dialogic]

directories/dch_directory={
"多003": "res://对话/多003.dch",
"玩家": "res://对话/玩家.dch"
}
directories/dtl_directory={
"加工纤维": "res://对话/加工纤维.dtl",
"加工鞣革": "res://对话/加工鞣革.dtl",
"原罪解锁": "res://对话/原罪解锁.dtl",
"小游戏": "res://对话/小游戏.dtl",
"手动合成": "res://对话/手动合成.dtl",
"新手任务": "res://对话/新手任务.dtl",
"研究炼金": "res://对话/研究炼金.dtl",
"研究烹饪": "res://对话/研究烹饪.dtl",
"研究长剑": "res://对话/研究长剑.dtl",
"背包解锁": "res://对话/背包解锁.dtl",
"食材研究方向": "res://对话/食材研究方向.dtl"
}
layout/style_directory={
"": "res://对话/对话样式.tres",
"对话样式": "res://对话/对话样式.tres"
}
layout/style_list=["res://对话/对话样式.tres"]
layout/default_style="res://对话/对话样式.tres"
glossary/default_case_sensitive=true
extensions_folder="res://对话/扩展"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0.5
choices/reveal_by_input=true
save/autosave_delay=60.0
save/encryption_on_exports_only=true
translation/enabled=true
translation/original_locale="zh_CN"
translation/file_mode=1
translation/translation_folder=""
translation/save_mode=0
translation/add_separator=false
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}
variables={
"SCJQ": false
}
glossary/glossary_files=["res://对话/术语.tres"]

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/fastnode/plugin.cfg", "res://addons/script-ide/plugin.cfg", "res://addons/tab_saver/plugin.cfg")

