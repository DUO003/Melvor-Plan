@export var 创建数据:bool=false
@export var 宝石词条:Dictionary = {}
@export var 数值:float=0.0
@export var 种子:int
@export var 系统:String
func 更新属性(设定种子:int=randi()):
	if 创建数据:
		super.更新属性()
	else :
		super.更新属性()
		var 随机=RandomNumberGenerator.new()
		随机.seed = 设定种子
		种子=随机.randi()
		var 随机词条数量:int=0
		var 权重=随机.randf()
		if 权重>0.95:
			随机词条数量=2
			数值=0.6
		else :
			if 权重>0.60:随机词条数量=1
			权重=随机.randf()
			数值=max(0.6,1.1*权重)
		随机词条数量=0
		系统="手工"
		随机抽取宝石词条(随机词条数量,"手工",随机)
		创建数据=true
	type = "宝石"
	return true
func 拷贝方法():#所有继承方法如果希望被正确拷贝都需要重写
	return 物品宝石.new(1,item_name)
func 随机抽取宝石词条(抽取数量:int, 词条方向:String,随机:RandomNumberGenerator) -> void:
	if 抽取数量 <= 0:return
	var 候选词条列表:Array = []
	var 词条元素:Array=[]
	var 宝石元素=计划.表格.获取属性(item_name,"元素","无")
	for 词条名称 in 随机词条:
		var 词条配置 = 随机词条[词条名称]
		# 检查词条配置是否包含"词条方向"键，避免报错
		if not 词条配置.has("词条方向"):
			continue
		# 筛选逻辑：目标方向匹配 或 词条为通用
		if 词条配置["词条方向"] == 词条方向 or 词条配置["词条方向"] == "通用":
			候选词条列表.append(词条名称)
			if 词条配置.has("词条元素") and 词条配置.词条元素==宝石元素:
				词条元素.append(词条名称)
	# 3. 检查候选词条数量是否足够
	if 候选词条列表.size() == 0:
		print("错误：无符合【%s】方向的候选词条" % 词条方向)
		return
	if 抽取数量 > 候选词条列表.size():
		抽取数量 = 候选词条列表.size()
	# 4. 随机抽取指定数量的词条（去重）
	var 抽中词条列表:Array = []
	while 抽中词条列表.size() < 抽取数量:
		var 随机索引
		var 随机词条名称
		if 抽中词条列表.size()==0 and 词条元素.size()>=1:
			随机索引 = 随机.randi() % 词条元素.size()
			随机词条名称 = 词条元素[随机索引]
		else :
			随机索引 = 随机.randi() % 候选词条列表.size()
			随机词条名称 = 候选词条列表[随机索引]
		if not 抽中词条列表.has(随机词条名称):
			抽中词条列表.append(随机词条名称)
	宝石词条.clear()  # 清空原有数据
	for 词条名称 in 抽中词条列表:
		var 词条配置 = 随机词条[词条名称]
		var 随机属性:Dictionary=随机词条[词条名称]["随机属性"]
		var 随机属性名:Array=随机属性.keys()
		if 随机属性名.size()>=1:
			var 最小强度 = 词条配置["词条范围"].x
			var 最大强度 = 词条配置["词条范围"].y
			# 处理范围值异常（如x>y）
			if 最小强度 > 最大强度:
				var 临时值 = 最小强度
				最小强度 = 最大强度
				最大强度 = 临时值
			var 随机强度:int = 随机.randi() % (最大强度 - 最小强度 + 1) + 最小强度
			var 基础值:float=随机词条[词条名称]["需求比值"]
			var 词条属性:String=随机属性名[随机.randi()%随机属性名.size()]
			宝石词条[词条名称] = {
				"强度": 随机强度,
				"属性": 词条属性,
				"激活":int(随机属性[词条属性]*基础值)}
func 倍率()->float:
	var 宝石阶级:int=计划.表格.蓝图数据(item_name,"阶级")
	return (宝石阶级*数值)
##返回宝石简介
func 返回简介(_背包名:String,参数:Dictionary={})->String:
	var 词条:Array=[]
	var 宝石阶级=计划.表格.蓝图数据(item_name,"阶级")
	var 阶级=计划.罗马数字(宝石阶级)
	var 简介:String=""
	if 参数.has("简化"):
		简介="%s%s+(%.1f%%)"%[item_name,阶级,倍率()]
	else :
		简介="%s%s\n增强装备栏:%.1f%%"%[item_name,阶级,倍率()]
	for 词条名 in 宝石词条:
		if 随机词条.has(词条名):
			var 属性:String=宝石词条[词条名]["属性"]
			var 激活值:int=宝石词条[词条名]["激活"]
			var 强度:int=宝石词条[词条名]["强度"]
			var 词条模板:String=随机词条[词条名]["词条名"]+计划.罗马数字(强度)
			var 需求属性:Array=随机词条[词条名]["需求属性"]
			var 需求属性文本:String="+".join(需求属性)
			var 后缀:String=""
			if 参数.has("富文本"):
				if 参数.has("简化"):
					后缀=" %s>=%d"%[需求属性文本,激活值]
				else :
					后缀="(激活需%s:%d)"%[需求属性文本,激活值]
				后缀="[font_size=%d]%s[/font_size]"%[int(0.75*参数["富文本"]),后缀]
			else :
				后缀="(激活需%s:%d)"%[需求属性文本,激活值]
			if 参数.has("富文本"):
				var 拼接词条:String=词条模板%("[color=%s]%s[/color]"%["#222222",属性])
				词条.append(拼接词条+后缀)
			else :
				词条.append(词条模板%属性+后缀)
	if 词条.size()>=1:
		简介+="\n"+"\n".join(词条)
	return 简介
