extends 基类梅窗口
var 系统节点:={}
var 原罪=["傲慢","暴食","贪婪","懒惰","暴怒","色欲","嫉妒"]
func _ready() -> void:
	系统节点={
		"挂机":%"0_挂机",
		"木料":%"1_木料",
		"矿城":%"2_矿城",
		"手工":%"3_手工",
		"游历":%"4_游历",
		"职业":%"5_职业",
		"召唤":%"6_召唤",}
	var 系统管理选项卡:TabContainer=%"系统管理"
	# 遍历字典（按插入顺序），为每个选项卡重命名
	for 索引 in 系统节点:
		# 获取当前选项卡对应的子节点（通过字典值）
		var 子节点: Node = 系统节点[索引]
		# 获取子节点原始名称（如 "0_挂机"），替换下划线为小数点
		var 新标题: String = 子节点.name.replace("_", ".")
		# 添加锁定表情后缀
		if 计划.数据系统(索引)==-1:
			新标题 += "🔒︎"
		# 获取当前条目在字典中的索引位置（关键：匹配选项卡索引）
		var 选项卡索引: int = 系统节点.keys().find(索引)
		# 设置选项卡标题
		系统管理选项卡.set_tab_title(选项卡索引, 新标题)
	var 原罪值="原罪值"
	for 原罪名 in 原罪:
		原罪值+=原罪名+":%d/%d"%[计划.数据原罪("原罪值",原罪名),计划.数据原罪("原罪上限",原罪名)]
	%"原罪值".text=原罪值
