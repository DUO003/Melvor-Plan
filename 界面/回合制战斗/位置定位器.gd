extends Marker2D
class_name 梅定位_回合制

# 可配置：单排整体纵向范围 上下合计总像素,实体应该尽可能居中
@export var 单排排布总高度:float = 360.0
# 可配置：定位点朝反方向的容纳空间,实体应该尽可能居中
@export var 阵容总长度:float = 500.0
# 正反偏移方向,可能的取值有-1或1
@export_range(-1, 1, 1) var 阵容朝向:int=1

# 缓存阵容 key=排号 value=实体数组
var 阵容信息:Dictionary[int,Array]={}
# 插入实体并自动重排当前排位置
func 插入实体(实体:梅回合制实体,排号:int):
	实体.排号 = 排号
	
	# 排不存在则初始化空数组
	if not 阵容信息.has(排号):
		阵容信息[排号] = []
	阵容信息[排号].append(实体)
	刷新实时排号坐标()
	# 插入完成后刷新本排所有实体Y位置
	刷新当前排坐标(排号)
# 1. 计算所有排的实时连续序号 + 统一分配X轴位置
func 刷新实时排号坐标() -> void:
	# 步骤1：提取并升序所有存在的原始排号
	var 原始排号列表:Array[int] = 阵容信息.keys()
	原始排号列表.sort()
	var 总排组数:int = 原始排号列表.size()
	if 总排组数 == 0:
		return
	# 步骤2：给每一组原始排号绑定实时序号（0,1,2...）并赋值给组内所有实体
	for 实时序号 in range(总排组数):
		var 原排号:int = 原始排号列表[实时序号]
		var 本组实体:Array = 阵容信息[原排号]
		for 实体 in 本组实体:
			if 实体 is 梅回合制实体:
				if 实体:实体.实时排号 = 实时序号

	# 步骤3：横向居中均分留白计算（和Y轴算法统一）
	var 单段留白宽度:float = 阵容总长度 / (总排组数 + 1)
	var 基准X:float = global_position.x

	# 遍历每一排，分配X偏移，Y保持原有同排纵向位置不变
	for 实时序号 in range(总排组数):
		var 原排号:int = 原始排号列表[实时序号]
		var 本组实体:Array = 阵容信息[原排号]
		# 基础横向偏移（居中留白算法）
		var 基础偏移X:float = -阵容总长度 / 2.0 + 单段留白宽度 * (实时序号 + 1)
		# 朝向翻转
		基础偏移X *= 阵容朝向

		# 更新同排所有实体X坐标，Y不动
		for 实体 in 本组实体:
			if 实体 is 梅回合制实体:
				if 实体:实体.站位.x=基准X + 基础偏移X
# 核心：留白均分排布，实体不靠上下边界，整体居中
func 刷新当前排坐标(目标排号:int) -> void:
	if not 阵容信息.has(目标排号):
		return
	var 当前排实体列表:Array = 阵容信息[目标排号]
	var 有效实体列表:Array[梅回合制实体] = []
	# 过滤：只保留存活、有效实体
	for 实体 in 当前排实体列表:
		if 实体 and 实体 is 梅回合制实体:
			有效实体列表.append(实体)
	var 数量:int = 有效实体列表.size()
	if 数量 == 0:
		return
	
	var 中心Y:float = global_position.y
	var 总跨度:float = 单排排布总高度 # 固定360
	# N个实体分割出 N+1 个均等空白区间
	var 单段留白高度:float = 总跨度 / (数量 + 1)

	for i in range(数量):
		# 第一个实体距离顶部留白一段，之后依次叠加一段高度
		var 相对偏移Y:float = -总跨度/2 + 单段留白高度 * (i + 1)
		有效实体列表[i].站位.y=中心Y + 相对偏移Y
