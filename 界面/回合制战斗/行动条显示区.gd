extends Control
class_name 梅行动条
@onready var 行动条: Panel = %行动条
var 行动数组:Array[梅回合制目标]
var 最大速度值:float = 1.0
var 回合长度:float = 1.0
var 回合已暂停: bool = false
@export var 日志:bool=false
@export var 行动条头像: PackedScene = preload("res://界面/回合制战斗/头像.tscn")
@onready var 头像: 梅回合制目标 = %头像

@export var 回合管理器:梅回合管理器
# 外部传入本场战斗种子，决定所有随机速度倍率
@export var 战斗随机种子:int = 0
# 本场独立随机生成器，隔离全局随机，保证战斗结果固定
var 战斗随机器:RandomNumberGenerator = RandomNumberGenerator.new()

# 记录每个实体上一次行动的系统时间戳
var 实体上次行动时间: Dictionary = {}
var 当前行动数组:Array[梅回合制目标] = []

func _ready() -> void:
	头像.position = 行动条.position + Vector2(-60, -80)
	# 初始化随机器种子
	战斗随机器.randomize() # 先清状态，再设置固定种子
	战斗随机器.seed = 战斗随机种子
	if 日志:
		print("=== 行动条初始化完成，当前回合长度：", 回合长度, " 本场随机种子：",战斗随机种子," ===")

# 外部接口：动态修改本场战斗种子，重置随机序列
func 设置战斗随机种子(新种子:int) -> void:
	战斗随机种子 = 新种子
	战斗随机器.seed = 新种子
	if 日志:
		print("已更新战斗随机种子为：",新种子)

func _process(间隔: float) -> void:
	# 如果回合正在执行（例如正在播放动画或等待玩家输入），则冻结全场进度
	if 回合已暂停:
		return
	# 如果当前行动数组里有待处理的单位（上一帧收集的结果）
	if not 当前行动数组.is_empty():
		处理行动队列()
		return # 处理完直接返回，不再推进进度条
	# 如果当前没有待处理的单位，正常推进进度条
	for 目标 in 行动数组:
		# 安全检查：如果目标在上一回合中途死亡并被移出数组，跳过
		if not is_instance_valid(目标):
			continue
		# 叠加随机速度倍率计算进度
		var 原始进度倍率: float = 目标.基础速度 / (回合长度 * 最大速度值)
		var 进度倍率: float = 原始进度倍率 * 目标.随机速度倍率
		# 累加进度
		目标.当前进度 += 间隔 * 进度倍率
		# 如果进度满了，加入“当前行动数组”等待执行
		if 目标.当前进度 >= 1.0:
			# 限制最大值，防止浮点误差导致无限大
			目标.当前进度 = 1.0
			# 防止重复加入（虽然逻辑上不会，但加个保险）
			if not 当前行动数组.has(目标):
				当前行动数组.append(目标)
		# UI更新（保持你原来的逻辑）
		目标.position = 行动条.position + Vector2(-60, -80) + Vector2(行动条.size.x, 0) * (1 - 目标.当前进度)

# 处理行动队列
func 处理行动队列() -> void:
	#移除无效元素
	var 待移除元素:Array[梅回合制目标] = []
	for 目标 in 当前行动数组:
		if not is_instance_valid(目标) or not 行动数组.has(目标):
			待移除元素.append(目标)
	for 无效目标 in 待移除元素:
		当前行动数组.erase(无效目标)
	#排序
	# 按照进度值降序排列，如果进度相同，按照优先级排列（数值越小越优先）
	当前行动数组.sort_custom(func(a: 梅回合制目标, b: 梅回合制目标):
		if a.当前进度 == b.当前进度:
			return a.出手优先级 < b.出手优先级
		return a.当前进度 > b.当前进度)
	#取出并执行行动单位
	var 当前行动单位: 梅回合制目标 = 当前行动数组.pop_front()
	回合已暂停 = true#锁定进度条,回合结束后由对象释放
	当前行动单位.当前进度 = 0.0
	触发回合(当前行动单位)#触发回合

# 新建实体时初始化随机倍率（使用本场独立随机器）
func 创建目标(实体引用:梅回合制实体):
	var 目标:梅回合制目标 = 行动条头像.instantiate()
	目标.实体引用 = 实体引用
	目标.基础速度 = 实体引用.速度
	# 使用内部随机器生成 1.0 ~ 1.1 倍率
	目标.随机速度倍率 = 战斗随机器.randf_range(1.0, 1.1)
	目标.贴图=实体引用.贴图
	if 最大速度值 < 实体引用.速度:
		最大速度值 = 目标.基础速度
		print("更新全局最大速度值：", 最大速度值)
	add_child(目标)
	行动数组.append(目标)
	# 初始化实体行动时间戳
	实体上次行动时间[目标] = Time.get_unix_time_from_system()
	print("新增实体：", 实体引用, " 基础速度：", 实体引用.速度, " 初始随机倍率：", 目标.随机速度倍率)

##移除目标
func 移除目标(实体引用:梅回合制实体):
	# 校验入参实体为空，直接报错退出
	if not 实体引用:
		print("[错误] 移除目标失败：传入实体引用为空，终止后续操作")
		return
	# 先匹配出对应目标节点
	var 待移除节点:梅回合制目标 = null
	for 节点 in 行动数组:
		if 节点 and 节点.实体引用 == 实体引用:
			待移除节点 = 节点
			break
	# 无匹配节点，报错退出
	if not 待移除节点:
		print("[错误] 移除目标失败：行动数组内不存在该实体 ", 实体引用, "，终止操作")
		return
	# 1. 销毁场景节点
	if 待移除节点.is_inside_tree():
		待移除节点.queue_free()
	# 2. 清理时间戳字典
	if 实体上次行动时间.has(待移除节点):
		实体上次行动时间.erase(待移除节点)
	# 3. 删除数组第一个匹配元素
	行动数组.erase(待移除节点)
	# 4. 刷新全局最大速度
	更新全局最大速度()
	print("成功移除实体：", 实体引用)

# 统一更新全局最大速度专用方法
func 更新全局最大速度():
	var 新最大值: float = 0.0
	for 目标节点 in 行动数组:
		if 目标节点 and 目标节点.实体引用:
			if 目标节点.基础速度 > 新最大值:
				新最大值 = 目标节点.基础速度
	最大速度值 = 新最大值
	print("重新计算全局最大速度，当前值：", 最大速度值)

func 触发回合(目标:梅回合制目标):
	var 当前真实时间:float = Time.get_unix_time_from_system()
	var 上一次时间:float = 实体上次行动时间[目标]
	var 真实行动间隔:float = 当前真实时间 - 上一次时间
	# 更新本次行动时间戳
	实体上次行动时间[目标] = 当前真实时间
	if 日志:
		# 打印间隔日志
		print("\n===== 实体触发行动 =====")
		print("实体标识：", 目标.实体引用)
		print("实体基础速度：", 目标.基础速度, "｜全局最大速度：", 最大速度值)
		print("当前随机速度倍率：", 目标.随机速度倍率)
		print("当前回合长度变量：", 回合长度)
		print("两次行动真实时间间隔：", 真实行动间隔, "秒")
		print("========================\n")
	# 原有战斗逻辑
	var 敌人=目标.实体引用.获取敌对目标()
	if 敌人 and 敌人 is 梅回合制实体:
		#发出回合信号
		回合管理器.回合开始.emit(目标.实体引用)
		await 目标.实体引用.回合行动()
		if 目标 and 目标.实体引用:
			回合管理器.回合结束.emit(目标.实体引用)
	
	# 行动结束，使用本场随机器重新生成固定序列倍率
	目标.随机速度倍率 = 战斗随机器.randf_range(1.0, 1.1)
	回合已暂停 = false

# 核心工具方法：传入目标，估算距离下次行动还需要多少真实秒
func 获取距下次行动剩余秒数(目标:梅回合制目标) -> float:
	# 每秒能增长多少进度（叠加随机倍率）
	var 每秒进度增量: float = (目标.基础速度 / (回合长度 * 最大速度值)) * 目标.随机速度倍率
	# 距离满行动条还差多少进度
	var 剩余所需进度: float = max(1.0 - 目标.当前进度, 0.0)
	# 剩余进度 ÷ 每秒增量 = 剩余秒数
	if 每秒进度增量 <= 0:
		return INF  # 速度为0永远无法行动
	return 剩余所需进度 / 每秒进度增量
