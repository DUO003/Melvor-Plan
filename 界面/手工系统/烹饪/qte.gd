extends Panel

# 指针节点（挂载时需确保场景中有名为"指针"的Panel节点）
@onready var 指针: Panel = $指针
# 当前得分（0-1）
var 得分: float = 0.0
# 中心区域占比（0-1，比如0.1代表中心10%的区域）
var 中心占比: float = 0.1
# 面板的中心点归一化位置（0.5即水平中点）
var 中心点: float = 0.5
# 指针移动的速度（像素/秒），结合每秒循环次数计算
var 每秒循环次数: float = 2.0
# 指针当前移动方向（1=向右，-1=向左）
var 移动方向: int = 1
# 指针可移动的最大范围（右边界）
var 指针最大位置: float = 0.0

# 初始化：计算指针移动的边界
func _ready() -> void:
	# 指针的右边界 = 面板宽度 - 指针自身宽度（避免指针超出面板）
	指针最大位置 = self.size.x - 指针.size.x
	# 初始化指针位置到中心点
	指针.position.x = 中心点 * self.size.x - 指针.size.x / 2

# 每一帧更新指针位置和得分
func _process(delta: float) -> void:
	# 1. 计算指针移动速度（像素/帧）
	var 移动速度: float = 指针最大位置 * 每秒循环次数 * delta
	
	# 2. 更新指针位置
	指针.position.x += 移动方向 * 移动速度
	
	# 3. 边界检测：碰到左右边界则反向
	if 指针.position.x <= 0:
		指针.position.x = 0
		移动方向 = 1
	elif 指针.position.x >= 指针最大位置:
		指针.position.x = 指针最大位置
		移动方向 = -1
	
	# 4. 计算当前得分
	计算得分()

# 核心逻辑：根据指针位置计算0-1的得分
func 计算得分() -> void:
	# 第一步：将指针中心位置转换为归一化值（0-1）
	# 指针中心的绝对位置 = 指针左边界 + 指针宽度/2
	var 指针中心绝对位置: float = 指针.position.x + 指针.size.x / 2
	# 指针中心的归一化位置（相对于面板宽度，0=最左，1=最右）
	var 指针中心归一化: float = 指针中心绝对位置 / self.size.x
	
	# 第二步：计算中心区域的范围
	# 中心区域左边界 = 中心点 - 中心占比/2
	var 中心区域左边界: float = 中心点 - 中心占比 / 2
	# 中心区域右边界 = 中心点 + 中心占比/2
	var 中心区域右边界: float = 中心点 + 中心占比 / 2
	
	# 第三步：判断指针是否在中心区域内
	if 指针中心归一化 >= 中心区域左边界 and 指针中心归一化 <= 中心区域右边界:
		# 中心区域内，得分=1
		得分 = 1.0
	else:
		# 中心区域外，得分随距离衰减（越远得分越低）
		# 计算指针中心到中心点的绝对距离（归一化）
		var 到中心的距离: float = abs(指针中心归一化 - 中心点)
		# 衰减系数：距离超过中心区域后，线性衰减到0
		var 衰减系数: float = 1.0 - (到中心的距离 - 中心占比/2) / (0.5 - 中心占比/2)
		# 确保得分在0-1之间（避免负数）
		得分 = max(0.0, 衰减系数)
