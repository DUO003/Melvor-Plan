func _ready():
	super._ready()#注册
	研究按钮=%"研究"
	研究配方贴图=%"研究配方贴图"
	研究配方名=%"研究配方名"
	蓝色图纸=%"蓝色图纸"
	蓝图图片=%"蓝图图片"
	抽取记录=%"抽取记录"
	滑块=%"滑块"
	var 最小值:float=1.0
	滑块.min_value=最小值
	滑块.max_value=计划.技能树.数据技能树("研究改良")
	滑块.value=计划.窗口状态_限制(基类窗口名称,"研究数量",1,滑块.max_value,滑块.min_value)
	滑块.更新刻度()
	滑块.drag_ended.connect(func(修改:bool=true):
		if 修改:计划.窗口状态管理(基类窗口名称,"研究数量",null,int(滑块.value)))
	抽奖机逻辑分支()
	关闭蓝图展示.pressed.connect(_关闭蓝图展示)
	蓝图下一页.pressed.connect(_蓝图下一页)
	蓝图上一页.pressed.connect(_蓝图上一页)
func 抽奖机逻辑分支():
	蓝色图纸.visible=false
	%主菜单.pressed.connect(func(): 计划.切换场景("合成界面"))
	%"标签页".current_tab=计划.窗口状态_限制(基类窗口名称,"标签页",0)
	研究历史=计划.窗口状态管理(基类窗口名称,"研究历史",[])
	if not 检查抽取说明数组(研究历史):研究历史=[]
	增加记录()
	灵感等级=计划.手工.数据灵感("等级")
	研究节点 = %"研究方向"
	研究节点.allow_reselect = true  # 显式设置，确保生效
	研究节点.item_selected.connect(func(_序号):更新富文本())
	加载研究方向()
	%研究.pressed.connect(研究)
	%研究进度条.更新进度(-1)
	更新富文本()
	计划.更新_UI.connect(更新富文本)
## 检查数组是否全部为文本（字符串）类型
func 检查抽取说明数组(待检查数组: Array) -> bool:
	for 数组元素 in 待检查数组:
		if typeof(数组元素) != TYPE_STRING:
			return false
	return true
func 加载研究方向():
	研究方向=计划.手工.数据灵感("研究方向","符文")
	研究序号=计划.手工.数据灵感("研究序号")
	研究节点.selected=研究序号
	研究节点.clear()
	for 研究选项 in 研究方向:
		if not 研究选项=="基础素材" and not 研究选项=="所有类型":
			研究节点.add_item(研究选项)
func 加载信息():
	灵感等级=计划.手工.数据灵感("等级")
	灵感等级精通=计划.手工.数据灵感("精通")
	灵感需求=计划.结算升级("手工",计划.玩法枚举.灵感,"灵感",true)
	定向选项=研究节点.text
	研究费用=计划.手工.数据灵感("研究费用")
	研究次数=int(%"滑块".value)
	if 研究次数<=1:
		研究次数=1
		研究按钮.text="研究"
	else :
		研究按钮.text="研究*%d"%研究次数
@onready var 抽取说明: RichTextLabel = %抽取说明
@onready var 当前状态: RichTextLabel = %当前状态
func 更新富文本():
	加载信息()
	var 最低费用=0
	var 最高费用=0
	var 阶级:int=计划.手工.数据灵感("阶级")
	for i in range(研究次数):
		最低费用+=min(160,研究费用+i)
		最高费用+=min(160,研究费用+i*阶级+1)
	var 抽取说明数组:Array=[
		tr("<蓝图抽取说明标题>"),
		tr("<抽取说明_残缺>")%[74,计划.表格.翻译名称("蓝图纸")],
		tr("<抽取说明_蓝图>")%[20],
		tr("<抽取说明_特殊>")%[5,计划.表格.翻译名称("黄图纸")],
		tr("<抽取说明_图纸包>")%[1],
		tr("<抽取说明_研究费用>")]
	抽取说明.text="\n".join(抽取说明数组)
	var 当前状态数组:Array=[]
	var 蓝图池=蓝图池获取()
	if 蓝图池.size()<=0:
		var 物品类型池:Array=计划.获取配方(研究节点.text)
		var 最低等阶:int=20
		if 物品类型池.size()>=1:
			for 物品名 in 物品类型池:
				var 物品等阶=计划.表格.蓝图数据(物品名,"阶级")
				if 物品等阶<最低等阶:最低等阶=物品等阶
		当前状态数组.append(tr("<解锁提示>")%[最低等阶])
		研究配方贴图.texture=null
	else :
		var 多次研究文本:String=tr("<当前研究费用>")%[研究费用]
		if 研究次数>1:
			if 最低费用==最高费用:多次研究文本="%d"%最低费用
			else :多次研究文本+="(%d/%d)"%[最低费用,最高费用]
		当前状态数组.append(多次研究文本)
		研究配方贴图.texture=计划.表格.道具贴图(蓝图池[randi()%蓝图池.size()])
	if 研究次数>1:
		当前状态数组.append(tr("<当前预备费用>")%[最高费用])
	当前状态数组.append(tr("<当前蓝图阶级>")%[阶级])
	当前状态数组.append(tr("<当前灵感等级>")%[灵感等级,灵感等级精通,灵感需求])
	当前状态数组.append(tr("<当前定向选项>")%[定向选项])
	当前状态.text="\n".join(当前状态数组)
	#%"抽取说明".text="[b]蓝图抽取说明[/b]
#74%%获得残缺蓝图,每次制作消耗一张残缺图纸
#20%%获得UP类型的装备蓝图 重复给予大量灵感等级精通
#5%%获得[b]未拥有[/b]的特殊蓝图 全收集补偿黄图纸*10
#特等奖 初始1%%获得图纸包
