extends 基类梅窗口
var 灵感等级=1
var 灵感等级精通=0
var 灵感需求=-1
var 定向选项="长剑"
var 研究费用=0
var 研究次数
var 研究方向: Array
var 研究序号:int

var 本地记录:Array
var 研究历史:Array
var 研究动画播放中:bool=false
