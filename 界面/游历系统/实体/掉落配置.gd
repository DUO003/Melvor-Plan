extends Resource
class_name 梅掉落配置

# 配置项
@export var 随机物品池: Array[梅掉落项] = []
@export var 最大掉落数: int = -1  # 【仅生效阶段】原始掉落抽取：最多抽中X种奖励
@export var 启用打乱: bool = false
@export var 最大实体数量: int = 1 # 【视觉控制】单种物品最多拆分成多少个掉落实体
@export var 掉落表: Array[String] = []
var 掉落表枚举:Dictionary[String,梅掉落配置]={
	"新手村小怪":load("res://界面/游历系统/掉落物/新手村小怪.tres")}

# 计算最终掉落（严格区分：抽取阶段→合并拆分阶段）
func 计算掉落结果() -> Array:
	var 最终结果 = []
	# ==================================================================

	var 原始掉落列表: Array[Dictionary] = 获取原始掉落(self)
	# 2. 遍历启用的子掉落表，合并对应配置的物品池
	for 表名:String in 掉落表:
		# 检查枚举映射中是否存在该名称
		if 掉落表枚举.has(表名):
			# 仅合并【随机物品池】，子配置的其他属性完全不使用
			var 子配置 = 掉落表枚举[表名] as 梅掉落配置
			原始掉落列表.append_array(获取原始掉落(子配置))
		else:
			# 无效名称：控制台报错 + 忽略
			push_error("梅掉落配置：未找到子掉落表枚举 -> " + 表名 + "，已自动忽略")
	# 3. 【合并阶段】仅合并：标准物品 + 无自定义参数
	var 合并物品字典: Dictionary = {} # 标准物品合并：名称→总数量
	var 特殊物品列表: Array[Dictionary] = [] # 非标准/有参数：直接保留

	for 物品 in 原始掉落列表:
		if 物品["类型"] == "标准物品" && 物品["参数"].is_empty():
			# 同名合并数量
			var 名称 = 物品["名称"]
			合并物品字典[名称] = 合并物品字典.get(名称, 0) + 物品["数量"]
		else:
			# 特殊物品直接保留，不做任何修改
			特殊物品列表.append(物品)

	# 4. 【拆分阶段】红包算法拆分 → 生成视觉实体（完全不受最大掉落数限制）
	# 先添加特殊物品
	最终结果.append_array(特殊物品列表)
	
	# 再添加拆分后的标准物品
	for 物品名称 in 合并物品字典:
		var 总数量 = 合并物品字典[物品名称]
		# 边界条件：不拆分的情况
		if 总数量 <= 1 or 最大实体数量 <= 1:
			最终结果.append({
				"名称": 物品名称,
				"数量": 总数量,
				"类型": "标准物品",
				"参数": {}
			})
			continue
		
		# 计算拆分份数（不超过最大实体数量）
		var 拆分份数 = min(最大实体数量, 总数量)
		# 红包算法拆分数量
		var 数量列表 = _红包拆分算法(总数量, 拆分份数)
		# 生成实体（纯视觉，无数量限制）
		for 数量 in 数量列表:
			最终结果.append({
				"名称": 物品名称,
				"数量": 数量,
				"类型": "标准物品",
				"参数": {}
			})

	return 最终结果

# 修复1：添加返回类型标注 + 独立使用传入配置的所有属性
func 获取原始掉落(配置:梅掉落配置) -> Array[Dictionary]:
	# 1. 初始化：先加载自身配置的物品池
	var 待处理列表: Array[梅掉落项] = 配置.随机物品池.duplicate()
	# 打乱列表（使用子配置自身的打乱属性）
	if 配置.启用打乱:
		待处理列表.shuffle()
		
	var 已存在词条: Array[String] = []
	var 原始掉落计数: int = 0  # 记录已抽中的原始掉落项数量
	var 原始掉落列表: Array[Dictionary] = []
	
	# 核心：原始掉落抽取阶段
	for 项:梅掉落项 in 待处理列表:
		if not 项.检查配置是否合法():
			continue
		
		# 修复2：使用【传入配置自身】的最大掉落数，而非主配置
		if 配置.最大掉落数 > 0 and 原始掉落计数 >= 配置.最大掉落数:
			break
		
		# 冲突词条检查
		if 项.冲突词条 != "" && 已存在词条.has(项.冲突词条):
			continue
		
		# 概率掉落判断
		if randf() > 项.掉落概率:
			continue
		
		# 添加冲突词条
		for 词条 in 项.添加冲突词条:
			if not 已存在词条.has(词条):
				已存在词条.append(词条)
		原始掉落计数 += 1
		
		# 生成物品数据
		var 物品数据: = {
			"名称": 项.物品名称,
			"数量": randi_range(项.最小数量, 项.最大数量),
			"类型": 项.物品类型,
			"参数": 项.自定义参数}
		原始掉落列表.append(物品数据)
	
	# 修复3：添加返回值！！！
	return 原始掉落列表

# 微信红包拆分算法（无修改）
func _红包拆分算法(奖池: int, 拆分次数: int) -> Array[int]:
	var 剩余金额 = 奖池
	var 剩余次数 = 拆分次数
	var 结果: Array[int] = []
	
	for i in range(拆分次数):
		if 剩余次数 == 1:
			结果.append(剩余金额)
			break
		var 平均金额 = float(剩余金额) / 剩余次数
		var 最大金额 = int(平均金额 * 2)
		var 抽取金额 = randi_range(1, min(最大金额, 剩余金额 - 剩余次数 + 1))
		结果.append(抽取金额)
		剩余金额 -= 抽取金额
		剩余次数 -= 1
	return 结果
