@tool
extends Control
@export var 进度条上限: float = 100.0:#必须为正数,但不限制大小
	set(值):
		进度条上限 = 值
		queue_redraw()
@export var 刻度高度: float = 20.0:# 刻度矩形的高度（垂直方向）
	set(值):
		刻度高度 = 值
		queue_redraw()
@export var 大刻度颜色: Color = Color(0, 0, 0):
	set(值):
		大刻度颜色 = 值
		queue_redraw()
@export var 小刻度颜色: Color = Color(0, 0, 0):
	set(值):
		小刻度颜色 = 值
		queue_redraw()
@export var 进制数: int = 10:# 每个量级下进制数量（如1000量级→5进制，每大格200,小格40）,但切换显示并没有很好的兼容
	set(值):
		进制数= 值
		if Engine.is_editor_hint():
			queue_redraw()
			更新文本()
var 小刻度淡出阈值倍率: float = 0.4   # 小刻度淡出阈值 = 当前量级 * 此倍率（如1000量级→500淡出）
var 小刻度隐藏阈值倍率: float = 0.9   # 小刻度隐藏阈值 = 当前量级 * 此倍率（如1000量级→600隐藏）
@export var 强制量级: float = -1:
	set(值):
		强制量级 = 值
		queue_redraw()   # 强制进度条上限计算量级至少为这么多,小于0不生效,可能会导致无法绘制进度条刻度
@export var 启用刻度:bool=false:#执行更新进度条时是否会顺便更新作为Label子节点的"刻度单位"文本,注意关闭后不会更新,会隐藏节点.兼容了节点不存在的情况
	set(值):
		启用刻度 = 值
		更新文本()
@export var 刻度偏移:Vector2=Vector2(0,0)
#@export_range(1, 1.7976931348623157e308) var 测试上限=进度条上限:#用于测试时预览查看
@export_range(100, 10000) var 测试上限=进度条上限:#用于测试时预览查看
	set(值):
		if Engine.is_editor_hint():
			测试上限= 值
			if not 值:#防止清空测试时传入空值
				进度条上限 = 100
			else :
				进度条上限 = 值
			更新文本()
@export var 重新绘制:bool=false:#更改时手动刷新测试用
	set(值):
		重新绘制 = 值
		更新文本()
		queue_redraw()
func _ready():#编辑器预览效果
	if Engine.is_editor_hint():
		queue_redraw()
		return
	更新文本()
##禁止外部修改必须使用方法传入
func 更新进度条参数(新上限: float=进度条上限, 新长度: float=size.x, 新刻度高度: float=刻度高度) -> void:
	var 大小=size
	大小.x=新长度
	set_size(大小)
	刻度高度 = 新刻度高度
	if 新上限==进度条上限:#如果上限没变但其他值变化需要手动刷新
		queue_redraw()
	进度条上限 = 新上限# 自动触发_draw()重新绘制
	更新文本()#同时更新文本
func 更新文本():
	if not has_node("刻度单位"):
		return
	var 刻度=$"刻度单位"
	if not 刻度:
		return
	if not 启用刻度:
		刻度.hide()
		return
	var 单位文本 = _转换量级到单位文本()
	if 单位文本 == "":
		刻度.hide()  # 量级=1时隐藏文本
	else:
		刻度.show()
		刻度.text = 单位文本
		刻度.set_size(刻度.get_combined_minimum_size())
		刻度.position=Vector2(size.x-刻度.size.x+刻度偏移.x,刻度偏移.y)

## 支持：1→隐藏，10→10，100→百，1000→千，1万→万...1亿→亿，亿以上→E+幂次
## 1. 单位基准值 = 当前量级 / (进制数 * 进制数)
## 2. 仅大刻度每量级格数=10时用中文单位，否则<1亿返回数值字符串，≥1亿用科学计数
func _转换量级到单位文本() -> String:
	var 当前量级: float=_获取当前数量级(进度条上限)
	if 当前量级==-1:#溢出不处理
		return ""
	# 第一步：计算单位基准值 = 当前量级 / (大刻度每量级格数²)
	var 单位基准值: float = 当前量级 / (进制数 * 进制数)
	# 规则1：基准值<10 → 隐藏（返回空）
	if 单位基准值 < 10:
		return ""
	if 进制数 == 10:
		# 格数=10 → 原有中文单位逻辑
		# 规则2：基准值≥1亿 → 统一用科学计数法（无论格数）
		var 阈值: float = pow(10.0, 9)
		if 单位基准值 > 阈值:
			var 对数结果: float = log(单位基准值) / log(10.0)
			var 幂次: int = floor(对数结果)
			return "E" + str(幂次)
		else :
			var 幂次: int = floor(log(单位基准值) / log(10.0))  # 10→1, 100→2...1万→4
			var 单位列表: Array = ["10", "百", "千", "万", "十万", "百万", "千万", "亿"]
			return "刻度"+(单位列表[幂次-1] if 幂次 >= 1 and 幂次 <= 单位列表.size() else str(单位基准值))
	else:# 格数≠10 → 直接返回数值字符串
		var 阈值: float = pow(10.0, 5)
		if 单位基准值 > 阈值:
			var 对数结果: float = log(单位基准值) / log(10.0)
			var 幂次: int = floor(对数结果)
			return "E" + str(幂次)
		return "刻度%.1f"%单位基准值
## 核心工具函数：根据传入的上限值自动判定所属数量级（修复log10报错 + 精准匹配量级规则）
## 规则：10→100量级、99→100量级、100→1000量级、999→1000量级、1000→10000量级...
func _获取当前数量级(输入上限: float) -> float:
	if 输入上限 <= 0:
		return 1.0  # 兜底默认量级（避免log(0)返回-inf）
	if 输入上限<强制量级:
		输入上限=强制量级
	const DBL_MAX: float = 1.7976931348623157e308
	if 输入上限 >= DBL_MAX or is_inf(输入上限 * 10):
		#print("浮点溢出：输入值超过双精度最大值")
		return -1.0
	var 对数结果: float = log(输入上限) / log(10.0)
	var 整数幂次: int = floor(对数结果)
	var 当前量级: float = pow(10.0, 整数幂次 + 1)
	return max(当前量级, 1.0)# 兜底最小量级为1（避免输入量级过小）

func _draw() -> void:
	if 进度条上限 <= 0 or size.x <= 0:#第零步 安全校验：避免除数为0
		return
	var 当前量级: float = _获取当前数量级(进度条上限)#第一步,计算参数
	if 当前量级==-1:#溢出
		return
	var 大刻度步长: float = 当前量级 / 进制数# 大刻度步长 = 当前量级 / 进制数
	var 小刻度步长: float = 大刻度步长 / 进制数# 小刻度步长 = 大刻度步长 / 进制数
	var 单位数值像素间距: float = size.x / 进度条上限# 单个数值对应的像素间距（进度条长度 / 实际上限）
	var 刻度间距: float = 单位数值像素间距 * 小刻度步长
	var 小刻度淡出阈值: float = 当前量级 * 小刻度淡出阈值倍率
	var 小刻度隐藏阈值: float = 当前量级 * 小刻度隐藏阈值倍率
	var 淡出到隐藏= clamp((进度条上限 - 小刻度淡出阈值) / (小刻度隐藏阈值 - 小刻度淡出阈值), 0.0, 1.0)# 计算小刻度淡出/隐藏阈值#省代码
	if 进度条上限 <= 小刻度隐藏阈值:#第三步：绘制小刻度,小刻度先画可以被盖住
		var 小刻度总数: int = int((进度条上限-小刻度步长*0.1) / 小刻度步长)# 小刻度总数 = 实际上限 / 小刻度步长（取整）.减少0.1范围防止多画一个
		var 小刻度宽度: float = 刻度间距 / 5.0# 小刻度宽度 = 小刻度像素间距的1/5
		var 当前小刻度颜色: Color=小刻度颜色
		if 进度条上限 > 小刻度淡出阈值:
			var 透明度: float = clamp(1.1 - 淡出到隐藏, 0.1, 1.0)#隐藏前至少10%
			当前小刻度颜色.a = clamp(当前小刻度颜色.a*透明度, 0.0, 1.0)  # 限制透明度0-1
		for 刻度索引 in range(小刻度总数):
			var 刻度x: float = (刻度索引+1) * 刻度间距
			draw_rect(Rect2(刻度x, size.y - 刻度高度, 小刻度宽度, 刻度高度),当前小刻度颜色,true)# 绘制小刻度矩形
	if 进度条上限 > 当前量级*0.1:#第二步：绘制大刻度,例如1000量级,至少有101
		var 大刻度总数: int = int((进度条上限-小刻度步长*0.1) / 大刻度步长)# 大刻度总数 = 实际上限 / 大刻度步长（取整）.减少0.1范围防止多画一个
		var 大刻度宽度: float =  刻度间距 / (-1.5*淡出到隐藏+2.0)
		var 当前大刻度颜色: Color=大刻度颜色
		if 进度条上限 > 小刻度淡出阈值:##混合颜色,暂时不知道如何简化
			当前大刻度颜色.r = 大刻度颜色.r + (小刻度颜色.r - 大刻度颜色.r) * 淡出到隐藏
			当前大刻度颜色.g = 大刻度颜色.g + (小刻度颜色.g - 大刻度颜色.g) * 淡出到隐藏
			当前大刻度颜色.b = 大刻度颜色.b + (小刻度颜色.b - 大刻度颜色.b) * 淡出到隐藏
		for 刻度索引 in range(大刻度总数):# 刻度水平位置（原点向右偏移）
			var 刻度x: float = (刻度索引+1) * 刻度间距*进制数
			draw_rect(Rect2(刻度x, size.y - 刻度高度, 大刻度宽度, 刻度高度),当前大刻度颜色,true)# 绘制填充矩形
